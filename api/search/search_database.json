er(kind=ip), private, dimension(:), allocatable :: p integer(kind=ip), private, dimension(:), allocatable :: q integer(kind=ip), private, dimension(:), allocatable :: lenc integer(kind=ip), private, dimension(:), allocatable :: lenr integer(kind=ip), private, dimension(:), allocatable :: locc integer(kind=ip), private, dimension(:), allocatable :: locr real(kind=rp), private, dimension(:), allocatable :: v work vectors of the solves and the column\nreplacements dimension(n) (kept here so that a\nsolve allocates nothing) real(kind=rp), private, dimension(:), allocatable :: w work vectors of the solves and the column\nreplacements dimension(n) (kept here so that a\nsolve allocates nothing) Type-Bound Procedures procedure, public :: factorize => lu_factorize procedure, public :: solve => lu_solve procedure, public :: replace_column => lu_replace_column Subroutines public  subroutine sparse_matvec (a, x, y) compute the sparse matrix-vector product , operating\ndirectly on the COO triplets (never forms a dense matrix). Arguments Type Intent Optional Attributes Name type( sqpopt_sparse_matrix ), intent(in) :: a sparse matrix, dimension(nrows,ncols) real(kind=wp), intent(in), dimension(:) :: x vector to multiply dimension(ncols) real(kind=wp), intent(out), dimension(:) :: y result vector dimension(nrows) public  subroutine sparse_matvec_transpose (a, y, x) compute the sparse transposed matrix-vector product ,\noperating directly on the COO triplets (never forms a dense matrix). Arguments Type Intent Optional Attributes Name type( sqpopt_sparse_matrix ), intent(in) :: a sparse matrix, dimension(nrows,ncols) real(kind=wp), intent(in), dimension(:) :: y vector to multiply dimension(nrows) real(kind=wp), intent(out), dimension(:) :: x result vector dimension(ncols) public  subroutine independent_columns (nrows, ncols, irow, icol, val, rel_tol, abs_tol, independent, istat) find a maximal linearly independent subset of the columns of the sparse\nmatrix A ( nrows x ncols , COO triplets), with one rank-revealing\nsparse LU factorization ( LUSOL 's lu1fac with threshold complete\npivoting). Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: nrows number of rows of A integer, intent(in) :: ncols number of columns of A integer, intent(in), dimension(:) :: irow row indices of the nonzeros of A integer, intent(in), dimension(:) :: icol column indices of the nonzeros of A real(kind=wp), intent(in), dimension(:) :: val the nonzeros of A (no duplicate (irow,icol) pairs) real(kind=wp), intent(in) :: rel_tol relative singularity tolerance (e.g. 1e-8 ) real(kind=wp), intent(in) :: abs_tol absolute singularity tolerance logical, intent(out), dimension(:) :: independent dimension(ncols) : whether each column is in the subset integer, intent(out) :: istat status (0 = success) private  subroutine lu_factorize (me, n, irow, icol, val, rel_tol, istat) factorize the square n x n sparse matrix A (COO triplets, no\nduplicate (irow,icol) pairs) with LUSOL 's lu1fac (threshold rook\npivoting, for stability). istat is 0 on success, 1 if A appears\nto be singular (see independent_columns for the test), or else lu1fac 's inform code; the factors can only be used if it is 0 . Arguments Type Intent Optional Attributes Name class( sqpopt_lu_type ), intent(inout) :: me integer, intent(in) :: n order of A integer, intent(in), dimension(:) :: irow row indices of the nonzeros of A integer, intent(in), dimension(:) :: icol column indices of the nonzeros of A real(kind=wp), intent(in), dimension(:) :: val the nonzeros of A real(kind=wp), intent(in) :: rel_tol relative singularity tolerance (e.g. 1e-10 ) integer, intent(out) :: istat status (0 = success) private  subroutine lu_solve (me, b, x, transpose) solve (or if transpose ) with the factors\nfrom factorize . Arguments Type Intent Optional Attributes Name class( sqpopt_lu_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: b right-hand side dimension(n) real(kind=wp), intent(out), dimension(:) :: x solution dimension(n) logical, intent(in) :: transpose solve with instead of private  subroutine lu_replace_column (me, jrep, irow, val, istat) update the factors when column jrep of the matrix is replaced by the\nsparse column ( irow , val ), with LUSOL 's lu8rpc (a Bartels-Golub\nupdate). istat is 0 on success; otherwise (the new matrix appears to\nbe singular, the update seemed unstable, or the factors ran out of\nstorage) the factors can no longer be used, and the matrix should be\nfactorized again. Arguments Type Intent Optional Attributes Name class( sqpopt_lu_type ), intent(inout) :: me integer, intent(in) :: jrep the column to replace integer, intent(in), dimension(:) :: irow row indices of the nonzeros of the new column real(kind=wp), intent(in), dimension(:) :: val the nonzeros of the new column integer, intent(out) :: istat status (0 = success)","tags":"","url":"module/sqpopt_linalg_module.html"},{"title":"sqpopt_least_squares_module – sqpopt","text":"Direct minimum-norm solves with rows of the constraint Jacobian\n( options%direct_least_squares ), by a sparse factorization (see sqpopt_kkt_module ; MUMPS or QDLDL, see options%linear_solver ). The Gauss-Newton restoration step ( restoration_step ) and the\nsecond-order correction ( soc_step ) both need the minimum-norm\nsolution d of for a set S of the Jacobian's rows (in the least-squares sense, if the\nrows are dependent or the system is inconsistent). Without this module\nthey use the iterative solver LSQR , and take no step if it stops at its\niteration limit. Here the solution comes from one factorization and one\nsolve of whose solution is . The\nsmall regularization (relative to the square of the\nlargest element of ) keeps the matrix nonsingular when the rows\nare dependent; as , d tends to the minimum-norm\nleast-squares solution. The same matrix, with another right-hand side, gives the least-squares multiplier estimate of multiplier_estimate , which sqpopt_iterate uses\nwhen the QP's multipliers can't be trusted. That routine works in every\nbuild: it uses LSQR unless this module's direct solver is enabled. Uses sqpopt_types_module lsqr_module sqpopt_kinds sqpopt_kkt_module module~~sqpopt_least_squares_module~~UsesGraph module~sqpopt_least_squares_module sqpopt_least_squares_module lsqr_module lsqr_module module~sqpopt_least_squares_module->lsqr_module module~sqpopt_kinds sqpopt_kinds module~sqpopt_least_squares_module->module~sqpopt_kinds module~sqpopt_kkt_module sqpopt_kkt_module module~sqpopt_least_squares_module->module~sqpopt_kkt_module module~sqpopt_types_module sqpopt_types_module module~sqpopt_least_squares_module->module~sqpopt_types_module iso_fortran_env iso_fortran_env module~sqpopt_kinds->iso_fortran_env module~sqpopt_kkt_module->module~sqpopt_kinds module~sqpopt_kkt_module->module~sqpopt_types_module module~sqpopt_dense_linalg_module sqpopt_dense_linalg_module module~sqpopt_kkt_module->module~sqpopt_dense_linalg_module module~sqpopt_hessian_module sqpopt_hessian_module module~sqpopt_kkt_module->module~sqpopt_hessian_module module~sqpopt_symmetric_solver_module sqpopt_symmetric_solver_module module~sqpopt_kkt_module->module~sqpopt_symmetric_solver_module module~sqpopt_types_module->module~sqpopt_kinds ieee_arithmetic ieee_arithmetic module~sqpopt_types_module->ieee_arithmetic module~sqpopt_dense_linalg_module->module~sqpopt_kinds module~sqpopt_hessian_module->module~sqpopt_kinds module~sqpopt_hessian_module->module~sqpopt_dense_linalg_module module~sqpopt_symmetric_solver_module->module~sqpopt_kinds module~sqpopt_symmetric_solver_module->module~sqpopt_types_module module~sqpopt_symmetric_solver_module->iso_fortran_env module~sqpopt_dense_ldl_module sqpopt_dense_ldl_module module~sqpopt_symmetric_solver_module->module~sqpopt_dense_ldl_module module~sqpopt_mumps_ldl_module sqpopt_mumps_ldl_module module~sqpopt_symmetric_solver_module->module~sqpopt_mumps_ldl_module module~sqpopt_qdldl_ldl_module sqpopt_qdldl_ldl_module m