t the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial integer, private, parameter :: cache_size = 4 number of recent evaluations of fc kept integer, public, parameter :: sqpopt_derivatives_fast = 1 cheaper, less accurate derivatives are fine (e.g.\nforward differences): the solver is far from a solution integer, public, parameter :: sqpopt_derivatives_accurate = 2 the most accurate derivatives available are wanted\n(e.g. analytic, or central differences) Abstract Interfaces abstract interface public  subroutine sqpopt_fc_func(x, f, c, status, data) evaluates the objective function and the nonlinear\nconstraint vector Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x optimization variable vector dimension(n) real(kind=wp), intent(out) :: f value of the objective function real(kind=wp), intent(out), dimension(:) :: c constraint vector dimension(m) ( m may be 0) integer, intent(inout) :: status 0 on entry; >0 : can't evaluate here, <0 : stop class(*), intent(inout), optional :: data user data (see set_functions ) abstract interface public  subroutine sqpopt_gjac_func(x, g, jac_val, accuracy, status, data) evaluates the gradient of the objective function and the nonzero values of the Jacobian of the constraint vector, , ordered to match the\nsparsity pattern set by set_jacobian_sparsity . accuracy says\nhow accurate they need to be: functions with a cheaper, less\naccurate way of computing them (e.g. forward instead of central\ndifferences) may use it while accuracy=sqpopt_derivatives_fast ;\nothers can ignore it. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x optimization variable vector dimension(n) real(kind=wp), intent(out), dimension(:) :: g gradient vector dimension(n) real(kind=wp), intent(out), dimension(:) :: jac_val nonzero Jacobian values dimension(jac_nnz) (may be 0) integer, intent(in) :: accuracy sqpopt_derivatives_fast or sqpopt_derivatives_accurate integer, intent(inout) :: status 0 on entry; >0 : can't evaluate here, <0 : stop class(*), intent(inout), optional :: data user data (see set_functions ) abstract interface public  subroutine sqpopt_hessian_func(x, lambda, hess_val, status, data) evaluates the nonzero values of the Hessian of the Lagrangian: ,\nordered to match the sparsity pattern set by set_hessian_sparsity . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x optimization variable vector dimension(n) real(kind=wp), intent(in), dimension(:) :: lambda Lagrange multipliers dimension(m) real(kind=wp), intent(out), dimension(:) :: hess_val nonzero Hessian values dimension(hess_nnz) integer, intent(inout) :: status 0 on entry; >0 : can't evaluate here, <0 : stop class(*), intent(inout), optional :: data user data (see set_functions ) Derived Types type, public :: sqpopt_problem_type defines the problem to be solved: the problem size, the\nvariable and constraint bounds, the sparsity patterns of the\nconstraint Jacobian and Lagrangian Hessian, and the\nuser-supplied procedures used to evaluate the objective\nfunction, constraints, and their derivatives. Components Type Visibility Attributes Name Initial integer, public :: n = 0 number of optimization variables ( ) integer, public :: m = 0 number of constraints ( ): equalities (where ) and inequalities, in any order real(kind=wp), public, dimension(:), allocatable :: x_lb lower bounds on the optimization variables dimension(n) real(kind=wp), public, dimension(:), allocatable :: x_ub upper bounds on the optimization variables dimension(n) real(kind=wp), public, dimension(:), allocatable :: x_max_step the largest change of each variable in one major\niteration dimension(n) (unallocated: no limits; see set_max_step ) real(kind=wp), public, dimension(:), allocatable :: c_lb lower bounds on the constraints dimension(m) real(kind=wp), public, dimension(:), allocatable :: c_ub upper bounds on the constraints dimension(m) integer, public :: jac_nnz = 0 number of nonzero elements in the constraint Jacobian integer, public, dimension(:), allocatable :: jac_irow Jacobian sparsity pattern: row indices dimension(jac_nnz) integer, public, dimension(:), allocatable :: jac_icol Jacobian sparsity pattern: column indices dimension(jac_nnz) integer, public :: hess_nnz = 0 number of nonzero elements in the (symmetric) Hessian of the Lagrangian integer, public, dimension(:), allocatable :: hess_irow Hessian sparsity pattern: row indices dimension(hess_nnz) integer, public, dimension(:), allocatable :: hess_icol Hessian sparsity pattern: column indices dimension(hess_nnz) procedure( sqpopt_fc_func ), public, pointer, nopass :: eval_fc => null() evaluates and procedure( sqpopt_gjac_func ), public, pointer, nopass :: eval_gjac => null() evaluates and the\nnonzero values of the Jacobian of procedure( sqpopt_hessian_func ), public, pointer, nopass :: eval_hess => null() evaluates the nonzero values of the\nHessian of the Lagrangian (only used\nwhen an exact Hessian is requested) class(*), public, pointer :: user_data => null() user data passed to every user function (see set_functions ) logical, public :: stop_requested = .false. set when a user function returns status < 0 integer, public :: n_eval_fc = 0 number of calls of the user's fc integer, public :: n_eval_gjac = 0 number of calls of the user's gjac integer, public :: n_eval_hess = 0 number of calls of the user's hess real(kind=wp), public :: time_user = 0.0_wp wall-clock time spent in the user's functions (seconds) real(kind=wp), public :: f_scale = 1.0_wp objective scale factor real(kind=wp), public, dimension(:), allocatable :: c_scale constraint scale factors dimension(m) integer, public :: cache_n = 0 entries used, and the slot for the next one, in the fc cache integer, public :: cache_next = 1 entries used, and the slot for the next one, in the fc cache real(kind=wp), public, dimension(:,:), allocatable :: cache_x points at which fc was evaluated dimension(n,cache_size) real(kind=wp), public, dimension(:), allocatable :: cache_f (unscaled) f at those points dimension(cache_size) real(kind=wp), public, dimension(:,:), allocatable :: cache_c (unscaled) c at those points dimension(m,cache_size) integer, public :: derivative_accuracy = sqpopt_derivatives_accurate the accuracy gjac is asked for (see set_derivative_accuracy ) logical, public :: have_gjac = .false. whether the one-entry gjac cache is filled real(kind=wp), public, dimension(:), allocatable :: cache_xg point at which gjac was evaluated dimension(n) real(kind=wp), public, dimension(:), allocatable :: cache_g (unscaled) g there dimension(n) real(kind=wp), public, dimension(:), allocatable :: cache_jac (unscaled) Jacobian values there dimension(jac_nnz) Type-Bound Procedures procedure, public :: set_problem_size set the problem dimensions and allocate the bound arrays procedure, public :: set_bounds set the variable and constraint bounds procedure, public :: set_max_step set the largest change of each variable in one major iteration procedure, public :: step_bounds the bounds on the variables for a step from a point procedure, public :: set_jacobian_sparsity set the (fixed) sparsity pattern of the constraint Jacobian procedure, public :: set_hessian_sparsity set the (fixed) sparsity pattern of the Lagrangian Hessian procedure, public :: set_functions attach the user-supplied evaluation procedures (and user data) procedure, public :: validate check the problem definition and normalize infinite bounds procedure, public :: f => eval_f_cached evaluate the (scaled) objective procedure, public :: c => eval_c_cached evaluate the (scaled) constraints procedure, public :: g => eval_g_cached evaluate the (scaled) objective gradient procedure, public :: jac => eval_jac_cached evaluate the (scaled) Jacobian values procedure, public :: hess => eval_hess_scaled evaluate the (scaled) Lagrangian Hessian values procedure, public :: reset_evaluations empty the caches, zero the counters, and remove any scaling procedure, public :: set_derivative_accuracy set the accuracy gjac is asked for procedure, public :: compute_scaling set gradient-based objective/constraint scale factors Functions private  function wall_time () result(t) the wall-clock time, in seconds (for the time spent in the user's functions). Arguments None Return Value real(kind=wp) Subroutines private  subroutine set_problem_size (me, n, m) set the problem dimensions and allocate the variable/constraint bound\narrays: n variables and m constraints. Which constraints are\nequalities is given by their bounds ( c_lb(i) == c_ub(i) , see set_bounds ), so equalities and inequalities may come in any order. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(in) :: n number of optimization variables integer, intent(in) :: m number of constraints (equality and inequality) private  subroutine set_bounds (me, x_lb, x_ub, c_lb, c_ub) set the variable bounds and the constraint\nbounds (equality constraints are given by c_lb(i) == c_ub(i) ). set_problem_size must be called first. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x_lb variable lower bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: x_ub variable upper bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) private  subroutine set_max_step (me, max_step) set the largest change of each variable in one major iteration: max_step(j) . The limits are enforced as\nbounds on every step the solver computes (the QP subproblem's, the\nsecond-order correction, and the restoration steps), so a step is the\nbest one within them, not a longer one cut short. A value >= sqpopt_infinity means no limit for that variable. Without this call\n(or after another set_problem_size ) there are no limits. Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: max_step the largest change of each variable dimension(n) (each > 0 ) private pure subroutine step_bounds (me, x, lb, ub) the bounds on the variables for a step from the point x : the\nvariables' bounds, tightened to x - max_step and x + max_step if\nstep limits were set (see set_max_step ). x must be within the\nbounds, so that lb <= x <= ub . Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: x the point the step starts from dimension(n) real(kind=wp), intent(out), dimension(:) :: lb lower bounds for the new point dimension(n) real(kind=wp), intent(out), dimension(:) :: ub upper bounds for the new point dimension(n) private  subroutine validate (me, istat, msg) check that the problem is completely and consistently defined, and\nnormalize the bounds: any bound with magnitude >= sqpopt_infinity is\nclamped to +/-sqpopt_infinity , so that e.g. -huge(1.0_wp) may be\nused for an absent bound without overflowing expressions like x_ub-x_lb . Returns istat=sqpopt_invalid_input (and a description in msg ) on the first problem found, else sqpopt_success . Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(out) :: istat sqpopt_success or sqpopt_invalid_input character(len=:), intent(out), allocatable :: msg description of the problem found (empty if none) private  subroutine set_jacobian_sparsity (me, nnz, irow, icol) set the (fixed) sparsity pattern of the constraint Jacobian, given as\n1-based COO irow / icol triplets. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(in) :: nnz number of nonzero Jacobian elements integer, intent(in), dimension(:) :: irow row indices dimension(nnz) integer, intent(in), dimension(:) :: icol column indices dimension(nnz) private  subroutine set_hessian_sparsity (me, nnz, irow, icol) set the (fixed) sparsity pattern of the Hessian of the Lagrangian,\ngiven as 1-based COO irow / icol triplets. Since the Hessian is\nsymmetric, each off-diagonal element must be given only once (in\neither triangle; e.g. only the lower triangle): an element (i,j) with i/=j stands for both (i,j) and (j,i) . Repeated entries are summed. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(in) :: nnz number of nonzero Hessian elements integer, intent(in), dimension(:) :: irow row indices dimension(nnz) integer, intent(in), dimension(:) :: icol column indices dimension(nnz) private  subroutine set_functions (me, fc, gjac, hess, data) attach the user-supplied procedures used to evaluate the objective\nfunction and constraints ( fc ), their derivatives ( gjac ), and\noptionally the exact Hessian of the Lagrangian ( hess ), and\n(optionally) a user data object that is passed to each of them (see the\nmodule-level documentation). fc returns and together,\nand gjac returns and the Jacobian values together,\nsince they usually share intermediate results. Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me procedure( sqpopt_fc_func ) :: fc objective function and constraint vector procedure( sqpopt_gjac_func ) :: gjac objective gradient and sparse constraint Jacobian values procedure( sqpopt_hessian_func ), optional :: hess sparse exact Hessian of the Lagrangian values class(*), intent(inout), optional, target :: data user data passed to each function private  subroutine reset_evaluations (me) empty the evaluation caches (sizing them for the current n , m , and\nJacobian pattern), zero the evaluation counters, clear any stop\nrequest, and reset the scale factors to 1. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me private  subroutine compute_scaling (me, x, max_gradient, min_value) gradient-based scaling (as in IPOPT): at the point x , the objective\nis scaled by and each constraint by , so that no scaled gradient is larger than max_gradient (problems whose gradients are all at most max_gradient are not\nscaled). No scale factor is made smaller than min_value (if given), so\nthat a starting point with an extremely large gradient, which says\nlittle about the rest of the problem, doesn't scale a function down to\nnothing. The (finite) constraint bounds are scaled to match. Call reset_evaluations first; the evaluations used here are cached, so\nthey are not repeated by the first major iteration. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point at which to measure the gradients dimension(n) real(kind=wp), intent(in) :: max_gradient real(kind=wp), intent(in), optional :: min_value smallest scale factor (default 0 : no limit) private  subroutine eval_f_cached (me, x, f) the (scaled) objective . The underlying value is reused\nfrom one of the last few evaluations if x is exactly (bitwise) the\nsame point -- the solver evaluates f at each trial point of a line\nsearch and then again at the start of the next major iteration, at the\naccepted point, so this saves one call per major iteration. NaN if the\nuser function failed ( status /= 0 ). Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent(out) :: f scaled objective function value at x private  subroutine eval_c_cached (me, x, c) the (scaled) constraints , with the same caching as eval_f_cached . Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent(out), dimension(:) :: c scaled constraint values at x dimension(m) private  subroutine eval_g_cached (me, x, g) the (scaled) objective gradient , reusing the last\nevaluation if x is the same point. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent(out), dimension(:) :: g scaled gradient at x dimension(n) private  subroutine eval_jac_cached (me, x, jac_val) the (scaled) Jacobian values ,\nreusing the last evaluation if x is the same point. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent(out), dimension(:) :: jac_val scaled Jacobian values dimension(jac_nnz) private  subroutine raw_fc (me, x, f, c) the unscaled objective and (if c is present) constraints, from the\ncache or the user's fc (whose call is counted, and whose status is\nhandled as by check_status ). The user's function writes straight into\nthe next cache entry, so an evaluation needs no work array. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent(out) :: f objective at x (unscaled) real(kind=wp), intent(out), optional, dimension(:) :: c constraints at x (unscaled) dimension(m) private  subroutine raw_gjac (me, x, g, jac_val) the unscaled gradient and/or Jacobian values (whichever of g and jac_val is present), from the one-entry cache or the user's gjac (whose call is counted, and whose status is handled as by check_status ). The user's function writes straight into the cache,\nso an evaluation needs no work array. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent(out), optional, dimension(:) :: g objective gradient at x (unscaled) dimension(n) real(kind=wp), intent(out), optional, dimension(:) :: jac_val nonzero Jacobian values at x (unscaled) dimension(jac_nnz) private  subroutine eval_hess_scaled (me, x, lambda, hess_val) the nonzero values of the Hessian of the (scaled) Lagrangian at x , for\nthe multipliers lambda of the scaled problem: the user's hess is\ncalled with the multipliers of the original problem, , and its values are multiplied by .\nNaN if the user function failed ( status /= 0 ). Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent(in), dimension(:) :: lambda multipliers of the scaled problem dimension(m) real(kind=wp), intent(out), dimension(:) :: hess_val scaled Hessian values dimension(hess_nnz) private  subroutine check_status (me, status, v) handle a user function's returned status : if it is nonzero the\noutputs v are replaced by NaN (so the solver rejects the point, or\nreports sqpopt_function_error if it is the current point), and if it\nis negative a stop is requested (after which no user function is called\nagain: uncached evaluations just return NaN). Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(in) :: status the status the user function returned real(kind=wp), intent(inout), dimension(:) :: v the values it returned (set to NaN if it could not evaluate them) private  subroutine set_derivative_accuracy (me, accuracy) set the accuracy the user's gjac is asked for ( sqpopt_derivatives_fast or sqpopt_derivatives_accurate ). A change empties the gjac cache, so\nthat derivatives at a point already evaluated are evaluated again, at the\nnew accuracy. Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(in) :: accuracy sqpopt_derivatives_fast or sqpopt_derivatives_accurate","tags":"","url":"module/sqpopt_problem_module.html"},{"title":"sqpopt_options_module – sqpopt","text":"User-settable options that control the behavior of the SQP solver. Uses sqpopt_linesearch_module sqpopt_restoration_module sqpopt_problem_module sqpopt_hessian_module sqpopt_qp_solver_module sqpopt_types_module sqpopt_symmetric_solver_module iso_fortran_env sqpopt_kinds module~~sqpopt_options_module~~UsesGraph module~sqpopt_options_module sqpopt_options_module iso_fortran_env iso_fortran_env module~sqpopt_options_module->iso_fortran_env module~sqpopt_hessian_module sqpopt_hessian_module module~sqpopt_options_module->module~sqpopt_hessian_module module~sqpopt_kinds sqpopt_kinds module~sqpopt_options_module->module~sqpopt_kinds module~sqpopt_linesearch_module sqpopt_linesearch_module module~sqpopt_options_module->module~sqpopt_linesearch_module module~sqpopt_problem_module sqpopt_problem_module module~sqpopt_options_module->module~sqpopt_problem_module module~sqpopt_qp_solver_module sqpopt_qp_solver_module module~sqpopt_options_module->module~sqpopt_qp_solver_module module~sqpopt_restoration_module sqpopt_restoration_module module~sqpopt_options_module->module~sqpopt_restoration_module module~sqpopt_symmetric_solver_module sqpopt_symmetric_solver_module module~sqpopt_options_module->module~sqpopt_symmetric_solver_module module~sqpopt_types_module sqpopt_types_module module~sqpopt_options_module->module~sqpopt_types_module module~sqpopt_hessian_module->module~sqpopt_kinds module~sqpopt_dense_linalg_module sqpopt_dense_linalg_module module~sqpopt_hessian_module->module~sqpopt_dense_linalg_module module~sqpopt_kinds->iso_fortran_env module~sqpo