s_module module~sqpopt_restoration_module->module~sqpopt_qp_solver_module module~sqpopt_soc_module->module~sqpopt_least_squares_module Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial logical, public, parameter :: sqpopt_has_mumps = .false. whether the library was built with MUMPS (the HAS_MUMPS preprocessor directive), which sqpopt_linear_solver_mumps requires Derived Types type, public, extends( sqpopt_sparse_ldl_type ) :: sqpopt_mumps_ldl_type the MUMPS backend (see the module documentation). It holds a\npointer, so it must not be copied. Components Type Visibility Attributes Name Initial integer, public :: n_negative = 0 of the last factorization: the number of negative eigenvalues integer, public :: n_null = 0 of the last factorization: the number of zero eigenvalues logical, public :: inertia_known = .true. of the last factorization: whether n_negative and n_null are\nthe matrix's (else they are those of the factors, which are not\nthe matrix's: see the backend's documentation) logical, public :: out_of_memory = .false. whether an allocation of the backend failed (it stays set) logical, private :: analysed = .false. whether the sparsity pattern has been analysed Type-Bound Procedures procedure, public :: start => mumps_start procedure, public :: refactor => mumps_refactor procedure, public :: back_solve => mumps_back_solve procedure, public :: multiply => mumps_multiply procedure, public :: free => mumps_free Subroutines private  subroutine mumps_start (me, n, irow, icol, ok, threads, signs) start MUMPS for the pattern (it is analysed in the first factorization). ok is false if the library was built without MUMPS, or MUMPS couldn't\nbe started. signs is not used (MUMPS pivots). Arguments Type Intent Optional Attributes Name class( sqpopt_mumps_ldl_type ), intent(inout) :: me integer, intent(in) :: n order of the matrix integer, intent(in), dimension(:) :: irow row indices of the entries dimension(nnz) integer, intent(in), dimension(:) :: icol column indices of the entries dimension(nnz) logical, intent(out) :: ok whether the backend is ready integer, intent(in), optional :: threads number of OpenMP threads (default 1 ; 0 : as the OpenMP\nenvironment says) integer, intent(in), optional, dimension(:) :: signs (not used) private  subroutine mumps_refactor (me, val, ok) factor the matrix with the values val . The pattern is analysed in the\nfirst call, with that call's values. If MUMPS runs out of its estimated\nworkspace, the factorization is repeated with twice the allowance, up\nto 20 times (as IPOPT does), and the larger allowance is kept for the\nfollowing factorizations. Arguments Type Intent Optional Attributes Name class( sqpopt_mumps_ldl_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: val values of the entries dimension(nnz) logical, intent(out) :: ok whether the factorization succeeded private  subroutine mumps_back_solve (me, v, ok) one solve with the factors, without refinement. Arguments Type Intent Optional Attributes Name class( sqpopt_mumps_ldl_type ), intent(inout) :: me real(kind=wp), intent(inout), dimension(:) :: v the right-hand side, overwritten by the solution logical, intent(out) :: ok whether it was solved private  subroutine mumps_multiply (me, x, y) the product with the values last factored. Arguments Type Intent Optional Attributes Name class( sqpopt_mumps_ldl_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: x the vector dimension(n) real(kind=wp), intent(out), dimension(:) :: y the product dimension(n) private  subroutine mumps_free (me) free everything (it does nothing if MUMPS was never started). Arguments Type Intent Optional Attributes Name class( sqpopt_mumps_ldl_type ), intent(inout) :: me","tags":"","url":"module/sqpopt_mumps_ldl_module.html"},{"title":"sqpopt_kinds – sqpopt","text":"Uses iso_fortran_env module~~sqpopt_kinds~~UsesGraph module~sqpopt_kinds sqpopt_kinds iso_fortran_env iso_fortran_env module~sqpopt_kinds->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~sqpopt_kinds~~UsedByGraph module~sqpopt_kinds sqpopt_kinds module~sqpopt_convergence_module sqpopt_convergence_module module~sqpopt_convergence_module->module~sqpopt_kinds module~sqpopt_linalg_module sqpopt_linalg_module module~sqpopt_convergence_module->module~sqpopt_linalg_module module~sqpopt_types_module sqpopt_types_module module~sqpopt_convergence_module->module~sqpopt_types_module module~sqpopt_dense_ldl_module sqpopt_dense_ldl_module module~sqpopt_dense_ldl_module->module~sqpopt_kinds module~sqpopt_dense_linalg_module sqpopt_dense_linalg_module module~sqpopt_dense_ldl_module->module~sqpopt_dense_linalg_module module~sqpopt_sparse_ldl_module sqpopt_sparse_ldl_module module~sqpopt_dense_ldl_module->module~sqpopt_sparse_ldl_module module~sqpopt_dense_ldl_module->module~sqpopt_types_module module~sqpopt_dense_linalg_module->module~sqpopt_kinds module~sqpopt_diagnostics_module sqpopt_diagnostics_module module~sqpopt_diagnostics_module->module~sqpopt_kinds module~sqpopt_diagnostics_module->module~sqpopt_linalg_module module~sqpopt_log_module sqpopt_log_module module~sqpopt_diagnostics_module->module~sqpopt_log_module module~sqpopt_options_module sqpopt_options_module module~sqpopt_diagnostics_module->module~sqpopt_options_module module~sqp