qpopt_max_evals_reached = 12 stopped -- maximum number of function evaluations reached integer, public, parameter :: sqpopt_time_limit_reached = 13 stopped -- time limit reached integer, public, parameter :: sqpopt_infeasible = 21 stopped -- problem appears to be infeasible integer, public, parameter :: sqpopt_line_search_failed = 22 stopped -- line search failed to find an acceptable step integer, public, parameter :: sqpopt_qp_solve_failed = 23 stopped -- QP subproblem solver failed integer, public, parameter :: sqpopt_invalid_input = 24 stopped -- the problem definition or options are invalid integer, public, parameter :: sqpopt_function_error = 25 stopped -- the problem functions returned a non-finite value\n(NaN or Inf) at the current point (trial points with\nnon-finite values are rejected instead) integer, public, parameter :: sqpopt_unbounded = 26 stopped -- the objective fell below its lower limit at a\nfeasible point (the problem appears to be unbounded) integer, public, parameter :: sqpopt_out_of_memory = 27 stopped -- an array could not be allocated (the dense\nmatrices of the dense QP solver) real(kind=wp), public, parameter :: sqpopt_infinity = 1.0e20_wp any bound with magnitude >= sqpopt_infinity is treated\nas absent (bounds are clamped to [-sqpopt_infinity,\nsqpopt_infinity] so that e.g. -huge(1.0_wp) is safe to use) Abstract Interfaces abstract interface public  subroutine sqpopt_report_func(iter, x, f, c, lambda, user_stop, data) user-supplied callback invoked once per major SQP iteration\nfor progress monitoring (see sqpopt_type%initialize 's report argument). Set user_stop=.true. to have the\nsolver stop after the current iteration\n( istat=sqpopt_user_requested_stop ). The values are for the\noriginal (unscaled) problem. Arguments Type Intent Optional Attributes Name integer, intent(in) :: iter major iteration number (starts at 1) real(kind=wp), intent(in), dimension(:) :: x current optimization variables dimension(n) real(kind=wp), intent(in) :: f current objective function value real(kind=wp), intent(in), dimension(:) :: c current constraint values dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda current Lagrange multiplier estimate dimension(m) logical, intent(out) :: user_stop set .true. to request the solver stop class(*), intent(inout), optional :: data the user data given to set_functions Derived Types type, public :: sqpopt_sparse_matrix a sparse matrix stored in coordinate (COO) format Components Type Visibility Attributes Name Initial integer, public :: nrows = 0 number of rows integer, public :: ncols = 0 number of columns integer, public :: nnz = 0 number of nonzero elements integer, public, dimension(:), allocatable :: irow row indices dimension(nnz) integer, public, dimension(:), allocatable :: icol column indices dimension(nnz) real(kind=wp), public, dimension(:), allocatable :: val nonzero values dimension(nnz) type, public :: sqpopt_diagnosis_type the diagnostics of a solve (see options%diagnostic_level ): which\nconstraints and variables are responsible for the errors at the\nfinal point, what the active set looks like there, and, from level 2 , what the history of the iterations and the starting point\nsay. Values are for the original (unscaled) problem. Everything\nhere is also in the text of report and problem_report , which\nis what the solver prints. Components Type Visibility Attributes Name Initial integer, public :: level = 0 the diagnostic level these were computed at ( 0 : none, and nothing below is set) integer, public, dimension(:), allocatable :: violated_constraints the constraints with the largest violation of\ntheir bounds, largest first (at most 5) real(kind=wp), public, dimension(:), allocatable :: violations their violations integer, public, dimension(:), allocatable :: stationarity_variables the variables with the largest stationarity\nresidual (the gradient of the Lagrangian,\nprojected onto the bounds), largest first\n(at most 5) real(kind=wp), public,