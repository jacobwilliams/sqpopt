r_type type~sqpopt_kkt_type->type~sqpopt_symmetric_solver_type solver type~sqpopt_sparse_ldl_type sqpopt_sparse_ldl_type type~sqpopt_symmetric_solver_type->type~sqpopt_sparse_ldl_type ldl Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Inherited by type~~sqpopt_kkt_type~~InheritedByGraph type~sqpopt_kkt_type sqpopt_kkt_type type~sqpopt_least_squares_type sqpopt_least_squares_type type~sqpopt_least_squares_type->type~sqpopt_kkt_type kkt Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial logical, public :: enabled = .false. whether it can be used (set by kkt_initialize , and unset if\na factorization fails) integer, public :: n_negative = 0 of the last factorization: the number of directions of negative\ncurvature on the working set's face (the negative eigenvalues of beyond m ) logical, public :: singular = .false. of the last factorization: whether is singular (the\nworking set's rows are dependent, or the face has a direction\nof zero curvature) logical, public :: inertia_known = .true. of the last factorization: whether the sparse solver could\ntell the inertia of (if not, n_negative counts the\ndirections it couldn't tell as negative curvature: see kkt_negatives ) type( sqpopt_symmetric_solver_type ), public :: solver the sparse solver (with its counts and its time) integer, private :: n = 0 number of variables integer, private :: m = 0 number of constraints integer, private, dimension(:), allocatable :: h_irow row indices of the Hessian's pattern integer, private, dimension(:), allocatable :: h_icol column indices of the Hessian's pattern real(kind=wp), private, dimension(:), allocatable :: val the values of : its diagonal, then the Hessian's\nelements, then the Jacobian's logical, private :: current = .false. whether there is one, for the current matrices logical, private, dimension(:), allocatable :: in_set its working set dimension(m+n) real(kind=wp), private :: diag = 0.0_wp what was added to its Hessian's diagonal real(kind=wp), private :: reg = 0.0_wp its regularization integer, private :: rank = 0 the rank r of its quasi-Newton Hessian's low-rank part\n( 0 if it has none) real(kind=wp), private, dimension(:,:), allocatable :: t_lu the LU factors of its matrix dimension(r,r) integer, private, dimension(:), allocatable :: t_piv the row pivots of that factorization dimension(r) Type-Bound Procedures procedure, public :: initialize => kkt_initialize private  subroutine kkt_initialize (me, n, m, jac_irow, jac_icol, ok, hess_irow, hess_icol, threads, solver) set up the KKT matrix of a problem with n variables, m constraints,\nand the Jacobian sparsity pattern jac_irow / jac_icol . The Hessian's\npattern is hess_irow / hess_icol (each off-diagonal element once, as\nfor set_hessian_sparsity ); without it, the Hessian is diagonal. The\npattern of is its whole diagonal, then the Hessian's elements,\nthen the Jacobian's. solver is the sparse solver\n( sqpopt_linear_solver_* , default auto ; with QDLDL, each constraint's\nrow is ordered after its variables, see delay_negative_rows ). ok is\nfalse, and the matrix is left disabled, if that solver isn't available\nin this build or couldn't be started. Arguments Type Intent Optional Attributes Name class( sqpopt_kkt_type ), intent(inout) :: me integer, intent(in) :: n number of variables integer, intent(in) :: m number of constraints integer, intent(in), dimension(:) :: jac_irow row indices of the Jacobian's nonzeros integer, intent(in), dimension(:) :: jac_icol column indices of the Jacobian's nonzeros logical, intent(out) :: ok whether the matrix can now be factored integer, intent(in), optional, dimension(:) :: hess_irow row indices of the Hessian's nonzeros integer, intent(in), optional, dimension(:) :: hess_icol column indices of the Hessian's nonzeros integer, intent(in), optional :: threads number of OpenMP threads of the sparse solver (see symmetric_solver_initialize ) integer, intent(in), optional :: solver the sparse solver ( sqpopt_linear_solver_* ) procedure, public :: new_matrices => kkt_new_matrices private  subroutine kkt_new_matrices (me) note that the Hessian's or the Jacobian's values have changed (a new\nmajor iteration), so the factorization that is kept no longer applies. Arguments Type Intent Optional Attributes Name class( sqpopt_kkt_type ), intent(inout) :: me procedure, public :: factor => kkt_factor private  subroutine kkt_factor (me, hessian, jac, status, ok, reg) factor the KKT matrix of the working set status , with the Hessian hessian (the exact one, with its current values and shift, or a\nquasi-Newton one, with its current pairs: see the module documentation).\nOn success, n_negative and singular describe the working set's face,\nand kkt_solve can be called. If this is the factorization that is\nkept, nothing is computed. The matrix must have been initialized with\nthe Hessian's sparsity pattern in the first case, and without one in the\nsecond. Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_kkt_type ), intent(inout) :: me type( sqpopt_hessian_type ), intent(inout) :: hessian the Hessian (see sqpopt_hessian_module ) type( sqpopt_sparse_matrix ), intent(in) :: jac the constraint Jacobian dimension(m,n) integer, intent(in), dimension(:) :: status the working set: nonzero for each general row, then each\nvariable bound, that is in it dimension(m+n) logical, intent(out) :: ok whether the factorization is available real(kind=wp), intent(in), optional :: reg the regularization (default 0) procedure, public :: factor_identity => kkt_factor_identity private  subroutine kkt_factor_identity (me, scale, jac, status, reg, ok) factor the KKT matrix of the working set status with the Hessian scale and the regularization reg ( ),\nas kkt_factor does for the exact Hessian. The matrix must have been\ninitialized without a Hessian pattern. Arguments Type Intent Optional Attributes Name class( sqpopt_kkt_type ), intent(inout) :: me real(kind=wp), intent(in) :: scale the Hessian is scale times the identity type( sqpopt_sparse_matrix ), intent(in) :: jac the constraint Jacobian dimension(m,n) integer, intent(in), dimension(:) :: status the working set (see kkt_factor ) dimension(m+n) real(kind=wp), intent(in) :: reg the regularization logical, intent(out) :: ok whether the factorization is available procedure, public :: solve => kkt_solve private  subroutine kkt_solve (me, v, ok, hessian) solve with the factorization that is kept: v holds r on entry and the solution on exit. Its first n elements belong to the\nvariables, and the other m to the constraints. Because of the fixed\npattern (see the module documentation), the solution's element is the\nright-hand side's own for a variable at a bound of the working set, and\nminus that for a constraint outside it. Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_kkt_type ), intent(inout) :: me real(kind=wp), intent(inout), dimension(:) :: v the right-hand side, overwritten by the solution dimension(n+m) logical, intent(out) :: ok whether a solution was found type( sqpopt_hessian_type ), intent(in), optional :: hessian the quasi-Newton Hessian that was factored procedure, public :: destroy => kkt_destroy private  subroutine kkt_destroy (me) free the solver and the arrays, and return to the initial (disabled)\nstate. It does nothing if the matrix was never initialized. Arguments Type Intent Optional Attributes Name class( sqpopt_kkt_type ), intent(inout) :: me Source Code type , public :: sqpopt_kkt_type !! the KKT matrix of a working set, and its factorization (see the !! module documentation). It holds the sparse solver, so it must not !! be copied, and [[kkt_destroy]] must be called when the solve ends. private logical , public :: enabled = . false . !! whether it can be used (set by [[kkt_initialize]], and unset if !! a factorization fails) integer , public :: n_negative = 0 !! of the last factorization: the number of directions of negative !! curvature on the working set's face (the negative eigenvalues of !!  K  beyond `m`) logical , public :: singular = . false . !! of the last factorization: whether  K  is singular (the !! working set's rows are dependent, or the face has a direction !! of zero curvature) logical , public :: inertia_known = . true . !! of the last factorization: whether the sparse solver could !! tell the inertia of  K  (if not, `n_negative` counts the !! directions it couldn't tell as negative curvature: see !! [[kkt_negatives]]) type ( sqpopt_symmetric_solver_type ), public :: solver !! the sparse solver (with its counts and its time) integer :: n = 0 !! number of variables integer :: m = 0 !! number of constraints integer , dimension (:), allocatable :: h_irow !! row indices of the Hessian's pattern integer , dimension (:), allocatable :: h_icol !! column indices of the Hessian's pattern real ( wp ), dimension (:), allocatable :: val !! the values of  K : its diagonal, then the Hessian's !! elements, then the Jacobian's ! the factorization that is kept (see the module documentation): logical :: current = . false . !! whether there is one, for the current matrices logical , dimension (:), allocatable :: in_set !! its working set `dimension(m+n)` real ( wp ) :: diag = 0.0_wp !! what was added to its Hessian's diagonal real ( wp ) :: reg = 0.0_wp !! its regularization  \\epsilon  integer :: rank = 0 !! the