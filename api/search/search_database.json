onents Type Visibility Attributes Name Initial type( sqpopt_problem_type ), private :: problem the nonlinear program to be solved (working copy) type( sqpopt_options_type ), private :: options solver options type( sqpopt_hessian_type ), private :: hessian Hessian of the Lagrangian approximation type( sqpopt_qp_solver_type ), private :: qp_solver QP subproblem solver type( sqpopt_linesearch_type ), private :: linesearch merit function / line search type( sqpopt_trust_region_type ), private :: trust_region trust-region globalization (opt-in alternative to linesearch ) type( sqpopt_restoration_type ), private :: restoration feasibility restoration phase state (reset on each solve ) type( sqpopt_problem_type ), private :: problem0 type( sqpopt_linesearch_type ), private :: linesearch0 type( sqpopt_trust_region_type ), private :: trust_region0 type( sqpopt_qp_solver_type ), private :: qp_solver0 real(kind=wp), private, dimension(:), allocatable :: x current/final optimization variables real(kind=wp), private, dimension(:), allocatable :: lambda current/final Lagrange multipliers (of the scaled problem) procedure( sqpopt_report_func ), private, pointer, nopass :: report => null() optional user progress-reporting\ncallback, invoked once per major\niteration (see sqpopt_types_module ) type( sqpopt_results_type ), private :: results the outcome of the last solve Type-Bound Procedures procedure, public :: initialize => sqpopt_initialize procedure, public :: solve => sqpopt_solve procedure, public :: get_solution => sqpopt_get_solution procedure, public :: get_results => sqpopt_get_results procedure, public :: status_message => sqpopt_get_status_message procedure, public :: destroy => sqpopt_destroy Functions private  function sqpopt_get_status_message (me) result(msg) a description of the status of the last solve (including, for sqpopt_invalid_input , what was invalid). Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(in) :: me Return Value character(len=:), allocatable private pure function lbfgs_memory (memory, n, direct) the number of (s,y) pairs the limited-memory Hessian keeps, for the\noption value memory (see sqpopt_options_type%lbfgs_memory ) and n variables: memory itself, or, if it is 0 (automatic), , or 10 with the direct QP method ( direct ),\nwhose cost grows with the square of the number of pairs. Arguments Type Intent Optional Attributes Name integer, intent(in) :: memory the option value integer, intent(in) :: n number of variables logical, intent(in) :: direct whether the direct QP method is in use ( options%direct_qp ) Return Value integer Subroutines private  subroutine sqpopt_initialize (me, problem, options, hessian, qp_solver, linesearch, trust_region, report) initialize (or reinitialize) an sqpopt_type solver instance. Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(inout) :: me type( sqpopt_problem_type ), intent(in), optional :: problem the nonlinear program to be solved type( sqpopt_options_type ), intent(in), optional :: options solver options type( sqpopt_hessian_type ), intent(in), optional :: hessian Hessian of the Lagrangian approximation type( sqpopt_qp_solver_type ), intent(in), optional :: qp_solver QP subproblem solver type( sqpopt_linesearch_type ), intent(in), optional :: linesearch merit function / line search type( sqpopt_trust_region_type ), intent(in), optional :: trust_region trust-region globalization (opt-in\nalternative to linesearch , see sqpopt_trust_region_module ) procedure( sqpopt_report_func ), optional :: report optional user progress-reporting callback,\ncalled once per major iteration with the\ncurrent iterate; set its user_stop output\nto request the solver stop early\n(see sqpopt_types_module ) private  subroutine sqpopt_solve (me, x0, istat, lambda0) solve the nonlinear program starting from the initial guess x0 (and,\noptionally, initial constraint multipliers lambda0 , with the sign\nconvention of sqpopt_results_type ), running major SQP iterations\nuntil convergence or a stopping criterion is met. The outcome is\navailable from get_solution , get_results , and status_message . Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x0 initial guess for the optimization variables dimension(n) integer, intent(out) :: istat status code (see sqpopt_types_module ) real(kind=wp), intent(in), optional, dimension(:) :: lambda0 initial guess for the constraint multipliers dimension(m) private  subroutine validate_options (me, istat, msg) check the options and every component's settings for invalid values. Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(in) :: me integer, intent(out) :: istat sqpopt_success or sqpopt_invalid_input character(len=:), intent(out), allocatable :: msg description of the problem found (empty if none) private  subroutine sqpopt_get_solution (me, x, lambda, z) return the final solution of the last solve , the constraint\nmultipliers, and (optionally) the variable-bound multipliers (for the\noriginal problem; see sqpopt_results_type for the sign convention). Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(in) :: me real(kind=wp), intent(out), dimension(:) :: x optimization variables dimension(n) real(kind=wp), intent(out), dimension(:) :: lambda constraint multipliers dimension(m) real(kind=wp), intent(out), optional, dimension(:) :: z variable-bound multipliers dimension(n) private  subroutine sqpopt_get_results (me, results) return the full results of the last solve (status, counts, final\npoint, multipliers, and errors; see sqpopt_results_type ). Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(in) :: me type( sqpopt_results_type ), intent(out) :: results the results of the last solve private  subroutine sqpopt_destroy (me) destroy the solver instance, deallocating all internal arrays. Arguments Type Intent Opt