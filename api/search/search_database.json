trix ), intent(in) :: jac constraint Jacobian at x , dimension(m,n) real(kind=wp), intent(in), dimension(:) :: g objective gradient at x dimension(n) real(kind=wp), intent(in), dimension(:) :: p search direction dimension(n) real(kind=wp), intent(in), dimension(:) :: c constraint values at x dimension(m) real(kind=wp), intent(in), dimension(:) :: c_lb lower bounds on the constraints dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub upper bounds on the constraints dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda Lagrange multipliers for the constraints dimension(m) real(kind=wp), intent(out) :: dphi0 directional derivative of the merit function along p procedure, public :: update_penalty => update_penalty_parameter private  subroutine update_penalty_parameter (me, jac, g, p, php, c, c_lb, c_ub, lambda, lambda_qp) update the merit function's penalty parameter after the QP solve, for\nthe step p (with = php ), according to penalty_update : Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_merit_type ), intent(inout) :: me type( sqpopt_sparse_matrix ), intent(in) :: jac constraint Jacobian at x , dimension(m,n) real(kind=wp), intent(in), dimension(:) :: g objective gradient at x dimension(n) real(kind=wp), intent(in), dimension(:) :: p the step dimension(n) real(kind=wp), intent(in) :: php real(kind=wp), intent(in), dimension(:) :: c constraint values at x dimension(m) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda the current multipliers dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda_qp the QP's multipliers dimension(m) Source Code type , public :: sqpopt_merit_type !! options and state of the merit function (the `merit` component of !! [[sqpopt_linesearch_type]]). integer :: mode = sqpopt_merit_l1 !! merit function to use (set from `opt