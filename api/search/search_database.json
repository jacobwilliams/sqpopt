number of residuals integer :: m = 0 !! number of constraints integer :: nnz_r = 0 !! nonzeros of the residuals' Jacobian procedure ( sqpopt_residual_func ), pointer , nopass :: residuals => null () !! the user's residuals and constraints procedure ( sqpopt_residual_jac_func ), pointer , nopass :: jacobian => null () !! the user's Jacobians class ( * ), pointer :: user_data => null () !! the user's data (if any) ! the residuals and constraints at the starting point, which `solve` ! evaluates to start `z` from: kept for the solver's first evaluation there logical :: have_start = . false . !! whether they are kept real ( wp ), dimension (:), allocatable :: x_start !! the point `dimension(n)` real ( wp ), dimension (:), allocatable :: rc_start !! `r` then `c` there `dimension(l+m)` end type nlls_state","tags":"","url":"type/nlls_state.html"},{"title":"sqpopt_nlls_type – sqpopt ","text":"type, public :: sqpopt_nlls_type a nonlinear least-squares problem and its solver (see the module\ndocumentation). initialize defines the problem, solve solves it\nfrom a starting point, and get_solution returns the variables\nand the residuals there. Call destroy when done with it. Inherits type~~sqpopt_nlls_type~~InheritsGraph type~sqpopt_nlls_type sqpopt_nlls_type type~nlls_state nlls_state type~sqpopt_nlls_type->type~nlls_state state type~sqpopt_type sqpopt_type type~sqpopt_nlls_type->type~sqpopt_type solver type~sqpopt_hessian_type sqpopt_hessian_type type~sqpopt_type->type~sqpopt_hessian_type hessian type~sqpopt_linesearch_type sqpopt_linesearch_type type~sqpopt_type->type~sqpopt_linesearch_type linesearch, linesearch0 type~sqpopt_options_type sqpopt_options_type type~sqpopt_type->type~sqpopt_options_type options type~sqpopt_problem_type sqpopt_problem_type type~sqpopt_type->type~sqpopt_problem_type problem, problem0 type~sqpopt_qp_solver_type sqpopt_qp_solver_type type~sqpopt_type->type~sqpopt_qp_solver_type qp_solver, qp_solver0 type~sqpopt_restoration_type sqpopt_restoration_ty