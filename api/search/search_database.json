 select case ( resolved_mode ( me , n )) case ( sqpopt_qp_dense ) if ( allocated ( me % dense_qp % warm_status )) status = me % dense_qp % warm_status case default if ( allocated ( me % sparse_qp % warm_status )) status = me % sparse_qp % warm_status end select if ( allocated ( status )) then if ( size ( status ) /= m + n ) deallocate ( status ) end if end subroutine working_set","tags":"","url":"proc/working_set.html"},{"title":"elastic_slacks – sqpopt","text":"private  subroutine elastic_slacks(me, n, row, slack) the elastic slacks of the last QP solve with n variables: the general\nrow of each, and its value at the QP's solution (by how much the step\nviolates that linearized constraint). They are only kept if the\nactive-set solvers' keep_slacks is set (the solver sets it for its\ndiagnostics); row and slack have size zero if there are none. Type Bound sqpopt_qp_solver_type Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me integer, intent(in) :: n number of variables integer, intent(out), dimension(:), allocatable :: row the row of each elastic slack real(kind=wp), intent(out), dimension(:), allocatable :: slack its value Calls proc~~elastic_slacks~~CallsGraph proc~elastic_slacks sqpopt_qp_solver_type%elastic_slacks proc~resolved_mode resolved_mode proc~elastic_slacks->proc~resolved_mode Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~elastic_slacks~~CalledByGraph proc~elastic_slacks sqpopt_qp_solver_type%elastic_slacks proc~diagnostics_finish sqpopt_diagnostics_type%diagnostics_finish proc~diagnostics_finish->proc~elastic_slacks proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~diagnostics_finish proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine elastic_slacks ( me , n , row , slack ) class ( sqpopt_qp_solver_type ), intent ( in ) :: me integer , intent ( in ) :: n !! number of variables integer , dimension (:), allocatable , intent ( out ) :: row !! the row of each elastic slack real ( wp ), dimension (:), allocatable , intent ( out ) :: slack !! its value if ( me % n_slacks > 0 ) then select case ( resolved_mode ( me , n )) case ( sqpopt_qp_dense ) if ( allocated ( me % dense_qp % slack_row )) then allocate ( row ( size ( me % dense_qp % slack_row )), slack ( size ( me % dense_qp % slack_row ))) row = me % dense_qp % slack_row slack = me % dense_qp % slack_value end if case default if ( allocated ( me % sparse_qp % slack_row )) then allocate ( row ( size ( me % sparse_qp % slack_row )), slack ( size ( me % sparse_qp % slack_row ))) row = me % sparse_qp % slack_row slack = me % sparse_qp % slack_value end if end select end if if (. not . allocated ( row )) allocate ( row ( 0 ), slack ( 0 )) end subroutine elastic_slacks","tags":"","url":"proc/elastic_slacks.html"},{"title":"starting_working_set – sqpopt","text":"private  subroutine starting_working_set(me, x_lb, x_ub, c_lb, c_ub, status) the working set that the next QP solve will start from, for a problem\nwith the given bounds: the final working set of the last one (see working_set ), or, if there is none, the equality constraints and\nthe fixed variables (the active-set solvers' crash start). Type Bound sqpopt_qp_solver_type Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: x_lb variable lower bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: x_ub variable upper bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) integer, intent(out), dimension(:), allocatable :: status the working set dimension(m+n) (see working_set ) Calls proc~~starting_working_set~~CallsGraph proc~starting_working_set sqpopt_qp_solver_type%starting_working_set proc~working_set sqpopt_qp_solver_type%working_set proc~starting_working_set->proc~working_set proc~resolved_mode resolved_mode proc~working_set->proc~resolved_mode Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~starting_working_set~~CalledByGraph proc~starting_working_set sqpopt_qp_solver_type%starting_working_set proc~solve_qp_subproblem sqpopt_qp_solver_type%solve_qp_subproblem proc~solve_qp_subproblem->proc~starting_working_set proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~starting_working_set proc~sqpopt_iterate->proc~solve_qp_subproblem proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~sqpopt_iterate->proc~restoration_phase_step proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~sqpopt_iterate->proc~trust_region_step proc~restoration_phase_step->proc~solve_qp_subproblem proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~trust_region_step->proc~solve_qp_subproblem proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine starting_working_set ( me , x_lb , x_ub , c_lb , c_ub , status ) class ( sqpopt_qp_solver_type ), intent ( in ) :: me real ( wp ), dimension (:), intent ( in ) :: x_lb !! variable lower bounds `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: x_ub !! variable upper bounds `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: c_lb !! constraint lower bounds `dimension(m)` real ( wp ), dimension (:), intent ( in ) :: c_ub !! constraint upper bounds `dimension(m)` integer , dimension (:), allocatable , intent ( out ) :: status !! the working set `dimension(m+n)` (see [[working_set]]) integer :: n , m n = size ( x_lb ) m = size ( c_lb ) call me % working_set ( n , m , status ) if ( allocated ( status )) return allocate ( status ( m + n )) status = 0 where ( c_ub - c_lb <= 0.0_wp ) status ( 1 : m ) = - 1 where ( x_ub - x_lb <= 0.0_wp ) status ( m + 1 : m + n ) = - 1 end subroutine starting_working_set","tags":"","url":"proc/starting_working_set.html"},{"title":"direct_outcome_text – sqpopt","text":"public pure function direct_outcome_text(outcome) result(text) a short description of how direct_qp_step ended, for the detailed log. Arguments Type Intent Optional Attributes Name integer, intent(in) :: outcome a sqpopt_direct_* constant Return Value character(len=:), allocatable Called by proc~~direct_outcome_text~~CalledByGraph proc~direct_outcome_text direct_outcome_text proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~direct_outcome_text proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure function direct_outcome_text ( outcome ) result ( text ) integer , intent ( in ) :: outcome !! a `sqpopt_direct_*` constant character ( len = :), allocatable :: text select case ( outcome ) case ( sqpopt_direct_solved ); text = 'solved' case ( sqpopt_direct_nonconvex ); text = 'a face is nonconvex' case ( sqpopt_direct_singular ); text = 'a face is singular' case ( sqpopt_direct_max_changes ); text = 'too many changes of the working set' case ( sqpopt_direct_inaccurate ); text = 'a solve was inaccurate' case default ; text = 'the factorization failed' end select end function direct_outcome_text","tags":"","url":"proc/direct_outcome_text.html"},{"title":"direct_qp_step – sqpopt","text":"public  subroutine direct_qp_step(kkt, hessian, jac, x, g, c, x_lb, x_ub, c_lb, c_ub, max_changes, tol, status, p, lambda, n_changes, outcome, inertia) try to solve the QP subproblem directly (see the module documentation),\nstarting from the working set status . If it succeeds\n( outcome = sqpopt_direct_solved ), p and lambda are the QP's\nsolution and status its working set. Otherwise they are not to be\nused, status is unchanged, and outcome says why it gave up (see the sqpopt_direct_* constants). Arguments Type Intent Optional Attributes Name type( sqpopt_kkt_type ), intent(inout) :: kkt the KKT matrix (see sqpopt_kkt_module ) type( sqpopt_hessian_type ), intent(inout) :: hessian the Hessian (exact, with its shift, or quasi-Newton) type( sqpopt_sparse_matrix ), intent(in) :: jac sparse constraint Jacobian, dimension(m,n) real(kind=wp), intent(in), dimension(:) :: x current point dimension(n) real(kind=wp), intent(in), dimension(:) :: g objective gradient dimension(n) real(kind=wp), intent(in), dimension(:) :: c current constraint values dimension(m) real(kind=wp), intent(in), dimension(:) :: x_lb variable lower bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: x_ub variable upper bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) integer, intent(in) :: max_changes maximum number of changes of the working set real(kind=wp), intent(in) :: tol relative tolerance for a violated row or bound, and for\nthe sign of a multiplier integer, intent(inout), dimension(:) :: status the working set: the side ( -1 lower, +1 upper, 0 not in it) of each general row, then of each variable\nbound dimension(m+n) real(kind=wp), intent(out), dimension(:) :: p the step dimension(n) real(kind=wp), intent(out), dimension(:) :: lambda the