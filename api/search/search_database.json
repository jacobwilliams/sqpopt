ar_solver_* , default auto ) procedure, public :: new_matrices => least_squares_new_matrices private  subroutine least_squares_new_matrices (me) note that the Jacobian's values have changed (a new major iteration). Arguments Type Intent Optional Attributes Name class( sqpopt_least_squares_type ), intent(inout) :: me procedure, public :: min_norm => least_squares_min_norm private  subroutine least_squares_min_norm (me, jac, rows, r, d, ok) the (regularized) minimum-norm solution d of (see the\nmodule documentation), for the rows S of jac selected by rows . ok is false if the solver isn't enabled, or the factorization or the\nsolve failed (the solver is then disabled for the rest of the solve):\nthe caller then falls back on its iterative method. Arguments Type Intent Optional Attributes Name class( sqpopt_least_squares_type ), intent(inout) :: me type( sqpopt_sparse_matrix ), intent(in) :: jac the constraint Jacobian dimension(m,n) logical, intent(in), dimension(:) :: rows whether each row is in S dimension(m) real(kind=wp), intent(in), dimension(:) :: r the right-hand side (used for the rows in S ) dimension(m) real(kind=wp), intent(out), dimension(:) :: d the solution dimension(n) logical, intent(out) :: ok whether d was computed procedure, public :: multipliers => least_squares_multipliers private  subroutine least_squares_multipliers (me, jac, rows, free, g, lambda, ok) the (regularized) least-squares multipliers of the rows S of jac selected by rows , in the variables selected by free : , from the system\nof the module documentation with the right-hand side . lambda is only set for the rows in S . ok is false if the solver\nisn't enabled, or the factorization or the solve failed (the solver is\nthen disabled for the rest of the solve). Arguments Type Intent Optional Attributes Name class( sqpopt_least_squares_type ), intent(inout) :: me type( sqpopt_sparse_matrix ), intent(in) :: jac the constraint Jacobian dimension(m,n) logical, intent(in), dimension(:) :: row