sqpopt_kkt_module module~sqpopt_nlls_module sqpopt_nlls_module module~sqpopt_nlls_module->module~sqpopt_module module~sqpopt_nlls_module->module~sqpopt_options_module module~sqpopt_nlls_module->module~sqpopt_qp_solver_module module~sqpopt_nlls_module->module~sqpopt_trust_region_module module~sqpopt_qp_direct_module->module~sqpopt_kkt_module module~sqpopt_qp_direct_module->module~sqpopt_inertia_module module~sqpopt_qp_solver_module->module~sqpopt_kkt_module module~sqpopt_qp_solver_module->module~sqpopt_inertia_module module~sqpopt_qp_solver_module->module~sqpopt_qp_direct_module module~sqpopt_trust_region_module->module~sqpopt_kkt_module module~sqpopt_trust_region_module->module~sqpopt_inertia_module module~sqpopt_trust_region_module->module~sqpopt_least_squares_module module~sqpopt_trust_region_module->module~sqpopt_qp_solver_module module~sqpopt_trust_region_module->module~sqpopt_soc_module module~sqpopt_restoration_module->module~sqpopt_least_squares_module module~sqpopt_restoration_module->module~sqpopt_qp_solver_module module~sqpopt_soc_module->module~sqpopt_least_squares_module Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial integer, private, parameter :: kind_check = 1/merge(1, 0, qdldl_wp==wp) (a compile-time error if QDLDL was built\nwith another real kind) real(kind=wp), private, parameter :: qdldl_zero_tol = 1.0e-5_wp*epsilon(1.0_wp) a pivot at most this times the largest\nelement is a null pivot Derived Types type, public, extends( sqpopt_sparse_ldl_type ) :: sqpopt_qdldl_ldl_type the QDLDL backend (see the module documentation) Components Type Visibility Attributes Name Initial integer, public :: n_negative = 0 of the last factorization: the number of negative eigenvalues integer, public :: n_null = 0 of the last factorization: the number of zero eigenvalues logical, public :: inertia_known = .true. of the last factorization: whether n_negative and n_null are\nthe matrix's (else they are those of the factors, which are not\nthe matrix's: see the backend's documentation) logical, public :: out_of_memory = .false. whether an allocation of the backend failed (it stays set) integer, private :: n = 0 order of the matrix type(qdldl_type), private :: ldl the QDLDL solver (with the pattern, the values, and the factors) Type-Bound Procedures procedure, public :: start => qdldl_start procedure, public :: refactor => qdldl_refactor procedure, public :: back_solve => qdldl_back_solve procedure, public :: multiply => qdldl_multiply procedure, public :: free => qdldl_free Functions private  function qdldl_faithful (me, amax) result(faithful) after null pivots were replaced: whether the factors are still those of\nthe matrix (as they are if the matrix is singular, since the rest of a\nnull pivot's row is then zero too): for a fixed x and b = A x , the\nsolve with the factors satisfies A x' = b ( x' may differ from x along the null space). Arguments Type Intent Optional Attributes Name class( sqpopt_qdldl_ldl_type ), intent(inout) :: me real(kind=wp), intent(in) :: amax the largest element of the matrix Return Value logical Subroutines private  subroutine qdldl_start (me, n, irow, icol, ok, threads, signs) analyse the pattern: AMD, then (with signs ) each row with the sign -1 moved after all of its neighbours (see delay_negative_rows ). threads is not used (QDLDL is single-threaded). Arguments Type Intent Optional Attributes Name class( sqpopt_qdldl_ldl_type ), intent(inout) :: me integer, intent(in) :: n order of the matrix integer, intent(in), dimension(:) :: irow row indices of the entries dimension(nnz) integer, intent(in), dimension(:) :: icol column indices of the entries dimension(nnz) logical, intent(out) :: ok whether the backend is ready integer, intent(in), optional :: threads (not used) integer, intent(in), optional, dimension(:) :: signs the expected sign of each row's pivot dimension(n) public  subroutine delay_negative_rows (n, irow, icol, signs, perm) change the fill-reducing order perm (row perm(k) of the matrix is\nthe k -th to be eliminated) so that each row i with signs(i) == -1 comes after all of its neighbours (the rows j with an entry (i,j) ),\nand otherwise as early as it can. In a KKT matrix with positive\ndefinite, the pivot of a constraint's row is then an element of (less the earlier constraints' parts), which is zero\nonly if the rows of are dependent. Without the delay, a\nconstraint's row eliminated before its variables has a zero pivot even\nwhen the matrix is nonsingular, which a solver without pivoting can't\nget around. Arguments Type Intent Optional Attributes Name integer, intent(in) :: n order of the matrix integer, intent(in), dimension(:) :: irow row indices of the entries dimension(nnz) integer, intent(in), dimension(:) :: icol column indices of the entries dimension(nnz) integer, intent(in), dimension(:) :: signs the expected sign of each row's pivot dimension(n) integer, intent(inout), dimension(:) :: perm the order, changed in place dimension(n) private  subroutine qdldl_refactor (me, val, ok) factor the matrix with the values val , and set its inertia (see the\nmodule documentation for the null pivots, and inertia_known ). Arguments Type Intent Optional Attributes Name class( sqpopt_qdldl_ldl_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: val values of the entries dimension(nnz) logical, intent(out) :: ok whether the factorization succeeded private  subroutine qdldl_back_solve (me, v, ok) one solve with the factors, without refinement. Arguments Type Intent Optional Attributes Name class( sqpopt_qdldl_ldl_type ), intent(inout) :: me real(kind=wp), intent(inout), dimension(:) :: v the right-hand side, overwritten by the solution logical, intent(out) :: ok whether it was solved private  subroutine qdldl_multiply (me, x, y) the product with the values last factored. Arguments Type Intent Optional Attributes Name class( sqpopt_qdldl_ldl_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: x the vector dimension(n) real(kind=wp), intent(out), dimension(:) :: y the product dimension(n) private  subroutine qdldl_free (me) free everything. Arguments Type Intent Optional Attributes Name class( sqpopt_qdldl_ldl_type ), intent(inout) :: me","tags":"","url":"module/sqpopt_qdldl_ldl_module.html"},{"title":"sqpopt_iterate_module – sqpopt","text":"The core SQP major iteration ( sqpopt_iterate ): evaluates the problem\nfunctions, tests for convergence, updates the Hessian approximation\n(limited-memory quasi-Newton, or the user's exact Hessian with an\ninertia-correcting shift, found from the QP solver's tests or, with options%inertia_control , from a factorization, which also corrects\nSR1: see sqpopt_inertia_module ; before the exact Hessian is\nevaluated, multipliers that came from a QP with a large shift are\nre-estimated by least squares), solves the QP subproblem for the\nsearch direction (directly, if it can, with options%direct_qp : see sqpopt_qp_direct_module ; and re-solving it with diverging-multiplier\nconstraints elastic, see options%elastic_multiplier_limit ), and takes\nthe step: by a line\nsearch (with second-order corrections), or a trust-region step, or, when\nno acceptable step is found at an infeasible point or the QP is\ninconsistent, a feasibility restoration step or phase (see sqpopt_restoration_module ). What happened is returned in a sqpopt_iter_info , for the iteration log (see options%print_level );\nat print_level >= 3 , the details are also written to the detailed log\n(see sqpopt_log_module ). No dense n x n or m x n matrix is ever\nformed (except by the dense QP solver). Uses sqpopt_problem_mo