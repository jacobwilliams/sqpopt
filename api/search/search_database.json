ntent(in), optional, dimension(:) :: signs (not used) procedure, public :: refactor => mumps_refactor private  subroutine mumps_refactor (me, val, ok) factor the matrix with the values val . The pattern is analysed in the\nfirst call, with that call's values. If MUMPS runs out of its estimated\nworkspace, the factorization is repeated with twice the allowance, up\nto 20 times (as IPOPT does), and the larger allowance is kept for the\nfollowing factorizations. Arguments Type Intent Optional Attributes Name class( sqpopt_mumps_ldl_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: val values of the entries dimension(nnz) logical, intent(out) :: ok whether the factorization succeeded procedure, public :: back_solve => mumps_back_solve private  subroutine mumps_back_solve (me, v, ok) one solve with the factors, without refinement. Arguments Type Intent Optional Attributes Name class( sqpopt_mumps_ldl_type ), intent(inout) :: me real(kind=wp), intent(inout), dimension(:) :: v the right-hand side, overwritten by the solution logical, intent(out) :: ok whether it was solved procedure, public :: multiply => mumps_multiply private  subroutine mumps_multiply (me, x, y) the product with the values last factored. Arguments Type Intent Optional Attributes Name class( sqpopt_mumps_ldl_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: x the vector dimension(n) real(kind=wp), intent(out), dimension(:) :: y the product dimension(n) procedure, public :: free => mumps_free private  subroutine mumps_free (me) free everything (it does nothing if MUMPS was never started). Arguments Type Intent Optional Attributes Name class( sqpopt_mumps_ldl_type ), intent(inout) :: me Source Code type , extends ( sqpopt_sparse_ldl_type ), public :: sqpopt_mumps_ldl_type !! the MUMPS backend (see the module documentation). It holds a !! pointer, so it must not be copied. private logical :: analysed = . false . !! whether the sparsity pattern has been analysed #ifdef 