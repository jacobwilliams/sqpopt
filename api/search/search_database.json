: elastic_weight_max = 1.0e10_wp largest elastic penalty weight tried (same scaling) before the\nlinearized constraints are declared inconsistent logical, public :: warm_start = .true. start from the previous solve's final working set, if the\nproblem size is unchanged (see the module-level documentation) integer, public, dimension(:), allocatable :: force_sign real(kind=wp), public :: force_weight = 0.0_wp integer, public :: n_iter = 0 number of active-set iterations taken by the last solve (output) integer, public :: n_working = 0 number of general rows and variable bounds in the final working set of the\nlast solve (output) integer, public :: n_slacks = 0 number of elastic slacks in the last solve (output; see the module docs) logical, public :: negative_curvature = .false. whether the last solve found a direction of negative curvature\nof the Hessian in the variables (output; the QP was nonconvex) logical, public :: keep_slacks = .false. whether to keep the elastic slacks of each solve in slack_row and slack_value (internal input, set by the solver for its diagnostics:\nsee options%diagnostic_level ) integer, public, dimension(:), allocatable :: slack_row with keep_slacks : the general row of each elastic\nslack of the last solve (output) real(kind=wp), public, dimension(:), allocatable :: slack_value and its value at the solution: by how much the step\nviolates that linearized constraint (output) integer, public, dimension(:), allocatable :: warm_status side (-1/0/+1) of each general row and variable bound Type-Bound Procedures procedure, public :: solve => solve_dense_qp Subroutines private  subroutine solve_dense_qp (me, hessian, jac, x, g, c, x_lb, x_ub, c_lb, c_ub, p, lambda, istat) solve the linearized QP subproblem for the search direction p and\nthe associated Lagrange multipliers lambda (see the module-level\ndocumentation). istat is sqpopt_success , sqpopt_infeasible (the\nlinearized constraints are inconsistent; p is the elastic solution),\nor sqpopt_qp_solve_failed (iteration limit, or unbounded along a\ndirection of nonpositive curvature; p is the last iterate). It is sqpopt_out_of_memory , with p = 0 and lambda = 0 , if one of the\nlarge dense matrices (the Jacobian, the constraint rows, the Hessian, or\nthose of the starting step and of the initial working set) can't be\nallocated. Arguments Type Intent Optional Attributes Name class( sqpopt_dense_qp_type ), intent(inout) :: me type( sqpopt_hessian_type ), intent(inout) :: hessian matrix-free Hessian approximation (densified here) type( sqpopt_sparse_matrix ), intent(in) :: jac sparse constraint Jacobian, dimension(m,n) real(kind=wp), intent(in), dimension(:) :: x current point dimension(n) real(kind=wp), intent(in), dimension(:) :: g objective gradient dimension(n) real(kind=wp), intent(in), dimension(:) :: c constraint values dimension(m) real(kind=wp), intent(in), dimension(:) :: x_lb variable bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: x_ub variable bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: c_lb constraint bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint bounds dimension(m) real(kind=wp), intent(out), dimension(:) :: p search direction dimension(n) real(kind=wp), intent(out), dimension(:) :: lambda Lagrange multiplier estimate dimension(m) integer, intent(out) :: istat status code (see sqpopt_types_module ) private  subroutine build_active_set (arows, row_lb, row_ub, status, mtot, n, ja, rhs_active, orig_idx, n_active) gather the currently-active rows ( status/=0 ) of the combined mtot x n row set into a dense n_active x n matrix ja and their\ntarget right-hand-side values rhs_active ( row_lb or row_ub ,\nwhichever side is active), along with orig_idx , mapping each active\nrow back to its index in 1..mtot . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(mtot,n) :: arows combined constraint matrix (mtot rows, n columns) real(kind=wp), intent(in), dimension(mtot) :: row_lb lower bounds for each row in the combined constraint matrix real(kind=wp), intent(in), dimension(mtot) :: row_ub upper bounds for each row in the combined constraint matrix integer, intent(in), dimension(mtot) :: status status of each row (0 if inactive, -1 if active at lower bound, 1 if active at upper bound) integer, intent(in) :: mtot total number of rows in the combined constraint matrix integer, intent(in) :: n number of columns in the constraint matrix real(kind=wp), intent(out), dimension(:,:), allocatable :: ja dense matrix of currently-active rows real(kind=wp), intent(out), dimension(:), allocatable :: rhs_active right-hand-side values for the active rows integer, intent(out), dimension(:), allocatable :: orig_idx mapping from active rows to their original indices in 1..mtot integer, intent(out) :: n_active number of currently-active rows","tags":"","url":"module/sqpopt_qp_dense_module.html"},{"title":"sqpopt_dense_linalg_module – sqpopt","text":"Small, self-contained dense linear algebra helpers. Most are used only\nby sqpopt_qp_dense_module (the dense QP solver mode), the only place\nwhere dense n x n arrays are formed. The LU factorization and the\ninertia are for the small matrices (of the order of the quasi-Newton\nmemory) of sqpopt_hessian_module and sqpopt_kkt_module . Not linked to any\nexternal dependency: classic, textbook Householder QR and modified\nCholesky, small enough to validate directly against known small\nmatrices. Uses sqpopt_kinds module~~sqpopt_dense_linalg_module~~UsesGraph module~sqpopt_dense_linalg_module sqpopt_dense_linalg_module module~sqpopt_kinds sqpopt_kinds module~sqpopt_dense_linalg_module->module~sqpopt_kinds iso_fortran_env iso_fortran_env module~sqpopt_kinds->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point f