n(n) real(kind=wp), private, dimension(:), allocatable :: c_lb lower bounds of the constraints dimension(m) real(kind=wp), private, dimension(:), allocatable :: c_ub upper bounds of the constraints dimension(m) real(kind=wp), private :: ctol = 0.0_wp the feasibility tolerance of the options Type-Bound Procedures procedure, public :: initialize => nlls_initialize private  subroutine nlls_initialize (me, n, n_residuals, residuals, jacobian, rjac_irow, rjac_icol, x_lb, x_ub, c_lb, c_ub, cjac_irow, cjac_icol, options, hessian, qp_solver, linesearch, trust_region, data) define the least-squares problem: n variables, n_residuals residuals\nwith the sparsity pattern rjac_irow / rjac_icol of their Jacobian\n(1-based row and column of each nonzero, as for set_jacobian_sparsity ), and optionally bounds on the variables and\nconstraints c_lb <= c(x) <= c_ub with the pattern cjac_irow / cjac_icol of their Jacobian (give all four, or none).\nThe solver's components are configured as for sqpopt_initialize .\nWith options%hessian_mode = sqpopt_hessian_exact , the Gauss-Newton\nHessian is used (see the module documentation). Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_nlls_type ), intent(inout) :: me integer, intent(in) :: n number of variables integer, intent(in) :: n_residuals number of residuals procedure( sqpopt_residual_func ) :: residuals evaluates the residuals and the constraints procedure( sqpopt_residual_jac_func ) :: jacobian evaluates their Jacobians' nonzeros integer, intent(in), dimension(:) :: rjac_irow residuals' Jacobian pattern: row (residual) indices integer, intent(in), dimension(:) :: rjac_icol residuals' Jacobian pattern: column (variable) indices real(kind=wp), intent(in), optional, dimension(:) :: x_lb lower bounds of the variables dimension(n) (default: none) real(kind=wp), intent(in), optional, dimension(:) :: x_ub upper bounds of the variables dimension(n) (default: none) real(kind=wp), intent(in), optional, dimension(:) :: c_lb lower bounds of the constraints dimension(m) real(kind=wp), intent(in), optional, dimension(:) :: c_ub upper bounds of the constraints dimension(m) integer, intent(in), optional, dimension(:) :: cjac_irow constraints' Jacobian pattern: row indices integer, intent(in), optional, dimension(:) :: cjac_icol constraints' Jacobian pattern: column indices type( sqpopt_options_type ), intent(in), optional :: options solver options type( sqpopt_hessian_type ), intent(in), optional :: hessian Hessian approximation settings type( sqpopt_qp_solver_type ), intent(in), optional :: qp_solver QP solver settings type( sqpopt_linesearch_type ), intent(in), optional :: linesearch line search settings type( sqpopt_trust_region_type ), intent(in), optional :: trust_region trust-region settings class(*), intent(inout), optional, target :: data user data, passed to residuals and jacobian procedure, public :: solve => nlls_solve private  subroutine nlls_solve (me, x0, istat) solve the problem from the starting point x0 (moved inside the bounds,\nas sqpopt_solve does). istat is the solver's status code (see sqpopt_types_module ): sqpopt_success at a least-squares solution. Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_nlls_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x0 starting point dimension(n) integer, intent(out) :: istat status code (see sqpopt_types_module ) procedure, public :: get_solution => nlls_get_solution private  subroutine nlls_get_solution (me, x, residuals, sum_of_squares, lambda) the solution of the last solve : the variables, and optionally the\nresiduals there, the sum of their squares, and the multipliers of the\nconstraints (with the sign convention of sqpopt_results_type ). Arguments Type Intent Optional Attributes Name class( sqpopt_nlls_type ), intent(in) :: me real(kind=wp), intent(out), dimension(:) :: x variables dimension(n) real(kind=wp), intent(out), optional, dimension(:) :: residuals residuals dimension(l) real(kind=wp), intent(out), optional :: sum_of_squares real(kind=wp), intent(out), optional, dimension(:) :: lambda constraint multipliers dimension(m) procedure, public :: get_results => nlls_get_results private  subroutine nlls_get_results (me, results) the results of the last solve , as the SQP solver returns them for the transformed problem (see the module documentation): x is the\nvariables followed by , f is , and c and lambda are those of the residual equations followed by the\nconstraints. The status, the counts, and the times are as for any solve\n( n_eval_fc and n_eval_gjac count the calls of residuals and jacobian ). Arguments Type Intent Optional Attributes Name class( sqpopt_nlls_type ), intent(in) :: me type( sqpopt_results_type ), intent(out) :: results the results of the last solve procedure, public :: status_message => nlls_status_message private  function nlls_status_message (me) result(msg) a description of the status of the last solve . Arguments Type Intent Optional Attributes Name class( sqpopt_nlls_type ), intent(in) :: me Return Value character(len=:), allocatable procedure, public :: destroy => nlls_destroy private  subroutine nlls_destroy (me) free everything. Arguments Type Intent Optional Attributes Name class( sqpopt_nlls_type ), intent(inout) :: me Source Code type , public :: sqpopt_nlls_type !! a nonlinear least-squares problem and its solver (see the module !! documentation). `initialize` defines the problem, `solve` solves it !! from a starting point, and `get_solution` returns the variables !! and the residuals there. Call `destroy` when done with it. private type ( sqpopt_type ) :: solver !! the SQP solver, for the transformed problem type ( nlls_state ), pointer :: state => null () !! what its callbacks need (see `nlls_state`) real ( wp ), dimension (:), allocatable :: x_lb !! lower bounds of the variables `dimension(n)` real ( wp ), dimension (:), allocatable :: x_ub !! upper bounds of the variables `dimension(n)` real ( wp )