rce Code subroutine funnel_line_search ( me , eval_f , eval_c , x , p , f , g , c , c_lb , c_ub , alpha , x_new , istat , soc ) class ( sqpopt_linesearch_type ), intent ( inout ) :: me procedure ( sqpopt_ls_objective_func ) :: eval_f !! evaluates the objective procedure ( sqpopt_ls_constraint_func ) :: eval_c !! evaluates the constraints real ( wp ), dimension (:), intent ( in ) :: x !! current point `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: p !! search direction `dimension(n)` real ( wp ), intent ( in ) :: f !! objective function value at `x` real ( wp ), dimension (:), intent ( in ) :: g !! objective gradient at `x` `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: c !! constraint values at `x` `dimension(m)` real ( wp ), dimension (:), intent ( in ) :: c_lb !! constraint lower bounds `dimension(m)` real ( wp ), dimension (:), intent ( in ) :: c_ub !! constraint upper bounds `dimension(m)` real ( wp ), intent ( out ) :: alpha !! accepted step length (`0` if no step was taken) real ( wp ), dimension (:), intent ( out ) :: x_new !! the accepted new point `dimension(n)` integer , intent ( out ) :: istat !! status code (see [[sqpopt_types_module]]) procedure ( sqpopt_soc_func ), optional :: soc !! computes a second-order-corrected step real ( wp ), dimension (:), allocatable :: x_trial , p_soc real ( wp ), dimension (:), allocatable :: step !! the trial step, for the second-order correction real ( wp ), dimension (:), allocatable :: c_trial real ( wp ) :: f_trial , theta0 , theta_t , gtp logical :: ok , soc_ok , f_type , acc integer :: it allocate ( x_trial ( size ( x )), p_soc ( size ( x )), step ( size ( x )), c_trial ( size ( c ))) theta0 = l1_violation ( c , c_lb , c_ub ) call me % funnel % prepare ( theta0 ) gtp = dot_product ( g , p ) alpha = initial_step_length ( x , p , me % major_step_limit ) do it = 1 , me % max_ls_iter x_trial = x + alpha * p call eval_fc ( eval_f , eval_c , x_trial , f_trial , c_trial , ok ) if ( ok ) then theta_t = l1_violation ( c_trial , c_lb , c_ub ) acc = me % funnel % accept ( theta0 , f , - alpha * gtp , theta_t , f_trial , f_type ) call log_theta_trial ( me , alpha , theta_t , f_trial , . true ., acc , f_type , . false .) if ( acc ) then call accept () return end if else call log_theta_trial ( me , alpha , 0.0_wp , 0.0_wp , . false ., . false ., . false ., . false .) end if if ( it == 1 . and . ok . and . present ( soc )) then if ( theta_t >= theta0 ) then ! the full step didn't reduce the constraint violation: try ! the second-order-corrected step before backtracking: step = alpha * p call soc ( step , c_trial , p_soc , soc_ok ) if ( soc_ok ) then x_trial = x + p_soc call eval_fc ( eval_f , eval_c , x_trial , f_trial , c_trial , ok ) if ( ok ) then theta_t = l1_violation ( c_trial , c_lb , c_ub ) acc = me % funnel % accept ( theta0 , f , - alpha * gtp , theta_t , f_trial , f_type ) call log_theta_trial ( me , alpha , theta_t , f_trial , . true ., acc , f_type , . true .) if ( acc ) then me % used_soc = . true . call accept () return end if end if end if end if end if if ( ok . and . me % interpolate ) then ! interpolate the violation if the trial made it worse, else the ! objective (as in [[filter_line_search]]) if ( theta_t > theta0 . and . theta0 > 0.0_wp ) then alpha = next_step_length ( me , alpha , theta0 , - theta0 , theta_t ) else alpha = next_step_length ( me , alpha , f , min ( gtp , 0.0_wp ), f_trial ) end if else alpha = me % backtrack * alpha end if if ( alpha < me % alpha_min ) exit end do ! no acceptable point was found: no step is taken call me % log % put ( sqpopt_log_detail , 'ls  no acceptable step length (the next one would be below ' // & fmt_e ( me % alpha_min ) // ')' ) alpha = 0.0_wp x_new = x istat = sqpopt_line_search_failed contains subroutine accept () !! accept `x_trial`, shrinking the funnel after an h-type step if (. not . f_type ) call me % funnel % record ( theta0 , theta_t ) x_new = x_trial istat = sqpopt_success end subroutine accept end subroutine funnel_line_search","tags":"","url":"proc/funnel_line_search.html"},{"title":"log_merit_trial – sqpopt","text":"private  subroutine log_merit_trial(me, alpha, phi, target, ok, is_soc) the detailed log's line for a trial point of a merit-function search:\nits step length, merit value, and the value it had to reach. Arguments Type Intent Optional Attributes Name class( sqpopt_linesearch_type ), intent(in) :: me real(kind=wp), intent(in) :: alpha step length real(kind=wp), intent(in) :: phi merit value at the trial point real(kind=wp), intent(in) :: target the value the merit had to reach to be accepted logical, intent(in) :: ok whether the functions were finite there logical, intent(in) :: is_soc whether it was the second-order-corrected step Calls proc~~log_merit_trial~~CallsGraph proc~log_merit_trial log_merit_trial proc~fmt_e fmt_e proc~log_merit_trial->proc~fmt_e proc~fmt_g fmt_g proc~log_merit_trial->proc~fmt_g proc~log_on sqpopt_log_type%log_on proc~log_merit_trial->proc~log_on proc~log_put sqpopt_log_type%log_put proc~log_merit_trial->proc~log_put Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~log_merit_trial~~CalledByGraph proc~log_merit_trial log_merit_trial proc~backtrack_search backtrack_search proc~backtrack_search->proc~log_merit_trial proc~armijo_line_search armijo_line_search proc~armijo_line_search->proc~backtrack_search proc~watchdog_line_search watchdog_line_search proc~watchdog_line_search->proc~backtrack_search proc~line_search sqpopt_linesearch_type%line_search proc~line_search->proc~armijo_line_search proc~line_search->proc~watchdog_line_search proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~line_search proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine log_merit_trial ( me , alpha , phi , target , ok , is_soc ) class ( sqpopt_linesearch_type ), intent ( in ) :: me real ( wp ), intent ( in ) :: alpha !! step length real ( wp ), intent ( in ) :: phi !! merit value at the trial point real ( wp ), intent ( in ) :: target !! the value the merit had to reach to be accepted logical , intent ( in ) :: ok !! whether the functions were finite there logical , intent ( in ) :: is_soc !! whether it was the second-order-corrected step character ( len = :), allocatable :: what if (. not . me % log % on ( sqpopt_log_detail )) return what = merge ( 'ls  SOC   alpha ' , 'ls  trial alpha ' , is_soc ) if (. not . ok ) then call me % log % put ( sqpopt_log_detail , what // fmt_e ( alpha ) // ': non-finite function value, rejected' ) else call me % log % put ( sqpopt_log_detail , what // fmt_e ( alpha ) // ': merit ' // fmt_g ( phi ) // ', needed <= ' // & fmt_g ( target ) // merge ( ', accepted' , ', rejected' , phi <= target )) end if end subroutine log_merit_trial","tags":"","url":"proc/log_merit_trial.html"},{"title":"log_theta_trial – sqpopt","text":"private  subroutine log_theta_trial(me, alpha, theta, f, ok, accepted, f_type, is_soc) the detailed log's line for a trial point of a filter or funnel search:\nits step length, violation, objective, and whether (and as which type of\nstep) it was accepted. Arguments Type Intent Optional Attributes Name class( sqpopt_linesearch_type ), intent(in) :: me real(kind=wp), intent(in) :: alpha step length real(kind=wp), intent(in) :: theta constraint violation at the trial point real(kind=wp), intent(in) :: f objective at the trial point logical, intent(in) :: ok whether the functions were finite there logical, intent(in) :: accepted whether the trial point was accepted logical, intent(in) :: f_type whether the switching condition held (an f-type step) logical, intent(in) :: is_soc whether it was the second-order-corrected step Calls proc~~log_theta_trial~~CallsGraph proc~log_theta_trial log_theta_trial proc~fmt_e fmt_e proc~log_theta_trial->proc~fmt_e proc~fmt_g fmt_g proc~log_theta_trial->proc~fmt_g proc~log_on sqpopt_log_type%log_on proc~log_theta_trial->proc~log_on proc~log_put sqpopt_log_type%log_put proc~log_theta_trial->proc~log_put Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~log_theta_trial~~CalledByGraph proc~log_theta_trial log_theta_trial proc~filter_line_search filter_line_search proc~filter_line_search->proc~log_theta_trial proc~funnel_line_search funnel_line_search proc~funnel_line_search->proc~log_theta_trial proc~line_search sqpopt_linesearch_type%line_search proc~line_search->proc~filter_line_search proc~line_search->proc~funnel_line_search proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~line_search proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine log_theta_trial ( me , alpha , theta , f , ok , accepted , f_type , is_soc ) class ( sqpopt_linesearch_type ), intent ( in ) :: me real ( wp ), intent ( in ) :: alpha !! step length real ( wp ), intent ( in ) :: theta !! constraint violation at the trial point real ( wp ), intent ( in ) :: f !! objective at the trial point logical , intent ( in ) :: ok !! whether the functions were finite there logical , intent ( in ) :: accepted !! whether the trial point was accepted logical , intent ( in ) :: f_type !! whether the switching condition held (an f-type step) logical , intent ( in ) :: is_soc !! whether it was the second-order-corrected step character ( len = :), allocatable :: what , verdict if (. not . me % log % on ( sqpopt_log_detail )) return what = merge ( 'ls  SOC   alpha ' , 'ls  trial alpha ' , is_soc ) if (. not . ok ) then call me % log % put ( sqpopt_log_detail , what // fmt_e ( alpha ) // ': non-finite function value, rejected' ) return end if if ( accepted ) then if ( f_type ) then verdict = 'accepted (f-type: objective decrease)' else verdict = 'accepted (h-type: violation/objective)' end if else if ( me % mode == sqpopt_linesearch_funnel ) then verdict = 'rejected (funnel width ' // fmt_e ( me % funnel % width ) // ')' else verdict = 'rejected (filter: ' // trim ( adjustl ( itoa ( size ( me % filter % theta )))) // ' entries)' end if call me % log % put ( sqpopt_log_detail , what // fmt_e ( alpha ) // ': violation ' // fmt_e ( theta ) // ', objective ' // & fmt_g ( f ) // ', ' // verdict ) contains pure function itoa ( i ) result ( str ) !! integer to string integer , intent ( in ) :: i !! the integer to format character ( len = 16 ) :: str write ( str , '(I0)' ) i end function itoa end subroutine log_theta_trial","tags":"","url":"proc/log_theta_trial.html"},{"title":"eval_merit_function – sqpopt","text":"private  subroutine eval_merit_function(me, f, c, c_lb, c_ub, lambda, phi, alpha) evaluate the merit function used to measure progress, dispatching on me%mode : sqpopt_merit_l1 : sqpopt_merit_augmented_lagrangian : where the slack s is the closed-form minimizer of subject\n  to (see augmented_lagrangian_slacks ).\n  With the joint step ( joint_active ), the multipliers and the slacks\n  are those at step length alpha along it, and ( alpha=0 if\n  absent), instead of the slacks' closed-form minimizer (see update_penalty_parameter ). Type Bound sqpopt_merit_type Arguments Type Intent Optional Attributes Name class( sqpopt_merit_type ), intent(inout) :: me real(kind=wp), intent(in) :: f objective function value real(kind=wp), intent(in), dimension(:) :: c constraint values dimension(m) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda Lagrange multiplier estimate dimension(m) (only used by sqpopt_merit_augmented_lagrangian ) real(kind=wp), intent(out) :: phi value of the merit function real(kind=wp), intent(in), optional :: alpha step length along the joint step (see above) Calls proc~~eval_merit_function~~CallsGraph proc~eval_merit_function sqpopt_merit_type%eval_merit_function proc~augmented_lagrangian_slacks augmented_lagrangian_slacks proc~eval_merit_function->proc~augmented_lagrangian_slacks Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~eval_merit_function~~CalledByGraph proc~eval_merit_function sqpopt_merit_type%eval_merit_function proc~armijo_line_search armijo_line_search proc~armijo_line_search->proc~eval_merit_function proc~backtrack_search backtrack_search proc~armijo_line_search->proc~backtrack_search proc~eval_trial eval_trial proc~eval_trial->proc~eval_merit_function proc~exact_line_search exact_line_search proc~exact_line_search->proc~eval_merit_function proc~exact_line_search->proc~eval_trial proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~trust_region_step->proc~eval_merit_function proc~watchdog_line_search watchdog_line_search proc~watchdog_line_search->proc~eval_merit_function proc~watchdog_line_search->proc~eval_trial proc~watchdog_line_search->proc~backtrack_search proc~backtrack_search->proc~eval_trial proc~line_search sqpopt_linesearch_type%line_search proc~line_search->proc~armijo_line_search proc~line_search->proc~exact_line_search proc~line_search->proc~watchdog_line_search proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~trust_region_step proc~sqpopt_iterate->proc~line_search proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine eval_merit_function ( me , f , c , c_lb , c_ub , lambda , phi , alpha ) class ( sqpopt_merit_type ), intent ( inout ) :: me real ( wp ), intent ( in ) :: f !! objective function value real ( wp ), dimension (:), intent ( in ) :: c !! constraint values `dimension(m)` real ( wp ), dimension (:), intent ( in ) :: c_lb !! constraint lower bounds `dimension(m)` real ( wp ), dimension (:), intent ( in ) :: c_ub !! constraint upper bounds `dimension(m)` real ( wp ), dimension (:), intent ( in ) :: lambda !! Lagrange multiplier estimate `dimension(m)` !! (only used by `sqpopt_merit_augmented_lagrangian`) real ( wp ), intent ( out ) :: phi !! value of the merit function real ( wp ), optional , intent ( in ) :: alpha !! step length along the joint step (see above) real ( wp ), dimension (:), allocatable :: s , r , lam allocate ( s ( size ( c )), r ( size ( c )), lam ( size ( c ))) select case ( me % mode ) case ( sqpopt_merit_augmented_lagrangian ) if ( me % joint_active ) then ! (the multipliers and the slacks both move along the step) if ( present ( alpha )) then lam = me % lambda0 + alpha * ( lambda - me % lambda0 ) s = me % s0 + alpha * me % q else lam = me % lambda0 s = me % s0 end if else lam = lambda call augmented_lagrangian_slacks ( me , c , c_lb , c_ub , lam , s ) end if r = c - s phi = f - dot_product ( lam , r ) + 0.5_wp * me % penalty * dot_product ( r , r ) case default phi = f + me % penalty * sum ( max ( c_lb - c , 0.0_wp ) + max ( c - c_ub , 0.0_wp )) end select end subroutine eval_merit_function","tags":"","url":"proc/eval_merit_function.html"},{"title":"augmented_lagrangian_slacks – sqpopt","text":"private  subroutine augmented_lagrangian_slacks(me, c, c_lb, c_ub, lambda, s) the closed-form slack s that minimizes the augmented Lagrangian merit\nfunction subject to : this generalizes the\nnon-negative slack of the original\n(single-sided) formulation to sqpopt 's two-sided constraint bounds\n(equality rows, where c_lb=c_ub , are handled automatically since s is then clipped to that single value regardless of ). Arguments Type Intent Optional Attributes Name class( sqpopt_merit_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: c constraint values at x dimension(m) real(kind=wp), intent(in), dimension(:) :: c_lb lower bounds on the constraints dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub upper bounds on the constraints dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda Lagrange multipliers for the constraints dimension(m) real(kind=wp), intent(out), dimension(:) :: s closed-form slack that minimizes the augmented Lagrangian merit function Called by proc~~augmented_lagrangian_slacks~~CalledByGraph proc~augmented_lagrangian_slacks augmented_lagrangian_slacks proc~eval_merit_function sqpopt_merit_type%eval_merit_function proc~eval_merit_function->proc~augmented_lagrangian_slacks proc~merit_directional_derivative sqpopt_merit_type%merit_directional_derivative proc~merit_directional_derivative->proc~augmented_lagrangian_slacks proc~update_penalty_parameter sqpopt_merit_type%update_penalty_parameter proc~update_penalty_parameter->proc~augmented_lagrangian_slacks proc~armijo_line_search armijo_line_search proc~armijo_line