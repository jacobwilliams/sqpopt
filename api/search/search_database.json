ertia_module module~sqpopt_qp_solver_module->module~sqpopt_kkt_module module~sqpopt_qp_solver_module->module~sqpopt_qp_dense_module module~sqpopt_qp_solver_module->module~sqpopt_qp_direct_module module~sqpopt_qp_solver_module->module~sqpopt_qp_reduced_hessian_module module~sqpopt_restoration_module->module~sqpopt_hessian_module module~sqpopt_restoration_module->module~sqpopt_qp_solver_module module~sqpopt_restoration_module->module~sqpopt_least_squares_module module~sqpopt_trust_region_module->module~sqpopt_hessian_module module~sqpopt_trust_region_module->module~sqpopt_inertia_module module~sqpopt_trust_region_module->module~sqpopt_kkt_module module~sqpopt_trust_region_module->module~sqpopt_qp_solver_module module~sqpopt_trust_region_module->module~sqpopt_least_squares_module module~sqpopt_trust_region_module->module~sqpopt_soc_module module~sqpopt_diagnostics_module->module~sqpopt_options_module module~sqpopt_diagnostics_module->module~sqpopt_qp_solver_module module~sqpopt_least_squares_module->module~sqpopt_kkt_module module~sqpopt_soc_module->module~sqpopt_least_squares_module Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial integer, public, parameter :: sqpopt_hessian_bfgs = 1 limited-memory (damped) BFGS quasi-Newton Hessian approximation integer, public, parameter :: sqpopt_hessian_sr1 = 2 limited-memory symmetric rank-1 (SR1) quasi-Newton Hessian approximation integer, public, parameter :: sqpopt_hessian_exact = 3 user-supplied exact sparse Hessian of the Lagrangian (the hess function of set_functions , with the pattern of set_hessian_sparsity ; see the module documentation) Derived Types type, public :: sqpopt_hessian_type stores and updates a limited-memory approximation to the\nHessian of the Lagrangian (never stores a dense n x n matrix: hessian_dense writes one into the dense QP solver's array). Components Type Visibility Attributes Name Initial integer, public :: n = 0 problem size integer, public :: max_history = 0 number of (s,y) pairs retained (independent of n ) integer, public :: n_history = 0 number of pairs currently stored ( <= max_history ) logical, public :: use_sr1 = .false. if true, use the limited-memory SR1 update instead of BFGS logical, public :: damping = .true. if true, use Powell's damped BFGS update (see hessian_update_bfgs ),\nelse skip any update that fails the curvature condition integer, public :: first = 1 column of s / y holding the oldest pair (the buffer is circular:\nthe i -th oldest pair is in column pair_col (i) ) real(kind=wp), public, dimension(:,:), allocatable :: s stored step vectors dimension(n,max_history) real(kind=wp), public, dimension(:,:), allocatable :: y stored Lagrangian gradient-change vectors dimension(n,max_history) real(kind=wp), public, dimension(:), allocatable :: rho 1/(y&#94;T s) for each stored pair dimension(max_history) (BFGS) real(kind=wp), public, dimension(:,:), allocatable :: ss ss(a,b) for the pairs in columns a , b dimension(max_history,max_history) real(kind=wp), public, dimension(:,:), allocatable :: sy sy(a,b) for the pairs in columns a , b dimension(max_history,max_history) real(kind=wp), public :: gamma = 1.0_wp scaling of the initial Hessian real(kind=wp), public :: gamma0 = 1.0_wp gamma before any update (and after a hessian_reset ) logical, public :: exact = .false. if true, use the user's sparse Hessian (see hessian_set_exact ) real(kind=wp), public :: shift_min = 1.0e-4_wp smallest nonzero shift, relative to real(kind=wp), public :: shift_max = 1.0e10_wp largest shift, relative to the same real(kind=wp), public :: shift = 0.0_wp the current shift (added to the diagonal in every mode; in the\nquasi-Newton modes it is zero unless the inertia control sets it) logical, public :: shift_dominant = .false. whether the shift's term of the last step was at least\nas large as the gradient: the QP's multipliers are then mostly an\nartifact of the shift (internal state, set and used by sqpopt_iterate , which then re-estimates them) integer, public, dimension(:), allocatable :: h_irow sparsity pattern: row indices integer, public, dimension(:), allocatable :: h_icol sparsity pattern: column indices real(kind=wp), public, dimension(:), allocatable :: h_val current nonzero values logical, public :: mid_valid = .false. whether mid_lu / mid_piv match the current pairs and gamma logical, public :: mid_ok = .false. whether the middle matrix is nonsingular real(kind=wp), public, dimension(:,:), allocatable :: mid_lu LU factors of the middle matrix integer, public, dimension(:), allocatable :: mid_piv row pivots of the LU factorization logical, public :: diag_valid = .false. whether diag matches the current factorization real(kind=wp), public, dimension(:), allocatable :: diag the diagonal of the approximation (see hessian_diagonal ) Type-Bound Procedures procedure, public :: initialize => hessian_initialize procedure, public :: update_bfgs => hessian_update_bfgs procedure, public :: update_sr1 => hessian_update_sr1 procedure, public :: hv_product => hessian_vector_product procedure, public :: diagonal => hessian_diagonal procedure, public :: dense => hessian_dense procedure, public :: inverse_vector_product => hessian_inverse_vector_product procedure, public :: reset => hessian_reset procedure, public :: set_exact => hessian_set_exact procedure, public :: set_values => hessian_set_values procedure, public :: magnitude => hessian_size procedure, public :: low_rank_size => hessian_low_rank_size procedure, public :: low_rank_multiply => hessian_low_rank_multiply procedure, public :: low_rank_column => hessian_low_rank_column procedure, public :: low_rank_multiply_transpose => hessian_low_rank_multiply_transpose procedure, public :: low_rank_middle => hessian_low_rank_middle Functions private pure function pair_col (me, i) the column of s / y / rho holding the i -th oldest stored pair\n( i=1 is the oldest, i=n_history the newest). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me integer, intent(in) :: i age rank of the pair ( 1 = oldest, n_history = newest) Return Value integer private  function hessian_low_rank_size (me) result(r) the rank r of the low-rank part of the compact representation (see the\nmodule documentation): 2k (BFGS) or k (SR1) for k stored pairs. It\nis 0 when the matrix is just (no pairs yet, or a\nsingular middle matrix, where hessian_vector_product falls back on\nthat too), and in exact mode. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me Return Value integer private pure function hessian_size (me) result(h) the size of the Hessian, which the shift is relative to: for the exact Hessian, and for a quasi-Newton one. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me Return Value real(kind=wp) Subroutines private  subroutine hessian_initialize (me, n, max_history, use_sr1, scale0) initialize the limited-memory Hessian approximation (equivalent to , with no (s,y) pairs stored). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me integer, intent(in) :: n problem size integer, intent(in) :: max_history number of (s,y) pairs to retain logical, intent(in), optional :: use_sr1 if true, use SR1 instead of BFGS (default .false. ) real(kind=wp), intent(in), optional :: scale0 initial Hessian approximation scale0 (default 1) private  subroutine hessian_update_bfgs (me, s, y) update the limited-memory Hessian approximation using the BFGS\nupdate formula, given the step and the change\nin the Lagrangian gradient . Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: s step vector dimension(n) real(kind=wp), intent(in), dimension(:) :: y Lagrangian gradient change dimension(n) private  subroutine hessian_update_sr1 (me, s, y) update the limited-memory Hessian approximation using the symmetric\nrank-1 (SR1) update formula. The update is skipped if the standard\nSR1 safeguard is not satisfied. The oldest pair is discarded once max_history pairs are stored. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: s step vector dimension(n) real(kind=wp), intent(in), dimension(:) :: y Lagrangian gradient change dimension(n) private  subroutine hessian_push_pair (me, s, y) push a new (s,y) pair into the circular history buffer, discarding\nthe oldest pair if max_history pairs are already stored (by\noverwriting its column and advancing first , so no data is moved), and\nupdate the inner products ss and sy with the new pair ( O(nk) ). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: s step vector dimension(n) real(kind=wp), intent(in), dimension(:) :: y Lagrangian gradient change dimension(n) private  subroutine hessian_vector_product (me, v, hv) compute the matrix-free Hessian-vector product , used\nby the QP subproblem solver in place of an explicit dense matrix.\nUses the compact representation of either the BFGS or the SR1\nmatrix (Byrd, Nocedal & Schnabel, 1994), depending on use_sr1 , with\nits small middle matrix factored once (see factor_middle_matrix )\nand reused until the pairs or gamma change. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: v input vector dimension(n) real(kind=wp), intent(out), dimension(:) :: hv result dimension(n) private  subroutine hessian_diagonal (me, d) the diagonal of the Hessian approximation , from its compact\nrepresentation (at a cost of for k pairs, without\nforming ): , with the i -th row of (BFGS, minus)\nor of (SR1, plus), i.e. the row sums of . Used as a (Jacobi) preconditioner. The\nresult is kept until the pairs or the scaling change. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(out), dimension(:) :: d the diagonal dimension(n) private  subroutine hessian_dense (me, h) the Hessian approximation as a dense matrix, in the caller's\narray (for the dense QP solver, the only place a dense matrix is used). Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(out), dimension(:,:) :: h the matrix dimension(n,n) (symmetric, both triangles set) private  subroutine factor_middle_matrix (me) form and LU-factor the middle matrix of the compact representation for\nthe current pairs and gamma ( ): Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me private pure subroutine middle_matrix (me, a) form the middle matrix of the compact representation (see factor_middle_matrix ) for the current pairs and gamma , in a . Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me real(kind=wp), intent(out), dimension(:,:) :: a the matrix: dimension(k,k) (SR1) or dimension(2k,2k) (BFGS) private pure subroutine hessian_low_rank_multiply (me, w, v) the product with the low-rank factor of the compact\nrepresentation (see the module documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: w the coefficients dimension(r) real(kind=wp), intent(out), dimension(:) :: v the product dimension(n) private pure subroutine hessian_low_rank_column (me, j, u) column j of the low-rank factor of the compact representation\n(see the module documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me integer, intent(in) :: j the column ( 1..r ) real(kind=wp), intent(out), dimension(:) :: u the column dimension(n) private pure subroutine hessian_low_rank_multiply_transpose (me, v, w) the product with the low-rank factor of the compact\nrepresentation (see the module documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: v the vector dimension(n) real(kind=wp), intent(out), dimension(:) :: w the product dimension(r) private pure subroutine hessian_low_rank_middle (me, a, sigma) the middle matrix of the compact representation, and the sign of its term (see the module documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me real(kind=wp), intent(out), dimension(:,:) :: a the matrix dimension(r,r) real(kind=wp), intent(out) :: sigma -1 (BFGS) or +1 (SR1) private  subroutine hessian_inverse_vector_product (me, v, d) compute the matrix-free inverse-Hessian-vector product .\nFor the BFGS mode this uses the classic two-loop recursion. For the\nSR1 mode (no simple closed-form inverse exists) this uses a small\ninternal conjugate-gradient solve driven by hessian_vector_product . Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: v input vector dimension(n) real(kind=wp), intent(out), dimension(:) :: d result dimension(n) private  subroutine hessian_cg_solve (me, v, d) approximate via a small conjugate-gradient solve of , using only hessian_vector_product (matrix-free).\n Used for the SR1 mode, which has no simple closed-form inverse. Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: v right-hand side dimension(n) real(kind=wp), intent(out), dimension(:) :: d solution of dimension(n) private  subroutine hessian_reset (me) reset the Hessian approximation, discarding all stored (s,y) pairs\n(and any shift). In exact mode, increase the shift instead (see the\nmodule documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me private  subroutine hessian_set_exact (me, irow, icol) switch to the exact mode (see the module documentation), with the\nsparsity pattern irow / icol of the Hessian of the Lagrangian (each\noff-diagonal element given once, see set_hessian_sparsity ). The\nvalues are set by hessian_set_values ; until then they are zero. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me integer, intent(in), dimension(:) :: irow row indices dimension(nnz) integer, intent(in), dimension(:) :: icol column indices dimension(nnz) private  subroutine hessian_set_values (me, val, decay) set the values of the exact Hessian for a new major iteration, and, if decay , decrease the shift (divided by 3, and set to 0 once below its\nminimum). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: val the nonzero values dimension(nnz) logical, intent(in) :: decay whether to decrease the shift (after a good step)","tags":"","url":"module/sqpopt_hessian_module.html"},{"title":"sqpopt_module.F90 – sqpopt","text":"This file depends on sourcefile~~sqpopt_module.f90~~EfferentGraph sourcefile~sqpopt_module.f90 sqpopt_module.F90 sourcefile~sqpopt_diagnostics_module.f90 sqpopt_diagnostics_module.f90 sourcefile~sqpopt_module.f90->sourcefile~sqpopt_diagnostics_module.f90 sourcefile~sqpopt_hessian_module.f90 sqpopt_hessian_module.f90 sourcefile~sqpopt_module.f90->sourcefile~sqpopt_hessian_module.f90 sourcefile~sqpopt_inertia_module.f90 sqpopt_inertia_module.f90 sourcefile