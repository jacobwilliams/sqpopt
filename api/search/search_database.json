) :: n_z number of columns of z Called by proc~~dense_null_space~~CalledByGraph proc~dense_null_space dense_null_space proc~solve_dense_qp sqpopt_dense_qp_type%solve_dense_qp proc~solve_dense_qp->proc~dense_null_space proc~solve_qp_subproblem sqpopt_qp_solver_type%solve_qp_subproblem proc~solve_qp_subproblem->proc~solve_dense_qp proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~restoration_phase_step->proc~solve_qp_subproblem proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~solve_qp_subproblem proc~sqpopt_iterate->proc~restoration_phase_step proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~sqpopt_iterate->proc~trust_region_step proc~trust_region_step->proc~solve_qp_subproblem proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine dense_null_space ( a , m_a , n , z , n_z ) integer , intent ( in ) :: m_a !! number of rows of `a` (may be 0) integer , intent ( in ) :: n !! number of columns of `a` (and rows of `z`) real ( wp ), dimension (:,:), intent ( in ) :: a !! `dimension(m_a,n)` real ( wp ), dimension (:,:), allocatable , intent ( out ) :: z !! `dimension(n,n_z)`, `n_z = n-m_a` integer , intent ( out ) :: n_z !! number of columns of `z` real ( wp ), dimension (:,:), allocatable :: q real ( wp ), dimension (:,:), allocatable :: r real ( wp ), dimension (:), allocatable :: v integer :: i , j , k , kmax real ( wp ) :: alpha , vnorm , s real ( wp ), parameter :: tol = 1.0e-13_wp allocate ( q ( n , n ), r ( n , max ( m_a , 1 )), v ( n )) n_z = n - m_a allocate ( z ( n , max ( n_z , 0 ))) ! Q starts as the identity; accumulate Householder reflectors into it: q = 0.0_wp do i = 1 , n q ( i , i ) = 1.0_wp end do if ( m_a <= 0 ) then if ( n_z > 0 ) z (:, 1 : n_z ) = q (:, 1 : n_z ) return end if r (:, 1 : m_a ) = transpose ( a ( 1 : m_a , 1 : n )) kmax = min ( m_a , n ) do k = 1 , kmax vnorm = norm2 ( r ( k : n , k )) if ( vnorm < tol ) cycle !! column already (numerically) zero below the diagonal alpha = - sign ( vnorm , r ( k , k )) v ( k : n ) = r ( k : n , k ) v ( k ) = v ( k ) - alpha vnorm = norm2 ( v ( k : n )) if ( vnorm < tol ) cycle v ( k : n ) = v ( k : n ) / vnorm ! apply the reflector to R (from the left): do j = k , m_a s = 2.0_wp * dot_product ( v ( k : n ), r ( k : n , j )) r ( k : n , j ) = r ( k : n , j ) - s * v ( k : n ) end do ! accumulate the reflector into Q (apply from the right): do i = 1 , n s = 2.0_wp * dot_product ( q ( i , k : n ), v ( k : n )) q ( i , k : n ) = q ( i , k : n ) - s * v ( k : n ) end do end do if ( n_z > 0 ) z (:, 1 : n_z ) = q (:, m_a + 1 : n ) end subroutine dense_null_space","tags":"","url":"proc/dense_null_space.html"},{"title":"dense_modified_cholesky – sqpopt","text":"public  subroutine dense_modified_cholesky(a, n, l) modified Cholesky factorization of a symmetric dimension(n,n) matrix a that is not guaranteed positive definite\n(the limited-memory BFGS/SR1 Hessian restricted to a subspace has no\nsuch guarantee). Uses a simple Gill-Murray-Wright-style safeguard: any\npivot that would be non-positive is instead replaced by a small\npositive floor, so the factorization always succeeds and returns a\n(perturbed) positive-definite L . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(n,n) :: a symmetric matrix to be factorized integer, intent(in) :: n order of the matrix a real(kind=wp), intent(out), dimension(n,n) :: l lower-triangular Cholesky factor of a Called by proc~~dense_modified_cholesky~~CalledByGraph proc~dense_modified_cholesky dense_modified_cholesky proc~solve_dense_qp sqpopt_dense_qp_type%solve_dense_qp proc~solve_dense_qp->proc~dense_modified_cholesky proc~solve_qp_subproblem sqpopt_qp_solver_type%solve_qp_subproblem proc~solve_qp_subproblem->proc~solve_dense_qp proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~restoration_phase_step->proc~solve_qp_subproblem proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~solve_qp_subproblem proc~sqpopt_iterate->proc~restoration_phase_step proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~sqpopt_iterate->proc~trust_region_step proc~trust_region_step->proc~solve_qp_subproblem proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine dense_modified_cholesky ( a , n , l ) integer , intent ( in ) :: n !! order of the matrix `a` real ( wp ), dimension ( n , n ), intent ( in ) :: a !! symmetric matrix to be factorized real ( wp ), dimension ( n , n ), intent ( out ) :: l !! lower-triangular Cholesky factor of `a` integer :: i , j real ( wp ) :: piv real ( wp ), parameter :: delta = 1.0e-10_wp !! floor applied to a non-positive pivot l = 0.0_wp do j = 1 , n piv = a ( j , j ) - dot_product ( l ( j , 1 : j - 1 ), l ( j , 1 : j - 1 )) if ( piv < delta ) piv = delta l ( j , j ) = sqrt ( piv ) do i = j + 1 , n l ( i , j ) = ( a ( i , j ) - dot_product ( l ( i , 1 : j - 1 ), l ( j , 1 : j - 1 ))) / l ( j , j ) end do end do end subroutine dense_modified_cholesky","tags":"","url":"proc/dense_modified_cholesky.html"},{"title":"dense_cholesky_curvature – sqpopt","text":"public  subroutine dense_cholesky_curvature(a, n, l, ok, d) Cholesky factorization of a symmetric dimension(n,n) matrix a that may not be positive definite, without perturbing it.\nIf a is (numerically) positive definite, ok=.true. and l is its\nCholesky factor. Otherwise the factorization stops at the first column j whose pivot is not\nsufficiently positive (relative to the largest diagonal element), and\nreturns ok=.false. with a direction d of nonpositive curvature, (roughly) 0: for which equals that pivot (the Schur complement). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(n,n) :: a symmetric matrix to be factorized integer, intent(in) :: n order of the matrix a real(kind=wp), intent(out), dimension(n,n) :: l lower-triangular Cholesky factor (valid only if ok ) logical, intent(out) :: ok true if a is positive definite real(kind=wp), intent(out), dimension(n) :: d direction of nonpositive curvature (only if .not. ok ) Called by proc~~dense_cholesky_curvature~~CalledByGraph proc~dense_cholesky_curvature dense_cholesky_curvature proc~solve_dense_qp sqpopt_dense_qp_type%solve_dense_qp proc~solve_dense_qp->proc~dense_cholesky_curvature proc~solve_qp_subproblem sqpopt_qp_solver_type%solve_qp_subproblem proc~solve_qp_subproblem->proc~solve_dense_qp proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~restoration_phase_step->proc~solve_qp_subproblem proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~solve_qp_subproblem proc~sqpopt_iterate->proc~restoration_phase_step proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~sqpopt_iterate->proc~trust_region_step proc~trust_region_step->proc~solve_qp_subproblem proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine dense_cholesky_curvature ( a , n , l , ok , d ) integer , intent ( in ) :: n !! order of the matrix `a` real ( wp ), dimension ( n , n ), intent ( in ) :: a !! symmetric matrix to be factorized real ( wp ), dimension ( n , n ), intent ( out ) :: l !! lower-triangular Cholesky factor (valid only if `ok`) logical , intent ( out ) :: ok !! true if `a` is positive definite real ( wp ), dimension ( n ), intent ( out ) :: d !! direction of nonpositive curvature (only if `.not. ok`) real ( wp ), parameter :: rel_tol = 1.0e-10_wp !! pivots below `rel_tol*max|a_jj|` count as nonpositive integer :: i , j real ( wp ) :: piv , tol l = 0.0_wp d = 0.0_wp ok = . true . if ( n == 0 ) return tol = 0.0_wp do j = 1 , n tol = max ( tol , abs ( a ( j , j ))) end do tol = rel_tol * max ( tol , tiny ( 1.0_wp )) do j = 1 , n piv = a ( j , j ) - dot_product ( l ( j , 1 : j - 1 ), l ( j , 1 : j - 1 )) if ( piv <= tol ) then ! nonpositive curvature: d = [-L11&#94;{-T} l_j; 1; 0] ok = . false . d ( j ) = 1.0_wp do i = j - 1 , 1 , - 1 d ( i ) = - ( l ( j , i ) + dot_product ( l ( i + 1 : j - 1 , i ), d ( i + 1 : j - 1 ))) / l ( i , i ) end do return end if l ( j , j ) = sqrt ( piv ) do i = j + 1 , n l ( i , j ) = ( a ( i , j ) - dot_product ( l ( i , 1 : j - 1 ), l ( j , 1 : j - 1 ))) / l ( j , j ) end do end do end subroutine dense_cholesky_curvature","tags":"","url":"proc/dense_cholesky_curvature.html"},{"title":"dense_solve_cholesky – sqpopt","text":"public  subroutine dense_solve_cholesky(l, n, b, x) solve given the Cholesky factor l ( , from dense_modified_cholesky ) via forward and back substitution. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(n,n) :: l lower-triangular Cholesky factor of a integer, intent(in) :: n order of the matrix l real(kind=wp), intent(in), dimension(n) :: b right-hand side vector of the linear system Ax=b real(kind=wp), intent(out), dimension(n) :: x solution vector of the linear system Ax=b Called by proc~~dense_solve_cholesky~~CalledByGraph proc~dense_solve_cholesky dense_solve_cholesky proc~solve_dense_qp sqpopt_dense_qp_type%solve_dense_qp proc~solve_dense_qp->proc~dense_solve_cholesky proc~solve_qp_subproblem sqpopt_qp_solver_type%solve_qp_subproblem proc~solve_qp_subproblem->proc~solve_dense_qp proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~restoration_phase_step->proc~solve_qp_subproblem proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~solve_qp_subproblem proc~sqpopt_iterate->proc~restoration_phase_step proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~sqpopt_iterate->proc~trust_region_step proc~trust_region_step->proc~solve_qp_subproblem proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Pro