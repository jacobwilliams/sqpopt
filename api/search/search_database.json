dure, public :: initialize => sqpopt_initialize private  subroutine sqpopt_initialize (me, problem, options, hessian, qp_solver, linesearch, trust_region, report) initialize (or reinitialize) an sqpopt_type solver instance. Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(inout) :: me type( sqpopt_problem_type ), intent(in), optional :: problem the nonlinear program to be solved type( sqpopt_options_type ), intent(in), optional :: options solver options type( sqpopt_hessian_type ), intent(in), optional :: hessian Hessian of the Lagrangian approximation type( sqpopt_qp_solver_type ), intent(in), optional :: qp_solver QP subproblem solver type( sqpopt_linesearch_type ), intent(in), optional :: linesearch merit function / line search type( sqpopt_trust_region_type ), intent(in), optional :: trust_region trust-region globalization (opt-in\nalternative to linesearch , see sqpopt_trust_region_module ) procedure( sqpopt_report_func ), optional :: report optional user progress-reporting callback,\ncalled once per major iteration with the\ncurrent iterate; set its user_stop output\nto request the solver stop early\n(see sqpopt_types_module ) procedure, public :: solve => sqpopt_solve private  subroutine sqpopt_solve (me, x0, istat, lambda0) solve the nonlinear program starting from the initial guess x0 (and,\noptionally, initial constraint multipliers lambda0 , with the sign\nconvention of sqpopt_results_type ), running major SQP iterations\nuntil convergence or a stopping criterion is met. The outcome is\navailable from get_solution , get_results , and status_message . Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x0 initial guess for the optimization variables dimension(n) integer, intent(out) :: istat status code (see sqpopt_types_module ) real(kind=wp), intent(in), optional, dimension(:) :: lambda0 initial guess for the constraint multipliers dimension(m) procedure, public :: get_solution => sqpopt_get_solution private  subroutine sqpopt_get_solution (me, x, lambda, z) return the final solution of the last solve , the constraint\nmultipliers, and (optionally) the variable-bound multipliers (for the\noriginal problem; see sqpopt_results_type for the sign convention). Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(in) :: me real(kind=wp), intent(out), dimension(:) :: x optimization variables dimension(n) real(kind=wp), intent(out), dimension(:) :: lambda constraint multipliers dimension(m) real(kind=wp), intent(out), optional, dimension(:) :: z variable-bound multipliers dimension(n) procedure, public :: get_results => sqpopt_get_results private  subroutine sqpopt_get_results (me, results) return the full results of the last solve (status, counts, final\npoint, multipliers, and errors; see sqpopt_results_type ). Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(in) :: me type( sqpopt_results_type ), intent(out) :: results the results of the last solve procedure, public :: status_message => sqpopt_get_status_message private  function sqpopt_get_status_message (me) result(msg) a description of the status of the last solve (including, for sqpopt_invalid_input , what was invalid). Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(in) :: me Return Value character(len=:), allocatable procedure, public :: destroy => sqpopt_destroy private  subroutine sqpopt_destroy (me) destroy the solver instance, deallocating all internal arrays. Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(inout) :: me Source Code type , public :: sqpopt_type !! main class for the SQP optimizer. private type ( sqpopt_problem_type ) :: problem !! the nonlinear program to be solved (working copy) type ( sqpopt_options_type ) :: options !! solver options type ( sqpopt_hessian_type ) :: hessian !! Hessian of the Lagrangian approximation type ( sqpopt_qp_solver_type ) :: qp_solver !! QP subproblem solver type ( sqpopt_linesearch_type ) :: linesearch !! merit function / line search type ( sqpopt_trust_region_type ) :: trust_region !! trust-region globalization (opt-in alternative to `linesearch`) type ( sqpopt_restoration_type ) :: restoration !! feasibility restoration phase state (reset on each `solve`) ! the components as given to `initialize`, restored at the start of every ! `solve`, so that no state (scaling, caches, penalty, filter, watchdog, ! trust-region radius, QP warm start) carries over from a previous solve: type ( sqpopt_problem_type ) :: problem0 type ( sqpopt_linesearch_type ) :: linesearch0 type ( sqpopt_trust_region_type ) :: trust_region0 type ( sqpopt_qp_solver_type ) :: qp_solver0 real ( wp ), dimension (:), allocatable :: x !! current/final optimization variables real ( wp ), dimension (:), allocatable :: lambda !! current/final Lagrange multipliers (of the scaled problem) procedure ( sqpopt_report_func ), pointer , nopass :: report => null () !! optional user progress-reporting !! callback, invoked once per major !! iteration (see [[sqpopt_types_module]]) type ( sqpopt_results_type ) :: results !! the outcome of the last `solve` contains private procedure , public :: initialize => sqpopt_initialize procedure , public :: solve => sqpopt_solve procedure , public :: get_solution => sqpopt_get_solution procedure , public :: get_results => sqpopt_get_results procedure , public :: status_message => sqpopt_get_status_message procedure , public :: destroy => sqpopt_destroy end type sqpopt_type","tags":"","url":"type/sqpopt_type.html"},{"title":"sqpopt_sparse_matrix – sqpopt ","text":"type, public :: sqpopt_sparse_matrix a sparse matrix stored in coordinate (COO) format Components Type Visibility Attributes Name Initial integer, public :: nrows = 0 number of rows integer, public :: ncols = 0 number of columns integer, public :: nnz = 0 number of nonzero elements integer, public, dimension(:), allocatab