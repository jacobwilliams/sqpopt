ddle_matrix ( me ) if (. not . me % mid_ok ) return r = merge ( me % n_history , 2 * me % n_history , me % use_sr1 ) end function hessian_low_rank_size","tags":"","url":"proc/hessian_low_rank_size.html"},{"title":"hessian_size – sqpopt","text":"private pure function hessian_size(me) result(h) the size of the Hessian, which the shift is relative to: for the exact Hessian, and for a quasi-Newton one. Type Bound sqpopt_hessian_type Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me Return Value real(kind=wp) Called by proc~~hessian_size~~CalledByGraph proc~hessian_size sqpopt_hessian_type%hessian_size proc~direct_qp_step direct_qp_step proc~direct_qp_step->proc~hessian_size proc~inertia_correct sqpopt_inertia_type%inertia_correct proc~direct_qp_step->proc~inertia_correct proc~hessian_reset sqpopt_hessian_type%hessian_reset proc~hessian_reset->proc~hessian_size proc~hessian_set_values sqpopt_hessian_type%hessian_set_values proc~hessian_set_values->proc~hessian_size proc~inertia_correct->proc~hessian_size proc~inertia_raise sqpopt_inertia_type%inertia_raise proc~inertia_correct->proc~inertia_raise proc~inertia_raise->proc~hessian_size proc~solve_qp_subproblem sqpopt_qp_solver_type%solve_qp_subproblem proc~solve_qp_subproblem->proc~direct_qp_step proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~hessian_reset proc~sqpopt_iterate->proc~hessian_set_values proc~sqpopt_iterate->proc~inertia_correct proc~sqpopt_iterate->proc~inertia_raise proc~sqpopt_iterate->proc~solve_qp_subproblem proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~sqpopt_iterate->proc~restoration_phase_step proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~sqpopt_iterate->proc~trust_region_step proc~restoration_phase_step->proc~solve_qp_subproblem proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~trust_region_step->proc~solve_qp_subproblem proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure function hessian_size ( me ) result ( h ) class ( sqpopt_hessian_type ), intent ( in ) :: me real ( wp ) :: h h = 1.0_wp if ( me % exact ) then if ( size ( me % h_val ) > 0 ) h = max ( 1.0_wp , maxval ( abs ( me % h_val ))) else h = max ( 1.0_wp , 1.0_wp / me % gamma ) end if end function hessian_size","tags":"","url":"proc/hessian_size.html"},{"title":"hessian_initialize – sqpopt","text":"private  subroutine hessian_initialize(me, n, max_history, use_sr1, scale0) initialize the limited-memory Hessian approximation (equivalent to , with no (s,y) pairs stored). Type Bound sqpopt_hessian_type Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me integer, intent(in) :: n problem size integer, intent(in) :: max_history number of (s,y) pairs to retain logical, intent(in), optional :: use_sr1 if true, use SR1 instead of BFGS (default .false. ) real(kind=wp), intent(in), optional :: scale0 initial Hessian approximation scale0 (default 1) Called by proc~~hessian_initialize~~CalledByGraph proc~hessian_initialize sqpopt_hessian_type%hessian_initialize proc~restoration_phase_enter sqpopt_restoration_type%restoration_phase_enter proc~restoration_phase_enter->proc~hessian_initialize proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~hessian_initialize proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve proc~sqpopt_iterate->proc~restoration_phase_enter Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine hessian_initialize ( me , n , max_history , use_sr1 , scale0 ) class ( sqpopt_hessian_type ), intent ( inout ) :: me integer , intent ( in ) :: n !! problem size integer , intent ( in ) :: max_history !! number of `(s,y)` pairs to retain logical , intent ( in ), optional :: use_sr1 !! if true, use SR1 instead of BFGS (default `.false.`) real ( wp ), intent ( in ), optional :: scale0 !! initial Hessian approximation  B_0 =  `scale0`  I  (default 1) me % n = n me % max_history = max_history me % n_history = 0 me % first = 1 me % gamma0 = 1.0_wp if ( present ( scale0 )) me % gamma0 = 1.0_wp / scale0 me % gamma = me % gamma0 me % mid_valid = . false . me % use_sr1 = . false . if ( present ( use_sr1 )) me % use_sr1 = use_sr1 me % exact = . false . me % shift = 0.0_wp me % shift_dominant = . false . if ( allocated ( me % s )) deallocate ( me % s ) if ( allocated ( me % y )) deallocate ( me % y ) if ( allocated ( me % rho )) deallocate ( me % rho ) if ( allocated ( me % ss )) deallocate ( me % ss ) if ( allocated ( me % sy )) deallocate ( me % sy ) allocate ( me % s ( n , max_history ), me % y ( n , max_history )) allocate ( me % rho ( max_history ), me % ss ( max_history , max_history ), me % sy ( max_history , max_history )) me % diag_valid = . false . end subroutine hessian_initialize","tags":"","url":"proc/hessian_initialize.html"},{"title":"hessian_update_bfgs – sqpopt","text":"private  subroutine hessian_update_bfgs(me, s, y) update the limited-memory Hessian approximation using the BFGS\nupdate formula, given the step and the change\nin the Lagrangian gradient . The Hessian of the Lagrangian need not be positive definite, so can be small or negative. If damping is on (the\ndefault), Powell's damping (as in slsqp and Nocedal & Wright, Proc.\n18.2) is applied: when , y is replaced by with , so that and the update keeps B positive\ndefinite while still using the new curvature information. Otherwise,\nor if damping is off, the update is skipped when is not\nsufficiently positive. The oldest pair is discarded once max_history pairs are stored. Type Bound sqpopt_hessian_type Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: s step vector dimension(n) real(kind=wp), intent(in), dimension(:) :: y Lagrangian gradient change dimension(n) Calls proc~~hessian_update_bfgs~~CallsGraph proc~hessian_update_bfgs sqpopt_hessian_type%hessian_update_bfgs proc~hessian_push_pair hessian_push_pair proc~hessian_update_bfgs->proc~hessian_push_pair proc~hessian_vector_product sqpopt_hessian_type%hessian_vector_product proc~hessian_update_bfgs->proc~hessian_vector_product proc~pair_col pair_col proc~hessian_update_bfgs->proc~pair_col proc~hessian_push_pair->proc~pair_col proc~hessian_vector_product->proc~pair_col proc~dense_lu_solve dense_lu_solve proc~hessian_vector_product->proc~dense_lu_solve proc~factor_middle_matrix factor_middle_matrix proc~hessian_vector_product->proc~factor_middle_matrix proc~dense_lu_factor dense_lu_factor proc~factor_middle_matrix->proc~dense_lu_factor proc~middle_matrix middle_matrix proc~factor_middle_matrix->proc~middle_matrix proc~middle_matrix->proc~pair_col Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~hessian_update_bfgs~~CalledByGraph proc~hessian_update_bfgs sqpopt_hessian_type%hessian_update_bfgs proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~hessian_update_bfgs proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine hessian_update_bfgs ( me , s , y ) class ( sqpopt_hessian_type ), intent ( inout ) :: me real ( wp ), dimension (:), intent ( in ) :: s !! step vector `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: y !! Lagrangian gradient change `dimension(n)` real ( wp ), dimension (:), allocatable :: y_used , bs real ( wp ) :: sty , yty , sbs , theta if ( me % exact ) return ! a near-zero step carries no reliable curvature information and risks ! an ill-conditioned (huge `rho`) update, so skip it outright: if ( norm2 ( s ) <= 1.0e-10_wp ) return allocate ( y_used ( size ( s )), bs ( size ( s ))) y_used = y sty = dot_product ( s , y ) if ( me % damping ) then ! Powell's damping: blend `y` with `B*s` so that `s&#94;T y = 0.2 s&#94;T B s` ! whenever the curvature condition is (nearly) violated: call hessian_vector_product ( me , s , bs ) sbs = dot_product ( s , bs ) if ( sbs > 0.0_wp . and . sty < 0.2_wp * sbs ) then theta = 0.8_wp * sbs / ( sbs - sty ) y_used = theta * y + ( 1.0_wp - theta ) * bs sty = dot_product ( s , y_used ) end if end if ! skip the update if the curvature condition is not sufficiently satisfied: if ( sty <= 1.0e-10_wp * max ( norm2 ( s ) * norm2 ( y_used ), 1.0_wp )) return call hessian_push_pair ( me , s , y_used ) me % rho ( pair_col ( me , me % n_history )) = 1.0_wp / sty yty = dot_product ( y_used , y_used ) if ( yty > 0.0_wp ) me % gamma = sty / yty end subroutine hessian_update_bfgs","tags":"","url":"proc/hessian_update_bfgs.html"},{"title":"hessian_update_sr1 – sqpopt","text":"private  subroutine hessian_update_sr1(me, s, y) update the limited-memory Hessian approximation using the symmetric\nrank-1 (SR1) update formula. The update is skipped if the standard\nSR1 safeguard is not satisfied. The oldest pair is discarded once max_history pairs are stored. Type Bound sqpopt_hessian_type Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: s step vector dimension(n) real(kind=wp), intent(in), dimension(:) :: y Lagrangian gradient change dimension(n) Calls proc~~hessian_update_sr1~~CallsGraph proc~hessian_update_sr1 sqpopt_hessian_type%hessian_update_sr1 proc~hessian_push_pair hessian_push_pair proc~hessian_update_sr1->proc~hessian_push_pair proc~hessian_vector_product sqpopt_hessian_type%hessian_vector_product proc~hessian_update_sr1->proc~hessian_vector_product proc~pair_col pair_col proc~hessian_push_pair->proc~pair_col proc~dense_lu_solve dense_lu_solve proc~hessian_vector_product->proc~dens