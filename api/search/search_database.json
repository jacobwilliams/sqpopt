f true, use the limited-memory SR1 update instead of BFGS logical, public :: damping = .true. if true, use Powell's damped BFGS update (see hessian_update_bfgs ),\nelse skip any update that fails the curvature condition integer, public :: first = 1 column of s / y holding the oldest pair (the buffer is circular:\nthe i -th oldest pair is in column pair_col (i) ) real(kind=wp), public, dimension(:,:), allocatable :: s stored step vectors dimension(n,max_history) real(kind=wp), public, dimension(:,:), allocatable :: y stored Lagrangian gradient-change vectors dimension(n,max_history) real(kind=wp), public, dimension(:), allocatable :: rho 1/(y&#94;T s) for each stored pair dimension(max_history) (BFGS) real(kind=wp), public, dimension(:,:), allocatable :: ss ss(a,b) for the pairs in columns a , b dimension(max_history,max_history) real(kind=wp), public, dimension(:,:), allocatable :: sy sy(a,b) for the pairs in columns a , b dimension(max_history,max_history) real(kind=wp), public :: gamma = 1.0_wp scaling of the initial Hessian real(kind=wp), public :: gamma0 = 1.0_wp gamma before any update (and after a hessian_reset ) logical, public :: exact = .false. if true, use the user's sparse Hessian (see hessian_set_exact ) real(kind=wp), public :: shift_min = 1.0e-4_wp smallest nonzero shift, relative to real(kind=wp), public :: shift_max = 1.0e10_wp largest shift, relative to the same real(kind=wp), public :: shift = 0.0_wp the current shift (added to the diagonal in every mode; in the\nquasi-Newton modes it is zero unless the inertia control sets it) logical, public :: shift_dominant = .false. whether the shift's term of the last step was at least\nas large as the gradient: the QP's multipliers are then mostly an\nartifact of the shift (internal state, set and used by sqpopt_iterate , which then re-estimates them) integer, public, dimension(:), allocatable :: h_irow sparsity pattern: row indices integer, public, dimension(:), allocatable :: h_icol sparsity pattern: column indices real(kind=wp), public, dimension(:), allocatable :: h_val current nonzero values logical, public :: mid_valid = .false. whether mid_lu / mid_piv match the current pairs and gamma logical, public :: mid_ok = .false. whether the middle matrix is nonsingular real(kind=wp), public, dimension(:,:), allocatable :: mid_lu LU factors of the middle matrix integer, public, dimension(:), allocatable :: mid_piv row pivots of the LU factorization logical, public :: diag_valid = .false. whether diag matches the current factorization real(kind=wp), public, dimension(:), allocatable :: diag the diagonal of the approximation (see hessian_diagonal ) Type-Bound Procedures procedure, public :: initialize => hessian_initialize private  subroutine hessian_initialize (me, n, max_history, use_sr1, scale0) initialize the limited-memory Hessian approximation (equivalent to , with no (s,y) pairs stored). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me integer, intent(in) :: n problem size integer, intent(in) :: max_history number of (s,y) pairs to retain logical, intent(in), optional :: use_sr1 if true, use SR1 instead of BFGS (default .false. ) real(kind=wp), intent(in), optional :: scale0 initial Hessian approximation scale0 (default 1) procedure, public :: update_bfgs => hessian_update_bfgs private  subroutine hessian_update_bfgs (me, s, y) update the limited-memory Hessian approximation using the BFGS\nupdate formula, given the step and the change\nin the Lagrangian gradient . Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: s step vector dimension(n) real(kind=wp), intent(in), dimension(:) :: y Lagrangian gradient change dimension(n) procedure, public :: update_sr1 => hessian_update_sr1 private  subroutine hessian_update_sr1 (me, s, y) update the limited-memory Hessian approximation using the symmetric\nrank-1 (SR1) update formula. The update is skipped if the standard\nSR1 safeguard is not satisfied. The oldest pair is discarded once max_history pairs are stored. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: s step vector dimension(n) real(kind=wp), intent(in), dimension(:) :: y Lagrangian gradient change dimension(n) procedure, public :: hv_product => hessian_vector_product private  subroutine hessian_vector_product (me, v, hv) compute the matrix-free Hessian-vector product , used\nby the QP subproblem solver in place of an explicit dense matrix.\nUses the compact representation of either the BFGS or the SR1\nmatrix (Byrd, Nocedal & Schnabel, 1994), depending on use_sr1 , with\nits small middle matrix factored once (see factor_middle_matrix )\nand reused until the pairs or gamma change. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: v input vector dimension(n) real(kind=wp), intent(out), dimension(:) :: hv result dimension(n) procedure, public :: diagonal => hessian_diagonal private  subroutine hessian_diagonal (me, d) the diagonal of the Hessian approximation , from its compact\nrepresentation (at a cost of for k pairs, without\nforming ): , with the i -th row of (BFGS, minus)\nor of (SR1, plus), i.e. the row sums of . Used as a (Jacobi) preconditioner. The\nresult is kept until the pairs or the scaling change. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(out), dimension(:) :: d the diagonal dimension(n) procedure, public :: dense => hessian_dense private  subroutine hessian_dense (me, h) the Hessian approximation as a dense matrix, in the caller's\narray (for the dense QP solver, the only place a dense matrix is used). Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(out), dimension(:,:) :: h the matrix dimension(n,n) (symmetric, both triangles set) procedure, public :: inverse_vector_product => hessian_inverse_vector_product private  subroutine hessian_inverse_vector_product (me, v, d) compute the matrix-free inverse-Hessian-vector product .\nFor the BFGS mode this uses the classic two-loop recursion. For the\nSR1 mode (no simple closed-form inverse exists) this uses a small\ninternal conjugate-gradient solve driven by hessian_vector_product . Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: v input vector dimension(n) real(kind=wp), intent(out), dimension(:) :: d result dimension(n) procedure, public :: reset => hessian_reset private  subroutine hessian_reset (me) reset the Hessian approximation, discarding all stored (s,y) pairs\n(and any shift). In exact mode, increase the shift instead (see the\nmodule documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me procedure, public :: set_exact => hessian_set_exact private  subroutine hessian_set_exact (me, irow, icol) switch to the exact mode (see the module documentation), with the\nsparsity pattern irow / icol of the Hessian of the Lagrangian (each\noff-diagonal element given once, see set_hessian_sparsity ). The\nvalues are set by hessian_set_values ; until then they are zero. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me integer, intent(in), dimension(:) :: irow row indices dimension(nnz) integer, intent(in), dimension(:) :: icol column indices dimension(nnz) procedure, public :: set_values => hessian_set_values private  subroutine hessian_set_values (me, val, decay) set the values of the exact Hessian for a new major iteration, and, if decay , decrease the shift (divided by 3, and set to 0 once below its\nminimum). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: val the nonzero values dimension(nnz) logical, intent(in) :: decay whether to decrease the shift (after a good step) procedure, public :: magnitude => hessian_size private pure function hessian_size (me) result(h) the size of the Hessian, which the shift is relative to: for the exact Hessian, and for a quasi-Newton one. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me Return Value real(kind=wp) procedure, public :: low_rank_size => hessian_low_rank_size private  function hessian_low_rank_size (me) result(r) the rank r of the low-rank part of the compact representation (see the\nmodule documentation): 2k (BFGS) or k (SR1) for k stored pairs. It\nis 0 when the matrix is just (no pairs yet, or a\nsingular middle matrix, where hessian_vector_product falls back on\nthat too), and in exact mode. Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(inout) :: me Return Value integer procedure, public :: low_rank_multiply => hessian_low_rank_multiply private pure subroutine hessian_low_rank_multiply (me, w, v) the product with the low-rank factor of the compact\nrepresentation (see the module documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: w the coefficients dimension(r) real(kind=wp), intent(out), dimension(:) :: v the product dimension(n) procedure, public :: low_rank_column => hessian_low_rank_column private pure subroutine hessian_low_rank_column (me, j, u) column j of the low-rank factor of the compact representation\n(see the module documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me integer, intent(in) :: j the column ( 1..r ) real(kind=wp), intent(out), dimension(:) :: u the column dimension(n) procedure, public :: low_rank_multiply_transpose => hessian_low_rank_multiply_transpose private pure subroutine hessian_low_rank_multiply_transpose (me, v, w) the product with the low-rank factor of the compact\nrepresentation (see the module documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: v the vector dimension(n) real(kind=wp), intent(out), dimension(:) :: w the product dimension(r) procedure, public :: low_rank_middle => hessian_low_rank_middle private pure subroutine hessian_low_rank_middle (me, a, sigma) the middle matrix of the compact representation, and the sign of its term (see the module documentation). Arguments Type Intent Optional Attributes Name class( sqpopt_hessian_type ), intent(in) :: me real(kind=wp), intent(out), dimension(:,:) :: a the matrix dimension(r,r) real(kind=wp), intent(out) :: sigma -1 (BFGS) or +1 (SR1) Source Code type , public :: sqpopt_hessian_type !! stores and updates a limited-memory approximation to the !! Hessian of the Lagrangian (never stores a dense `n x n` matrix: !! [[hessian_dense]] writes one into the dense QP solver's array). integer :: n = 0 !! problem size integer :: max_history = 0 !! number of `(s,y)` pairs retained (independent of `n`) integer :: n_history = 0 !! number of pairs currently stored (`<= max_history`) logical :: use_sr1 = . false . !! if true, use the limited-memory SR1 update instead of BFGS logical :: damping = . true . !! if true, use Powell's damped BFGS update (see [[hessian_update_bfgs]]), !! else skip any update that fails the curvature condition integer :: first = 1 !! column of `s`/`y` holding the oldest pair (the buffer is circular: !! the `i`-th oldest pair is in column [[pair_col]]`(i)`) real ( wp ), dimension (:,:), allocatable :: s !! stored step vectors `dimension(n,max_history)` real ( wp ), dimension (:,:), allocatable :: y !! stored Lagrangian gradient-change vectors `dimension(n,max_history)` real ( wp ), dimension (:), allocatable :: rho !! `1/(y&#94;T s)` for each stored pair `dimension(max_history)` (BFGS) real ( wp ), dimension (:,:), allocatable :: ss !! `ss(a,b)`  = s_a&#94;Ts_b  for the pairs in columns `a`, `b` !! `dimension(max_history,max_history)` real ( wp ), dimension (:,:), allocatable :: sy !! `sy(a,b)`  = s_a&#94;Ty_b  for the pairs in columns `a`, `b` !! `dimension(max_history,max_history)` real ( wp ) :: gamma = 1.0_wp !! scaling of the initial Hessian  H_0 = \\gamma I  real ( wp ) :: gamma0 = 1.0_wp !! `gamma` before any update (and after a [[hessian_reset]]) ! exact mode (see the module documentation): logical :: exact = . false . !! if true, use the user's sparse Hessian (see [[hessian_set_exact]]) real ( wp ) :: shift_min = 1.0e-4_wp !! smallest nonzero shift, relative to  \\max(1,\\max|H_{ij}|)  real ( wp ) :: shift_max = 1.0e10_wp !! largest shift, relative to the same real ( wp ) :: shift = 0.0_wp !! the current shift  \\delta  (added to the diagonal in every mode; in the !! quasi-Newton modes it is zero unless the inertia control sets it) logical :: shift_dominant = . false . !! whether the shift's term  \\delta p  of the last step was at least !! as large as the gradient: the QP's multipliers are then mostly an !! artifact of the shift (internal state, set and used by !! [[sqpopt_iterate]], which then re-estimates them) integer , dimension (:), allocatable :: h_irow !! sparsity pattern: row indices integer , dimension (:), allocatable :: h_icol !! sparsity pattern: column indices real ( wp ), dimension (:), allocatable :: h_val !! current nonzero values ! cached LU factorization of the compact representation's middle matrix ! (internal; rebuilt by [[hessian_vector_product]] when `mid_valid` is false): logical :: mid_valid = . false . !! whether `mid_lu`/`mid_piv` match the current pairs and `gamma` logical :: mid_ok = . false . !! whether the middle matrix is nonsingular real ( wp ), dimension (:,:), allocatable :: mid_lu !! LU factors of the middle matrix integer , dimension (:), allocatable :: mid_piv !! row pivots of the LU factorization logical :: diag_valid = . false . !! whether `diag` matches the current factorization real ( wp ), dimension (:), allocatable :: diag !! the diagonal of the approximation (see [[hessian_diagonal]]) contains procedure , public :: initialize => hessian_initialize procedure , public :: update_bfgs => hessian_update_bfgs procedure , public :: update_sr1 => hessian_update_sr1 procedure , public :: hv_product => hessian_vector_product procedure , public :: diagonal => hessian_diagonal procedure , public :: dense => hessian_dense procedure , public :: inverse_vector_product => hessian_inverse_vector_product procedure , public :: reset => hessian_reset procedure , public :: set_exact => hessian_set_exact procedure , public :: set_values => hessian_set_values procedure , public :: magnitude => hessian_size procedure , public :: low_rank_size => hessian_low_rank_size procedure , public :: low_rank_multiply => hessian_low_rank_multiply procedure , public :: low_rank_column => hessian_low_rank_column procedure , public :: low_rank_multiply_transpose => hessian_low_rank_multiply_transpose procedure , public :: low_rank_middle => hessian_low_rank_middle end type sqpopt_hessian_type","tags":"","url":"type/sqpopt_hessian_type.html"},{"title":"sqpopt_report_func – sqpopt","text":"interface public  subroutine sqpopt_report_func(iter, x, f, c, lambda, user_stop, data) Arguments Type Intent Optional Attributes Name integer, intent(in) :: iter major iteration number (starts at 1) real(kind=wp), intent(in), dimension(:) :: x current optimization variables dimension(n) real(kind=wp), intent(in) :: f current objective function value real(kind=wp), intent(in), dimension(:) :: c current constraint values dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda current Lagrange multiplier estimate dimension(m) logical, intent(out) :: user_stop set .true. to request the solver stop class(*), intent(inout), optional :: data the user data given to set_functions Description user-supplied callback invoked once per major SQP iteration\nfor progress monitoring (see sqpopt_type%initialize 's report argument). Set user_stop=.true. to have the\nsolver stop after the current iteration\n( istat=sqpopt_user_requested_stop ). The values are for the\noriginal (unscaled) problem.","tags":"","url":"interface/sqpopt_report_func.html"},{"title":"start_interface – sqpopt","text":"interface private  subroutine start_interface(me, n, irow, icol, ok, threads, signs) Arguments Type Intent Optional Attributes Name class( sqpopt_sparse_ldl_type ), intent(inout) :: me integer, intent(in) :: n order of the matrix integer, intent(in), dimension(:) :: irow row indices of the entries dimension(nnz) integer, intent(in), dimension(:) :: icol column indices of the entries dimension(nnz) logical, intent(out) :: ok whether the backend is ready integer, intent(in), optional :: threads number of OpenMP threads, if the backend uses them integer, intent(in), optional, dimension(:) :: signs the expected sign of each row's pivot ( -1 , 0 , or +1 ), if the backend uses it dimension(n) Description start the backend for symmetric matrices of order n with the\nsparsity pattern irow / icol (each entry stands for itself and,\noff the diagonal, its mirror image; entries given more than once\nare added together). ok is false if it couldn't be started.","tags":"","url":"interface/start_interface.html"},{"title":"refactor_interface – sqpopt","text":"interface private  subroutine refactor_interface(me, val, ok) Arguments Type Intent Optional Attributes Name class( sqpopt_sparse_ldl_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: val values of the entries dimension(nnz) logical, intent(out) :: ok whether the factorization succeeded Description factor the matrix with the values val (in the order of the\npattern), and set n_negative , n_null , and inertia_known","tags":"","url":"interface/refactor_interface.html"},{"title":"back_solve_interface – sqpopt","text":"interface private  subroutine back_solve_interface(me, v, ok) Arguments Type Intent Optional Attributes Name class( sqpopt_sparse_ldl_type ), intent(inout) :: me real(kind=wp), intent(inout), dimension(:) :: v the right-hand side, overwritten by the solution logical, intent(out) :: ok whether it was solved Description one solve with the factors, without refinement: v is overwritten\nby (if not ok , v is unchanged)","tags":"","url":"interface/back_solve_interface.html"},{"title":"multiply_interface – sqpopt","text":"interface private  subroutine multiply_interface(me, x, y) Arguments Type Intent Optional Attributes Name class( sqpopt_sparse_ldl_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: x the vector dimension(n) real(kind=wp), intent(out), dimension(:) :: y the product dimension(n) Description the product with the values last factored","tags":"","url":"interface/multiply_interface.html"},{"title":"free_interface – sqpopt","text":"interface private  subroutine free_interface(me) Arguments Type Intent Optional Attributes Name class( sqpopt_sparse_ldl_type ), intent(inout) :: me Description free everything the backend holds","tags":"","url":"interface/free_interface.html"},{"title":"sqpopt_ls_objective_func – sqpopt","text":"interface private  subroutine sqpopt_ls_objective_func(x, f) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent(out) :: f objective at x Description evaluates the (scaled) objective at x (NaN if it can't be evaluated)","tags":"","url":"interface/sqpopt_ls_objective_func.html"},{"title":"sqpopt_ls_constraint_func – sqpopt","text":"interface private  subroutine sqpopt_ls_constraint_func(x, c) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent(out), dimension(:) :: c constraints at x dimension(m) Description evaluates the (scaled) constraints at x (NaN if they can't be evaluated)","tags":"","url":"interface/sqpopt_ls_constraint_func.html"},{"title":"sqpopt_soc_func – sqpopt","text":"interface public  subroutine sqpopt_soc_func(p, c_trial, p_soc, ok) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: p the rejected trial step dimension(n) real(kind=wp), intent(in), dimension(:) :: c_trial constraint values at x+p dimension(m) real(kind=wp), intent(out), dimension(:) :: p_soc the corrected step dimension(n) logical, intent(out) :: ok true if p_soc is usable Description computes the second-order-corrected version p_soc of a\nrejected trial step p , given the constraint values c_trial at x+p (see sqpopt_soc_module ); ok is false\nif no usable correction is available","tags":"","url":"interface/sqpopt_soc_func.html"},{"title":"sqpopt_fc_func – sqpopt","text":"interface public  subroutine sqpopt_fc_func(x, f, c, status, data) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x optimization variable vector dimension(n) real(kind=wp), intent(out) :: f value of the objective function real(kind=wp), intent(out), dimension(:) :: c constraint vector dimension(m) ( m may be 0) integer, intent(inout) :: status 0 on entry; >0 : can't evaluate here, <0 : stop class(*), intent(inout), optional :: data user data (see set_functions ) Description evaluates the objective function and the nonlinear\nconstraint vector","tags":"","url":"interface/sqpopt_fc_func.html"},{"title":"sqpopt_gjac_func – sqpopt","text":"interface public  subroutine sqpopt_gjac_func(x, g, jac_val, accuracy, status, data) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x optimization variable vector dimension(n) real(kind=wp), intent(out), dimension(:) :: g gradient vector dimension(n) real(kind=wp), intent(out), dimension(:) :: jac_val nonzero Jacobian values dimension(jac_nnz) (may be 0) integer, intent(in) :: accuracy sqpopt_derivatives_fast or sqpopt_derivatives_accurate integer, intent(inout) :: status 0 on entry; >0 : can't evaluate here, <0 : stop class(*), intent(inout), optional :: data user data (see set_functions ) Description evaluates the gradient of the objective function and the nonzero values of the Jacobian of the constraint vector, , ordered to match the\nsparsity pattern set by set_jacobian_sparsity . accuracy says\nhow accurate they need to be: functions with a cheaper, less\naccurate way of computing them (e.g. forward instead of central\ndifferences) may use it while accuracy=sqpopt_derivatives_fast ;\nothers can ignore it.","tags":"","url":"interface/sqpopt_gjac_func.html"},{"title":"sqpopt_hessian_func – sqpopt","text":"interface public  subroutine sqpopt_hessian_func(x, lambda, hess_val, status, data) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x optimization variable vector dimension(n) real(kind=wp), intent(in), dimension(:) :: lambda Lagrange multipliers dimension(m) real(kind=wp), intent(out), dimension(:) :: hess_val nonzero Hessian values dimension(hess_nnz) integer, intent(inout) :: status 0 on entry; >0 : can't evaluate here, <0 : stop class(*), intent(inout), optional :: data user data (see set_functions ) Description evaluates the nonzero values of the Hessian of the Lagrangian: ,\nordered to match the sparsity pattern set by set_hessian_sparsity .","tags":"","url":"interface/sqpopt_hessian_func.html"},{"title":"sqpopt_residual_func – sqpopt","text":"interface public  subroutine sqpopt_residual_func(x, r, c, status, data) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x variables dimension(n) real(kind=wp), intent(out), dimension(:) :: r residuals dimension(l) real(kind=wp), intent(out), dimension(:) :: c constraints dimension(m) ( m may be 0) integer, intent(inout) :: status 0 on entry; >0 : can't evaluate here, <0 : stop class(*), intent(inout), optional :: data user data (see sqpopt_nlls_type%initialize ) Description evaluates the residuals and the constraints","tags":"","url":"interface/sqpopt_residual_func.html"},{"title":"sqpopt_residual_jac_func – sqpopt","text":"interface public  subroutine sqpopt_residual_jac_func(x, rjac_val, cjac_val, accuracy, status, data) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in), dimension(:) :: x variables dimension(n) real(kind=wp), intent(out), dimension(:) :: rjac_val nonzeros of the residuals' Jacobian real(kind=wp), intent(out), dimension(:) :: cjac_val nonzeros of the constraints' Jacobian (may be none) integer, intent(in) :: accuracy sqpopt_derivatives_fast or sqpopt_derivatives_accurate integer, intent(inout) :: status 0 on entry; >0 : can't evaluate here, <0 : stop class(*), intent(inout), optional :: data user data (see sqpopt_nlls_type%initialize ) Description evaluates the nonzero values of the Jacobians of the residuals\nand of the constraints, each in the order of its sparsity pattern","tags":"","url":"interface/sqpopt_residual_jac_func.html"},{"title":"sqpopt_get_status_message – sqpopt","text":"private  function sqpopt_get_status_message(me) result(msg) a description of the status of the last solve (including, for sqpopt_invalid_input , what was invalid). Type Bound sqpopt_type Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(in) :: me Return Value character(len=:), allocatable Called by proc~~sqpopt_get_status_message~~CalledByGraph proc~sqpopt_get_status_message sqpopt_type%sqpopt_get_status_message proc~nlls_status_message sqpopt_nlls_type%nlls_status_message proc~nlls_status_message->proc~sqpopt_get_status_message Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function sqpopt_get_status_message ( me ) result ( msg ) class ( sqpopt_type ), intent ( in ) :: me character ( len = :), allocatable :: msg if ( allocated ( me % results % message )) then msg = me % results % message else msg = '' end if end function sqpopt_get_status_message","tags":"","url":"proc/sqpopt_get_status_message.html"},{"title":"lbfgs_memory – sqpopt","text":"private pure function lbfgs_memory(memory, n, direct) the number of (s,y) pairs the limited-memory Hessian keeps, for the\noption value memory (see sqpopt_options_type%lbfgs_memory ) and n variables: memory itself, or, if it is 0 (automatic), , or 10 with the direct QP method ( direct ),\nwhose cost grows with the square of the number of pairs. Arguments Type Intent Optional Attributes Name integer, intent(in) :: memory the option value integer, intent(in) :: n number of variables logical, intent(in) :: direct whether the direct QP method is in use ( options%direct_qp ) Return Value integer Called by proc~~lbfgs_memory~~CalledByGraph proc~lbfgs_memory lbfgs_memory proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~lbfgs_memory proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure integer function lbfgs_memory ( memory , n , direct ) integer , intent ( in ) :: memory !! the option value integer , intent ( in ) :: n !! number of variables logical , intent ( in ) :: direct !! whether the direct QP method is in use (`options%direct_qp`) integer , parameter :: direct_memory = 10 !! the automatic memory with the direct QP method if ( memory > 0 ) then lbfgs_memory = memory else if ( direct ) then lbfgs_memory = direct_memory else lbfgs_memory = max ( 10 , min ( n , 100 )) end if end function lbfgs_memory","tags":"","url":"proc/lbfgs_memory.html"},{"title":"sqpopt_initialize – sqpopt","text":"private  subroutine sqpopt_initialize(me, problem, options, hessian, qp_solver, linesearch, trust_region, report) initialize (or reinitialize) an sqpopt_type solver instance. Type Bound sqpopt_type Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(inout) :: me type( sqpopt_problem_type ), intent(in), optional :: problem the nonlinear program to be solved type( sqpopt_options_type ), intent(in), optional :: options solver options type( sqpopt_hessian_type ), intent(in), optional :: hessian Hessian of the Lagrangian approximation type( sqpopt_qp_solver_type ), intent(in), optional :: qp_solver QP subproblem solver type( sqpopt_linesearch_type ), intent(in), optional :: linesearch merit function / line search type( sqpopt_trust_region_type ), intent(in), optional :: trust_region trust-region globalization (opt-in\nalternative to linesearch , see sqpopt_trust_region_module ) procedure( sqpopt_report_func ), optional :: report optional user progress-reporting callback,\ncalled once per major iteration with the\ncurrent iterate; set its user_stop output\nto request the solver stop early\n(see sqpopt_types_module ) Called by proc~~sqpopt_initialize~~CalledByGraph proc~sqpopt_initialize sqpopt_type%sqpopt_initialize proc~nlls_initialize sqpopt_nlls_type%nlls_initialize proc~nlls_initialize->proc~sqpopt_initialize proc~nlls_destroy sqpopt_nlls_type%nlls_destroy proc~nlls_initialize->proc~nlls_destroy proc~sqpopt_destroy sqpopt_type%sqpopt_destroy proc~sqpopt_destroy->proc~sqpopt_initialize proc~nlls_destroy->proc~sqpopt_destroy Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine sqpopt_initialize ( me , problem , options , hessian , qp_solver , linesearch , trust_region , report ) class ( sqpopt_type ), intent ( inout ) :: me type ( sqpopt_problem_type ), optional , intent ( in ) :: problem !! the nonlinear program to be solved type ( sqpopt_options_type ), optional , intent ( in ) :: options !! solver options type ( sqpopt_hessian_type ), optional , intent ( in ) :: hessian !! Hessian of the Lagrangian approximation type ( sqpopt_qp_solver_type ), optional , intent ( in ) :: qp_solver !! QP subproblem solver type ( sqpopt_linesearch_type ), optional , intent ( in ) :: linesearch !! merit function / line search type ( sqpopt_trust_region_type ), optional , intent ( in ) :: trust_region !! trust-region globalization (opt-in !! alternative to `linesearch`, see !! [[sqpopt_trust_region_module]]) procedure ( sqpopt_report_func ), optional :: report !! optional user progress-reporting callback, !! called once per major iteration with the !! current iterate; set its `user_stop` output !! to request the solver stop early !! (see [[sqpopt_types_module]]) ! use inputs if present, else use defaults: if ( present ( problem )) then ; me % problem0 = problem ; else ; me % problem0 = sqpopt_problem_type (); end if if ( present ( options )) then ; me % options = options ; else ; me % options = sqpopt_options_type (); end if if ( present ( hessian )) then ; me % hessian = hessian ; else ; me % hessian = sqpopt_hessian_type (); end if if ( present ( qp_solver )) then ; me % qp_solver0 = qp_solver ; else ; me % qp_solver0 = sqpopt_qp_solver_type (); end if if ( present ( linesearch )) then ; me % linesearch0 = linesearch ; else ; me % linesearch0 = sqpopt_linesearch_type (); end if if ( present ( trust_region )) then me % trust_region0 = trust_region else me % trust_region0 = sqpopt_trust_region_type () end if me % report => null () if ( present ( report )) me % report => report if ( allocated ( me % x )) deallocate ( me % x ) if ( allocated ( me % lambda )) deallocate ( me % lambda ) me % results = sqpopt_results_type () me % results % message = '' end subroutine sqpopt_initialize","tags":"","url":"proc/sqpopt_initialize.html"},{"title":"sqpopt_solve – sqpopt","text":"private  subroutine sqpopt_solve(me, x0, istat, lambda0) solve the nonlinear program starting from the initial guess x0 (and,\noptionally, initial constraint multipliers lambda0 , with the sign\nconvention of sqpopt_results_type ), running major SQP iterations\nuntil convergence or a stopping criterion is met. The outcome is\navailable from get_solution , get_results , and status_message . Type Bound sqpopt_type Arguments Type Intent Optional Attributes Name class( sqpopt_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x0 initial guess for the optimization variables dimension(n) integer, intent(out) :: istat status code (see sqpopt_types_module ) real(kind=wp), intent(in), optional, dimension(:) :: lambda0 initial guess for the constraint multipliers dimension(m) Calls proc~~sqpopt_solve~~CallsGraph proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~compute_scaling sqpopt_problem_type%comput