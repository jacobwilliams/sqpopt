 = sqpopt_merit_l1 merit function to use (set from options%merit_mode ) real(kind=wp), public :: penalty = 1.0_wp current penalty parameter (called for sqpopt_merit_l1 , for sqpopt_merit_augmented_lagrangian ) integer, public :: penalty_update = sqpopt_penalty_multipliers how the penalty parameter is updated (see the sqpopt_penalty_* constants; set from options%penalty_update ) real(kind=wp), public :: penalty_rho = 0.1_wp sqpopt_penalty_model with sqpopt_merit_l1 : the\nfraction of the linearized violation\nreduction the penalty must credit (Nocedal & Wright\neq. 18.36), logical, public :: joint_active = .false. whether the merit's multipliers move along the step (see update_penalty_parameter ) real(kind=wp), public, dimension(:), allocatable :: lambda0 the multipliers at the start of the step dimension(m) real(kind=wp), public, dimension(:), allocatable :: s0 the slacks at the start of the step dimension(m) real(kind=wp), public, dimension(:), allocatable :: q the slacks' change per unit step dimension(m) real(kind=wp), public :: penalty_floor = 1.0e-2_wp the penalty can only decrease above this, which doubles each time Type-Bound Procedures procedure, public :: eval => eval_merit_function procedure, public :: directional_derivative => merit_directional_derivative procedure, public :: update_penalty => update_penalty_parameter Subroutines private  subroutine eval_merit_function (me, f, c, c_lb, c_ub, lambda, phi, alpha) evaluate the merit function used to measure progress, dispatching on me%mode : Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_merit_type ), intent(inout) :: me real(kind=wp), intent(in) :: f objective function value real(kind=wp), intent(in), dimension(:) :: c constraint values dimension(m) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda Lagrange multiplier estimate dimension(m) (only used by sqpopt_merit_augmented_lagrangian ) real(kind=wp), intent(out) :: phi value of the merit function real(kind=wp), intent(in), optional :: alpha step length along the joint step (see above) private  subroutine augmented_lagrangian_slacks (me, c, c_lb, c_ub, lambda, s) the closed-form slack s that minimizes the augmented Lagrangian merit\nfunction subject to : this generalizes the\nnon-negative slack of the original\n(single-sided) formulation to sqpopt 's two-sided constraint bounds\n(equality rows, where c_lb=c_ub , are handled automatically since s is then clipped to that single value regardless of ). Arguments Type Intent Optional Attributes Name class( sqpopt_merit_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: c constraint values at x dimension(m) real(kind=wp), intent(in), dimension(:) :: c_lb lower bounds on the constraints dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub upper bounds on the constraints dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda Lagrange multipliers for the constraints dimension(m) real(kind=wp), intent(out), dimension(:) :: s closed-form slack that minimizes the augmented Lagrangian merit function private  subroutine merit_directional_derivative (me, jac, g, p, c, c_lb, c_ub, lambda, dphi0) the (approximate) directional derivative of the merit\nfunction along p , used by the Armijo sufficient-decrease test and by\nthe descent-direction safeguard in sqpopt_iterate_module . Dispatches\non me%mode : Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_merit_type ), intent(in) :: me type( sqpopt_sparse_matrix ), intent(in) :: jac constraint Jacobian at x , dimension(m,n) real(kind=wp), intent(in), dimension(:) :: g objective gradient at x dimension(n) real(kind=wp), intent(in), dimension(:) :: p search direction dimension(n) real(kind=wp), intent(in), dimension(:) :: c constraint values at x dimension(m) real(kind=wp), intent(in), dimension(:) :: c_lb lower bounds on the constraints dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub upper bounds on the constraints dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda Lagrange multipliers for the constraints dimension(m) real(kind=wp), intent(out) :: dphi0 directional derivative of the merit function along p private  subroutine update_penalty_parameter (me, jac, g, p, php, c, c_lb, c_ub, lambda, lambda_qp) update the merit function's penalty parameter after the QP solve, for\nthe step p (with = php ), according to penalty_update : Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_merit_type ), intent(inout) :: me type( sqpopt_sparse_matrix ), intent(in) :: jac constraint Jacobian at x , dimension(m,n) real(kind=wp), intent(in), dimension(:) :: g objective gradient at x dimension(n) real(kind=wp), intent(in), dimension(:) :: p the step dimension(n) real(kind=wp), intent(in) :: php real(kind=wp), intent(in), dimension(:) :: c constraint values at x dimension(m) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda the current multipliers dimension(m) real(kind=wp), intent(in), dimension(:) :: lambda_qp the QP's multipliers dimension(m)","tags":"","url":"module/sqpopt_merit_module.html"},{"title":"sqpopt_kkt_module – sqpopt","text":"The KKT matrix of a QP subproblem's working set, factored by the sparse\ndirect solver of sqpopt_symmetric_solver_module (MUMPS or QDLDL,\nsee options%linear_solver ): where is the Hessian in the free variables (those not at a\nbound of the working set), holds the working set's rows of the\nJacobian in those variables, and is an optional\nregularization (zero, unless a singular matrix is being regularized). It answers two questions about the QP restricted to that working set\n(a face of the QP): Is it convex there? By Sylvester's law of inertia, has one\n  negative eigenvalue for each (independent) row of , plus one\n  for each negative eigenvalue of the reduced Hessian . So n_negative , the number of negative eigenvalues beyond the number of\n  rows, counts the directions of negative curvature on the face. This is\n  what the inertia control uses (see sqpopt_inertia_module ). Where is its minimizer? One solve with the factors gives the step\n  to the minimizer of the face, and its multipliers (see sqpopt_qp_direct_module ). A fixed pattern. So that the sparsity pattern is the same for every\nworking set (it is analysed only once per solve), always has\norder n+m : a variable at a bound of the working set has its row and\ncolumn replaced by those of the identity, and a constraint outside it by\nthose of minus the identity. The unknowns of a solve are then all n step components followed by all m multipliers (see kkt_solve ). One factorization at a time. The last factorization is kept, with\nthe working set it was made for. Asking for the same one again (while\nthe matrices haven't changed, see kkt_new_matrices ) costs nothing,\nso the inertia control and the direct QP step share their\nfactorizations. The Hessian is the solver's ( kkt_factor ), or a multiple of the\nidentity ( kkt_factor_identity , for the least-squares problems of sqpopt_least_squares_module ). Quasi-Newton Hessians. The user's exact Hessian is sparse, and goes\ninto as it is. A limited-memory quasi-Newton Hessian is not\nsparse, but it is a multiple of the identity plus a matrix of low rank r (see sqpopt_hessian_module ), . So , where is the sparse\nmatrix with for the Hessian, and is in the free variables (zero elsewhere). Only is factored, and: a solve uses the Sherman-Morrison-Woodbury formula, , with the\n  small dense matrix : two solves\n  with each, after r solves to form when the\n  matrix is factored (as IPOPT does for its limited-memory option); the inertia follows from the two ways of eliminating a block of (the Haynsworth inertia additivity formula): the number of negative\n  eigenvalues of is that of , plus the number of\n  positive eigenvalues of , minus that of . Uses sqpopt_hessian_module sqpopt_types_module sqpopt_kinds sqpopt_symmetric_solver_module sqpopt_dense_linalg_module module~~sqpopt_kkt_module~~UsesGraph module~sqpopt_kkt_module sqpopt_kkt_module module~sqpopt_dense_linalg_module sqpopt_dense_linalg_module module~sqpopt_kkt_module->module~sqpopt_dense_linalg_module module~sqpopt_hessian_module sqpopt_hessian_module module~sqpopt_kkt_module->module~sqpopt_hessian_module module~sqpopt_kinds sqpopt_kinds module~sqpopt_kkt_module->module~sqpopt_kinds module~sqpopt_symmetric_solver_module sqpopt_symmetric_solver_module module~sqpopt_kkt_module->module~sqpopt_symmetric_solver_module module~sqpopt_types_module sqpopt_types_module module~sqpopt_kkt_module->module~sqpopt_types_module module~sqpopt_dense_linalg_module->module~sqpopt_kinds module~sqpopt_hessian_module->module~sqpopt_dense_linalg_module module~sqpopt_hessian_module->module~sqpopt_kinds iso_fortran_env iso_fortran_env module~sqpopt_kinds->iso_fortran_env module~sqpopt_symmetric_solver_module->module~sqpopt_kinds module~sqpopt_symmetric_solver_module->module~sqpopt_types_module module~sqpopt_symmetric_solver_module->iso_fortran_env module~sqpopt_dense_ldl_module sqpopt_dense_ldl_module module~sqpopt_symmetric_solver_module->module~sqpopt_dense_ldl_module module~sqpopt_mumps_ldl_module sqpopt_mumps_ldl_module module~sqpopt_symmetric_solver_module->module~sqpopt_mumps_ldl_module module~sqpopt_qdldl_ldl_module sqpopt_qdldl_ldl_module module~sqpopt_symmetric_solver_module->module~sqpopt_qdldl_ldl_module module~sqpopt_sparse_ldl_module sqpopt_sparse_ldl_module module~sqpopt_symmetric_solver_module->module~sqpopt_sparse_ldl_module module~sqpopt_types_module->module~sqpopt_kinds ieee_arithmetic ieee_arithmetic module~sqpopt_types_module->ieee_arithmetic module~sqpopt_dense_ldl_module->module~sqpopt_dense