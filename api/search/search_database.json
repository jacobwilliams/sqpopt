nd negative curvature of the Hessian\nin the variables (output; see sqpopt_iterate_module ) logical, public :: out_of_memory = .false. whether a QP solve of this solve returned sqpopt_out_of_memory (output; it stays set, so the solver stops whichever step asked\nfor that QP; reset on each solve ) logical, public :: unconstrained_step = .true. whether to try the unconstrained step first, with the\nlimited-memory BFGS Hessian: if satisfies the bounds\nand the linearized constraints, it is the QP's solution, and no QP\nsolver is run (see the module docs) logical, public :: unconstrained_used = .false. whether the last QP was solved by the unconstrained step (output) integer, public :: n_unconstrained = 0 number of QPs of this solve solved by the unconstrained step (output) logical, public :: direct = .false. whether to try the direct method first (overwritten from options%direct_qp ; see sqpopt_qp_direct_module ) integer, public :: direct_max_changes = 10 the direct method gives up, and the active-set solver is run,\nafter this many changes of the working set (each one is a\nfactorization) without reaching the solution real(kind=wp), public :: direct_tol = 1.0e-8_wp the direct method's relative tolerance for a violated row or\nbound, and for the sign of a multiplier logical, public :: direct_used = .false. whether the last QP was solved by the direct method (output) integer, public :: direct_outcome = -1 how the direct method ended in the last QP solve: a sqpopt_direct_* constant (see sqpopt_qp_direct_module ), or -1 if it wasn't\ntried (output) integer, public :: direct_changes = 0 the changes of the working set it made there (output) integer, public :: n_solves = 0 number of QP solves in this solve (output) integer, public :: n_direct = 0 of which, by the direct method (output) type( sqpopt_dense_qp_type ), public :: dense_qp the dense QP solver (used only when mode==sqpopt_qp_dense ) type( sqpopt_reduced_hessian_qp_type ), public :: sparse_qp the sparse QP solver (used only when mode==sqpopt_qp_reduced_hessian ) Type-Bound Procedures procedure, public :: solve => solve_qp_subproblem private  subroutine solve_qp_subproblem (me, hessian, jac, x, g, c, x_lb, x_ub, c_lb, c_ub, p, lambda, istat, elastic_sign, elastic_weight, kkt, inertia) solve the linearized QP subproblem for the search direction p and\nthe associated Lagrange multipliers lambda , dispatching to the\nactive-set solver selected by me%mode (see sqpopt_qp_dense_module , sqpopt_qp_reduced_hessian_module ). If the solver returns istat=sqpopt_out_of_memory , me%out_of_memory is also set (and stays\nset), for sqpopt_iterate to stop the solve. Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(inout) :: me type( sqpopt_hessian_type ), intent(inout) :: hessian matrix-free Hessian approximation (never a dense n x n matrix) type( sqpopt_sparse_matrix ), intent(in) :: jac sparse constraint Jacobian, dimension(m,n) real(kind=wp), intent(in), dimension(:) :: x current point dimension(n) real(kind=wp), intent(in), dimension(:) :: g objective gradient dimension(n) real(kind=wp), intent(in), dimension(:) :: c current constraint values dimension(m) real(kind=wp), intent(in), dimension(:) :: x_lb variable lower bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: x_ub variable upper bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) real(kind=wp), intent(out), dimension(:) :: p computed search direction dimension(n) real(kind=wp), intent(out), dimension(:) :: lambda Lagrange multipliers for the linearized constraints dimension(m) integer, intent(out) :: istat status code (see sqpopt_types_module ) integer, intent(in), optional, dimension(:) :: elastic_sign forced elastic mode: the rows to make\nelastic, and in which direction ( +1 relaxes a row's lower bound, -1 its upper\nbound, 0 none) dimension(m) real(kind=wp), intent(in), optional :: elastic_weight forced elastic mode: the fixed weight of every elastic slack type( sqpopt_kkt_type ), intent(inout), optional :: kkt the KKT matrix, for the direct method (see sqpopt_kkt_module ) type( sqpopt_inertia_type ), intent(inout), optional :: inertia the inertia control, for the direct method\nat a nonconvex face (see sqpopt_inertia_module ) procedure, public :: mode_name private  function mode_name (me, n) result(name) the name of the QP algorithm used for a problem with n variables\n( mode with sqpopt_qp_auto resolved), for the printed output. Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me integer, intent(in) :: n number of variables (which sqpopt_qp_auto depends on) Return Value character(len=:), allocatable procedure, public :: working_set private  subroutine working_set (me, n, m, status) the final working set of the last QP solve with n variables and m constraints: the side ( -1 lower, +1 upper, 0 not in the working\nset) of each general row, then of each variable bound. status is\nreturned unallocated if there is none (no QP of that size has been\nsolved yet). Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me integer, intent(in) :: n number of variables integer, intent(in) :: m number of constraints integer, intent(out), dimension(:), allocatable :: status the working set dimension(m+n) (see above) procedure, public :: starting_working_set private  subroutine starting_working_set (me, x_lb, x_ub, c_lb, c_ub, status) the working set that the next QP solve will start from, for a problem\nwith the given bounds: the final working set of the last one (see working_set ), or, if there is none, the equality constraints and\nthe fixed variables (the active-set solvers' crash start). Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: x_lb variable lower bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: x_ub variable upper bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) integer, intent(out), dimension(:), allocatable :: status the working set dimension(m+n) (see working_set ) procedure, public :: elastic_slacks private  subroutine elastic_slacks (me, n, row, slack) the elastic slacks of the last QP solve with n variables: the general\nrow of each, and its value at the QP's solution (by how much the step\nviolates that linearized constraint). They are only kept if the\nactive-set solvers' keep_slacks is set (the solver sets it for its\ndiagnostics); row and slack have size zero if there are none. Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me integer, intent(in) :: n number of variables integer, intent(out), dimension(:), allocatable :: row the row of each elastic slack real(kind=wp), intent(out), dimension(:), allocatable :: slack its value Source Code type , public :: sqpopt_qp_solver_type !! workspace and options for the QP subproblem solver. integer :: mode = sqpopt_qp_auto !! which QP algorithm to use (see the `sqpopt_qp_*` constants) integer :: auto_dense_max_n = 200 !! `mode==sqpopt_qp_auto` uses the dense QP solver for problems !! with at most this many variables, and the sparse !! reduced-Hessian QP solver for larger ones real ( wp ) :: max_step = 2.0_wp !! trust-region-style cap on  \\lVert p \\rVert_2 : !! `p` is rescaled if it is longer than `max_step*step_scale` !! (the cap starts at  \\max( `max_step` !! , \\lVert x_0 \\rVert_\\infty) , see the module docs) real ( wp ) :: step_scale = 1.0_wp !! the adaptive factor on `max_step` (internal state, !! see the module docs; reset on each `solve`) logical :: capped = . false . !! whether the last step was capped (output) integer :: n_elastic = 0 !! elastic re-solves in this solve (internal state, see !! [[sqpopt_iterate_module]]) integer :: n_short = 0 !! consecutive very short line-search steps (internal !! state, see [[sqpopt_iterate_module]]) integer :: n_iter = 0 !! number of active-set iterations taken by the last QP solve (output) integer :: n_working = 0 !! size of the final working set of the last QP solve (output) integer :: n_slacks = 0 !! number of elastic slacks in the last QP solve (output) real ( wp ) :: time = 0.0_wp !! wall-clock time spent in QP solves (output, seconds; reset on each `solve`) logical :: negative_curvature = . false . !! whether the last QP solve found negative curvature of the Hessian !! in the variables (output; see [[sqpopt_iterate_module]]) logical :: out_of_memory = . false . !! whether a QP solve of this `solve` returned `sqpopt_out_of_memory` !! (output; it stays set, so the solver stops whichever step asked !! for that QP; reset on each `solve`) logical :: unconstrained_step = . true . !! whether to try the unconstrained step first, with the !! limited-memory BFGS Hessian: if  -H&#94;{-1} g  satisfies the bounds !! and the linearized constraints, it is the QP's solution, and no QP !! solver is run (see the module docs) logical :: unconstrained_used = . false . !! whether the last QP was solved by the unconstrained step (output) integer :: n_unconstrained = 0 !! number of QPs of this `solve` solved by the unconstrained step (output) logical :: direct = . false . !! whether to try the direct method first (overwritten from !! `options%direct_qp`; see [[sqpopt_qp_direct_module]]) integer :: direct_max_changes = 10 !! the direct method gives up, and the active-set solver is run, !! after this many changes of the working set (each one is a !! factorization) without reaching the solution real ( wp ) :: direct_tol = 1.0e-8_wp !! the direct method's relative tolerance for a violated row or !! bound, and for the sign of a multiplier logical :: direct_used = . false . !! whether the last QP was solved by the direct method (output) integer :: direct_outcome = - 1 !! how the direct method ended in the last QP solve: a `sqpopt_direct_*` !! constant (see [[sqpopt_qp_direct_module]]), or `-1` if it wasn't !! tried (output) integer :: direct_changes = 0 !! the changes of the working set it made there (output) integer :: n_solves = 0 !! number of QP solves in this `solve` (output) integer :: n_direct = 0 !! of which, by the direct method (output) type ( sqpopt_dense_qp_type ) :: dense_qp !! the dense QP solver (used only when `mode==sqpopt_qp_dense`) type ( sqpopt_reduced_hessian_qp_type ) :: sparse_qp !! the sparse QP solver (used only when `mode==sqpopt_qp_reduced_hessian`) contains procedure , public :: solve => solve_qp_subproblem procedure , public :: mode_name procedure , public :: working_set procedure , public :: starting_working_set procedure , public :: elastic_slacks end type sqpopt_qp_solver_type","tags":"","url":"type/sqpopt_qp_solver_type.html"},{"title":"sqpopt_lu_type – sqpopt ","text":"type, public :: sqpopt_lu_type sparse LU factors of a square matrix ( LUSOL ), for repeated solves\nwith it and its transpose. See factorize . Components Type Visibility Attributes Name Initial integer(kind=ip), private :: n = 0 integer(kind=ip), private :: lena = 0 integer(kind=ip), private :: luparm (30) = 0 real(kind=rp), private :: parmlu (30) = 0.0_rp real(kind=rp), private, dimension(:), allocatable :: a integer(kind=ip), private, dimension(:), allocatable :: indc integer(kind=ip), private, dimension(:), allocatable :: indr integer(kind=ip), private, dimension(:), allocatable :: p integer(kind=ip), private, dimension(:), allocatable :: q integer(kind=ip), private, dimension(:), allocatable :: lenc integer(kind=ip), private, dimension(:), allocatable :: lenr integer(kind=ip), private, dimension(:), allocatable :: locc integer(kind=ip), private, dimension(:), allocatable :: locr real(kind=rp), private, dimension(:), allocatable :: v work vectors of the solves and the column\nreplacements dimension(n) (kept here so that a\nsolve allocates nothing) real(kind=rp), private, dimension(:), allocatable :: w work vectors of the solves and the column\nreplacements dimension(n) (kept here so that a\nsolve allocates nothing) Type-Bound Procedures procedure, public :: factorize => lu_factorize private  subroutine lu_factorize (me, n, irow, icol, val, rel_tol, istat) factorize the square n x n sparse matrix A (COO triplets, no\nduplicate (irow,icol) pairs) with LUSOL 's lu1fac (threshold rook\npivoting, for stability). istat is 0 on success, 1 if A appears\nto be singular (see independent_columns for the test), or else lu1fac 's inform code; the factors can only be used if it is 0 . Arguments Type Intent Optional Attributes Name class( sqpopt_lu_type ), intent(inout) :: me integer, intent(in) :: n order of A integer, intent(in), dimension(:) :: irow row indices of the nonzeros of A integer, intent(in), dimension(:) :: icol column indices of the nonzeros of A real(kind=wp), intent(in), dimension(:) :: val the nonzeros of A real(kind=wp), intent(in) :: rel_tol relative singularity tolerance (e.g. 1e-10 ) integer, intent(out) :: istat status (0 = success) procedure, public :: solve => lu_solve private  subroutine lu_solve (me, b, x, transpose) solve (or if transpose ) with the factors\nfrom factorize . Arguments Type Intent Optional Attributes Name class( sqpopt_lu_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: b right-hand side dimension(n) real(kind=wp), intent(out), dimension(:) :: x solution dimension(n) logical, intent(in) :: transpose solve with instead of procedure, public :: replace_column => lu_replace_column private  subroutine lu_replace_column (me, jrep, irow, val, istat) update the factors when column jrep of the matrix is replaced by the\nsparse column ( irow , val ), with LUSOL 's lu8rpc (a Bartels-Golub\nupdate). istat is 0 on success; otherwise (the new matrix appears to\nbe singular, the update seemed unstable, or the factors ran out of\nstorage) the factors can no longer be used, and the matrix should be\nfactorized again. Arguments Type Intent Optional Attributes Name class( sqpopt_lu_type ), intent(inout) :: me integer, intent(in) :: jrep the column to replace integer, intent(in), dimension(:) :: irow row indices of the nonzeros of the new column real(kind=wp), intent(in), dimension(:) :: val the nonzeros of the new column integer, intent(out) :: istat status (0 = success) Source Code type , public :: sqpopt_lu_type !! sparse LU factors of a square matrix (`LUSOL`), for repeated solves !! with it and its transpose. See [[sqpopt_lu_type(type):factorize(bound)]]. private integer ( ip ) :: n = 0 integer ( ip ) :: lena = 0 integer ( ip ) :: luparm ( 30 ) = 0 real ( rp ) :: parmlu ( 30 ) = 0.0_rp real ( rp ), dimension (:), allocatable :: a integer ( ip ), dimension (:), allocatable :: indc , indr , p , q , lenc , lenr , locc , locr real ( rp ), dimension (:), allocatable :: v , w !! work vectors of the solves and the column !! replacements `dimension(n)` (kept here so that a !! solve allocates nothing) contains procedure , public :: factorize => lu_factorize procedure , public :: solve => lu_solve procedure , public :: replace_column => lu_replace_column end type sqpopt_lu_type","tags":"","url":"type/sqpopt_lu_type.html"},{"title":"sqpopt_least_squares_type – sqpopt ","text":"type, public :: sqpopt_least_squares_type the direct least-squares solver of one solve (see the module\ndocumentation). It holds a sparse solver, so it must not be copied,\nand least_squares_destroy must be called when the solve ends. Inherits type~~sqpopt_least_squares_type~~InheritsGraph type~sqpopt_least_squares_type sqpopt_least_squares_type type~sqpopt_kkt_type sqpopt_kkt_type type~sqpopt_least_squares_type->type~sqpopt_kkt_type kkt type~sqpopt_symmetric_solver_type sqpopt_symmetric_solver_type type~sqpopt_kkt_type->type~sqpopt_symmetric_solver_type solver 