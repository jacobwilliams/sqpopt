s Name Initial integer, public :: mode = sqpopt_qp_auto which QP algorithm to use (see the sqpopt_qp_* constants) integer, public :: auto_dense_max_n = 200 mode==sqpopt_qp_auto uses the dense QP solver for problems\nwith at most this many variables, and the sparse\nreduced-Hessian QP solver for larger ones real(kind=wp), public :: max_step = 2.0_wp trust-region-style cap on : p is rescaled if it is longer than max_step*step_scale (the cap starts at max_step , see the module docs) real(kind=wp), public :: step_scale = 1.0_wp the adaptive factor on max_step (internal state,\nsee the module docs; reset on each solve ) logical, public :: capped = .false. whether the last step was capped (output) integer, public :: n_elastic = 0 elastic re-solves in this solve (internal state, see sqpopt_iterate_module ) integer, public :: n_short = 0 consecutive very short line-search steps (internal\nstate, see sqpopt_iterate_module ) integer, public :: n_iter = 0 number of active-set iterations taken by the last QP solve (output) integer, public :: n_working = 0 size of the final working set of the last QP solve (output) integer, public :: n_slacks = 0 number of elastic slacks in the last QP solve (output) real(kind=wp), public :: time = 0.0_wp wall-clock time spent in QP solves (output, seconds; reset on each solve ) logical, public :: negative_curvature = .false. whether the last QP solve found negative curvature of the Hessian\nin the variables (output; see sqpopt_iterate_module ) logical, public :: out_of_memory = .false. whether a QP solve of this solve returned sqpopt_out_of_memory (output; it stays set, so the solver stops whichever step asked\nfor that QP; reset on each solve ) logical, public :: unconstrained_step = .true. whether to try the unconstrained step first, with the\nlimited-memory BFGS Hessian: if satisfies the bounds\nand the linearized constraints, it is the QP's solution, and no QP\nsolver is run (see the module docs) logical, public :: unconstrained_used = .false. whether the last QP was solved by the unconstrained step (output) integer, public :: n_unconstrained = 0 number of QPs of this solve solved by the unconstrained step (output) logical, public :: direct = .false. whether to try the direct method first (overwritten from options%direct_qp ; see sqpopt_qp_direct_module ) integer, public :: direct_max_changes = 10 the direct method gives up, and the active-set solver is run,\nafter this many changes of the working set (each one is a\nfactorization) without reaching the solution real(kind=wp), public :: direct_tol = 1.0e-8_wp the direct method's relative tolerance for a violated row or\nbound, and for the sign of a multiplier logical, public :: direct_used = .false. whether the last QP was solved by the direct method (output) integer, public :: direct_outcome = -1 how the direct method ended in the last QP solve: a sqpopt_direct_* constant (see sqpopt_qp_direct_module ), or -1 if it wasn't\ntried (output) integer, public :: direct_changes = 0 the changes of the working set it made there (output) integer, public :: n_solves = 0 number of QP solves in this solve (output) integer, public :: n_direct = 0 of which, by the direct method (output) type( sqpopt_dense_qp_type ), public :: dense_qp the dense QP solver (used only when mode==sqpopt_qp_dense ) type( sqpopt_reduced_hessian_qp_type ), public :: sparse_qp the sparse QP solver (used only when mode==sqpopt_qp_reduced_hessian ) Type-Bound Procedures procedure, public :: solve => solve_qp_subproblem procedure, public :: mode_name procedure, public :: working_set procedure, public :: starting_working_set procedure, public :: elastic_slacks Functions private pure function resolved_mode (me, n) the QP algorithm actually used for a problem with n variables: me%mode , with sqpopt_qp_auto resolved to a specific solver. Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me integer, intent(in) :: n number of variables Return Value integer private  function mode_name (me, n) result(name) the name of the QP algorithm used for a problem with n variables\n( mode with sqpopt_qp_auto resolved), for the printed output. Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me integer, intent(in) :: n number of variables (which sqpopt_qp_auto depends on) Return Value character(len=:), allocatable Subroutines private  subroutine solve_qp_subproblem (me, hessian, jac, x, g, c, x_lb, x_ub, c_lb, c_ub, p, lambda, istat, elastic_sign, elastic_weight, kkt, inertia) solve the linearized QP subproblem for the search direction p and\nthe associated Lagrange multipliers lambda , dispatching to the\nactive-set solver selected by me%mode (see sqpopt_qp_dense_module , sqpopt_qp_reduced_hessian_module ). If the solver returns istat=sqpopt_out_of_memory , me%out_of_memory is also set (and stays\nset), for sqpopt_iterate to stop the solve. Read more… Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(inout) :: me type( sqpopt_hessian_type ), intent(inout) :: hessian matrix-free Hessian approximation (never a dense n x n matrix) type( sqpopt_sparse_matrix ), intent(in) :: jac sparse constraint Jacobian, dimension(m,n) real(kind=wp), intent(in), dimension(:) :: x current point dimension(n) real(kind=wp), intent(in), dimension(:) :: g objective gradient dimension(n) real(kind=wp), intent(in), dimension(:) :: c current constraint values dimension(m) real(kind=wp), intent(in), dimension(:) :: x_lb variable lower bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: x_ub variable upper bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) real(kind=wp), intent(out), dimension(:) :: p computed search direction dimension(n) real(kind=wp), intent(out), dimension(:) :: lambda Lagrange multipliers for the linearized constraints dimension(m) integer, intent(out) :: istat status code (see sqpopt_types_module ) integer, intent(in), optional, dimension(:) :: elastic_sign forced elastic mode: the rows to make\nelastic, and in which direction ( +1 relaxes a row's lower bound, -1 its upper\nbound, 0 none) dimension(m) real(kind=wp), intent(in), optional :: elastic_weight forced elastic mode: the fixed weight of every elastic slack type( sqpopt_kkt_type ), intent(inout), optional :: kkt the KKT matrix, for the direct method (see sqpopt_kkt_module ) type( sqpopt_inertia_type ), intent(inout), optional :: inertia the inertia control, for the direct method\nat a nonconvex face (see sqpopt_inertia_module ) private  subroutine working_set (me, n, m, status) the final working set of the last QP solve with n variables and m constraints: the side ( -1 lower, +1 upper, 0 not in the working\nset) of each general row, then of each variable bound. status is\nreturned unallocated if there is none (no QP of that size has been\nsolved yet). Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me integer, intent(in) :: n number of variables integer, intent(in) :: m number of constraints integer, intent(out), dimension(:), allocatable :: status the working set dimension(m+n) (see above) private  subroutine elastic_slacks (me, n, row, slack) the elastic slacks of the last QP solve with n variables: the general\nrow of each, and its value at the QP's solution (by how much the step\nviolates that linearized constraint). They are only kept if the\nactive-set solvers' keep_slacks is set (the solver sets it for its\ndiagnostics); row and slack have size zero if there are none. Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me integer, intent(in) :: n number of variables integer, intent(out), dimension(:), allocatable :: row the row of each elastic slack real(kind=wp), intent(out), dimension(:), allocatable :: slack its value private  subroutine starting_working_set (me, x_lb, x_ub, c_lb, c_ub, status) the working set that the next QP solve will start from, for a problem\nwith the given bounds: the final working set of the last one (see working_set ), or, if there is none, the equality constraints and\nthe fixed variables (the active-set solvers' crash start). Arguments Type Intent Optional Attributes Name class( sqpopt_qp_solver_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: x_lb variable lower bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: x_ub variable upper bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) integer, intent(out), dimension(:), allocatable :: status the working set dimension(m+n) (see working_set )","tags":"","url":"module/sqpopt_qp_solver_module.html"},{"title":"sqpopt_qp_direct_module – sqpopt","text":"A direct solution of the QP subproblem ( options%direct_qp ), by sparse\nfactorizations of the KKT matrix of its working set (see sqpopt_kkt_module ; MUMPS or QDLDL, see options%linear_solver ). For a given working set (the general rows and variable bounds held at\na bound), the QP is an equality-constrained one, and its solution is one\nlinear solve: with the variables at a bound of the working set fixed there. That step\nsolves the whole QP if it is feasible (it satisfies the rows and bounds\noutside the working set) and optimal (the multipliers of the working\nset's inequalities have the right signs), and the face is convex (no\nnegative curvature, which the factorization tells). direct_qp_step starts from the working set that the QP solver would\nstart from: near a solution of the nonlinear problem, that is already\nthe right one, and the QP costs one factorization and one solve. If the\nstep isn't feasible and optimal, the working set is changed as in a primal-dual active-set method (Hintermüller, Ito & Kunisch, 2002):\nevery row and bound the step violates is added, every one whose\nmultiplier has the wrong sign is dropped, and the new face is factored\nand solved. After a few changes without success, it gives up, and the\ncaller solves the QP with its active-set solver instead (see solve_qp_subproblem ). So the direct method only ever replaces a QP\nsolve by a solution that satisfies the QP's optimality conditions. Adding every violated bound at once can leave a row of the working set\nwith no free variable, or otherwise dependent on the others: the KKT\nmatrix is then singular. Such a face is factored again with a small\nregularization ( in the rows' block, see sqpopt_kkt_module ), which satisfies the dependent rows only in a\nheavily weighted least-squares sense. That gives them large multipliers,\nso the bounds that over-determine them are dropped at the next change.\nA step is only accepted if it satisfies the working set's rows, so a\nregularized face is accepted only if its rows were consistent. A\nregularized solve leaves each row short by times its\nmultiplier, so if that is all that is wrong with the step, the face is\nsolved once more with a much smaller . (That matters\nwhen the solver finds a matrix singular that isn't: near the solution of\na chain of 100,000 circle constraints, the first regularization left the\nrows 7e-8 short, and the method gave up on a QP it had solved.) A face\nthat is still singular (a direction of zero curvature) ends the method. A face with negative curvature has no minimizer. With inertia control\n(see sqpopt_inertia_module ), the Hessian's shift is raised until the\nface is convex, and the method continues from there with the shifted\nHessian (the shift only ever increases, so this can't cycle). Without\nit, the method gives up at such a face. The factorization can't be updated when the working set changes: every\nchange is a new factorization. That is cheap next to the active-set\nsolvers on large problems (their iterations each solve with the reduced\nHessian), but it is why this isn't used for a QP that needs many\nchanges, such as the first one from an infeasible starting point. Uses sqpopt_hessian_module sqpopt_linalg_module sqpopt_types_module sqpopt_kkt_module sqpopt_inertia_module sqpopt_kinds module~~sqpopt_qp_direct_module~~UsesGraph module~sqpopt_qp_direct_module sqpopt_qp_direct_module module~sqpopt_hessian_module sqpopt_hessian_module module~sqpopt_qp_direct_module->module~sqpopt_hessian_module module~sqpopt_inertia_module sqpopt_inertia_module module~sqpopt_qp_direct_module->module~sqpopt_inertia_module module~sqpopt_kinds sqpopt_kinds module~sqpopt_qp_direct_module->module~sqpopt_kinds module~sqpopt_kkt_module sqpopt_kkt_module module~sqpopt_qp_direct_module->module~sqpopt_kkt_module module~sqpopt_linalg_module sqpopt_linalg_module module~sqpopt_qp_direct_module->module~sqpopt_linalg_module module~sqpopt_types_module sqpopt_types_module module~sqpopt_qp_direct_module->module~sqpopt_types_module module~sqpopt_hessian_module->module~sqpopt_kinds module~sqpopt_dense_linalg_module sqpopt_dense_linalg_module module~sqpopt_hessian_module->module~sqpopt_dense_linalg_module module~sqpopt_inertia_module->module~sqpopt_hessian_module module~sqpopt_inertia_module->module~sqpopt_kinds module~sqpopt_inertia_module->module~sqpopt_kkt_module module~sqpopt_inertia_module->module~sqpopt_types_module iso_fortran_env iso_fortran_env module~sqpopt_kinds->iso_fortran_env module~sqpopt_kkt_module->module~sqpopt_hessian_module module~sqpopt_kkt_module->module~sqpopt_kinds module~sqpopt_kkt_module->module~sqpopt_types_module module~sqpopt_kkt_module->module~sqpopt_dense_linalg_module module~sqpopt_symmetric_solver_module sqpopt_symmetric_solver_module module~sqpopt_kkt_module->module~sqpopt_symmetric_solver_module module~sqpopt_linalg_module->module~sqpopt_kinds module~sqpopt_linalg_module->module~sqpopt_types_module lusol lusol module~sqpopt_linalg_module->lusol lusol_precision lu