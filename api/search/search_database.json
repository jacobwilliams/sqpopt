(. not . ( me % enabled . and . me % current )) return call me % solver % solve ( v , ok ) if (. not . ok . or . me % rank == 0 ) return ! v = v - K0&#94;{-1} E T&#94;{-1} E&#94;T v: ok = . false . if (. not . present ( hessian )) return n = me % n allocate ( w ( me % rank ), e ( n + me % m )) e ( 1 : n ) = merge ( 0.0_wp , v ( 1 : n ), me % in_set ( me % m + 1 :)) call hessian % low_rank_multiply_transpose ( e ( 1 : n ), w ) call dense_lu_solve ( me % t_lu , me % t_piv , w ) call hessian % low_rank_multiply ( w , e ( 1 : n )) where ( me % in_set ( me % m + 1 :)) e ( 1 : n ) = 0.0_wp e ( n + 1 :) = 0.0_wp call me % solver % solve ( e , ok ) if ( ok ) v = v - e end subroutine kkt_solve","tags":"","url":"proc/kkt_solve.html"},{"title":"kkt_destroy – sqpopt","text":"private  subroutine kkt_destroy(me) free the solver and the arrays, and return to the initial (disabled)\nstate. It does nothing if the matrix was never initialized. Type Bound sqpopt_kkt_type Arguments Type Intent Optional Attributes Name class( sqpopt_kkt_type ), intent(inout) :: me Calls proc~~kkt_destroy~~CallsGraph proc~kkt_destroy sqpopt_kkt_type%kkt_destroy proc~symmetric_solver_destroy sqpopt_symmetric_solver_type%symmetric_solver_destroy proc~kkt_destroy->proc~symmetric_solver_destroy Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~kkt_destroy~~CalledByGraph proc~kkt_destroy sqpopt_kkt_type%kkt_destroy proc~kkt_initialize sqpopt_kkt_type%kkt_initialize proc~kkt_initialize->proc~kkt_destroy proc~least_squares_destroy sqpopt_least_squares_type%least_squares_destroy proc~least_squares_destroy->proc~kkt_destroy proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~kkt_destroy proc~least_squares_initialize sqpopt_least_squares_type%least_squares_initialize proc~least_squares_initialize->proc~kkt_initialize proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine kkt_destroy ( me ) class ( sqpopt_kkt_type ), intent ( inout ) :: me call me % solver % destroy () if ( allocated ( me % h_irow )) deallocate ( me % h_irow ) if ( allocated ( me % h_icol )) deallocate ( me % h_icol ) if ( allocated ( me % val )) deallocate ( me % val ) if ( allocated ( me % in_set )) deallocate ( me % in_set ) if ( allocated ( me % t_lu )) deallocate ( me % t_lu ) if ( allocated ( me % t_piv )) deallocate ( me % t_piv ) me % rank = 0 me % enabled = . false . me % n_negative = 0 me % singular = . false . me % inertia_known = . true . me % n = 0 me % m = 0 me % current = . false . me % diag = 0.0_wp me % reg = 0.0_wp end subroutine kkt_destroy","tags":"","url":"proc/kkt_destroy.html"},{"title":"restoration_phase_done – sqpopt","text":"private  function restoration_phase_done(me, linesearch, theta, f, exit_factor, feas_tol, max_iter) result(done) whether the restoration phase can end at a point with violation theta and objective f : the violation is at most exit_factor times its value where the phase started and the point is\nacceptable to the filter or funnel (see sqpopt_linesearch_type 's globalization_acceptable ); or the point is feasible\n( feas_tol ); or the phase has taken max_iter iterations. Ends the phase ( active=.false. ) if so. Type Bound sqpopt_restoration_type Arguments Type Intent Optional Attributes Name class( sqpopt_restoration_type ), intent(inout) :: me type( sqpopt_linesearch_type ), intent(in) :: linesearch supplies the filter or funnel real(kind=wp), intent(in) :: theta violation at the new point real(kind=wp), intent(in) :: f objective at the new point real(kind=wp), intent(in) :: exit_factor required reduction of the violation real(kind=wp), intent(in) :: feas_tol a violation this small ends the phase regardless integer, intent(in) :: max_iter maximum number of iterations of a phase Return Value logical Calls proc~~restoration_phase_done~~CallsGraph proc~restoration_phase_done sqpopt_restoration_type%restoration_phase_done proc~point_acceptable sqpopt_linesearch_type%point_acceptable proc~restoration_phase_done->proc~point_acceptable proc~filter_point_acceptable sqpopt_filter_type%filter_point_acceptable proc~point_acceptable->proc~filter_point_acceptable Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~restoration_phase_done~~CalledByGraph proc~restoration_phase_done sqpopt_restoration_type%restoration_phase_done proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~restoration_phase_done proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function restoration_phase_done ( me , linesearch , theta , f , exit_factor , feas_tol , max_iter ) result ( done ) class ( sqpopt_restoration_type ), intent ( inout ) :: me type ( sqpopt_linesearch_type ), intent ( in ) :: linesearch !! supplies the filter or funnel real ( wp ), intent ( in ) :: theta !!  \\ell_1  violation at the new point real ( wp ), intent ( in ) :: f !! objective at the new point real ( wp ), intent ( in ) :: exit_factor !! required reduction of the violation real ( wp ), intent ( in ) :: feas_tol !! a violation this small ends the phase regardless integer , intent ( in ) :: max_iter !! maximum number of iterations of a phase logical :: done done = ( theta <= exit_factor * me % theta_ref . and . linesearch % globalization_acceptable ( theta , f )) & . or . theta <= feas_tol . or . me % n_iter >= max_iter if ( done ) me % active = . false . end function restoration_phase_done","tags":"","url":"proc/restoration_phase_done.html"},{"title":"violation – sqpopt","text":"private elemental function violation(c, c_lb, c_ub) result(rc) the signed violation of the constraint bounds: c-c_lb below the lower\nbound, c-c_ub above the upper bound, and 0 in between. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: c constraint value real(kind=wp), intent(in) :: c_lb its lower bound real(kind=wp), intent(in) :: c_ub its upper bound Return Value real(kind=wp) Called by proc~~violation~~CalledByGraph proc~violation violation proc~escape_step escape_step proc~escape_step->proc~violation proc~restoration_step restoration_step proc~restoration_step->proc~violation proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~escape_step proc~sqpopt_iterate->proc~restoration_step proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code elemental function violation ( c , c_lb , c_ub ) result ( rc ) real ( wp ), intent ( in ) :: c !! constraint value real ( wp ), intent ( in ) :: c_lb !! its lower bound real ( wp ), intent ( in ) :: c_ub !! its upper bound real ( wp ) :: rc rc = min ( c - c_lb , 0.0_wp ) + max ( c - c_ub , 0.0_wp ) end function violation","tags":"","url":"proc/violation.html"},{"title":"restoration_step – sqpopt","text":"public  subroutine restoration_step(problem, jac, x, c, max_step, x_new, alpha, istat, direction, least_squares) take one Gauss-Newton step toward feasibility of the constraints (see\nthe module-level documentation), with a backtracking Armijo search on . If no decrease is found, x_new=x and istat=sqpopt_line_search_failed (also if LSQR stops at its\niteration limit before finding the Gauss-Newton step). With least_squares (if it is enabled), the Gauss-Newton step is computed by\na direct solve, and by LSQR only if that fails. If direction is present, it is searched along instead of the\nGauss-Newton direction (for when that can't make progress: at a point\nthat is stationary for the violation, a decrease may still be possible\nto second order, e.g. along the QP's elastic step where J=0 ). Along a\ndirection without first-order decrease, any decrease of the violation\nis accepted. Arguments Type Intent Optional Attributes Name type( sqpopt_problem_type ), intent(inout) :: problem problem definition type( sqpopt_sparse_matrix ), intent(in) :: jac constraint Jacobian at x , dimension(m,n) real(kind=wp), intent(in), dimension(:) :: x current point dimension(n) real(kind=wp), intent(in), dimension(:) :: c constraint values at x dimension(m) real(kind=wp), intent(in) :: max_step cap on real(kind=wp), intent(out), dimension(:) :: x_new new point dimension(n) real(kind=wp), intent(out) :: alpha accepted step length ( 0 if none) integer, intent(out) :: istat status code (see sqpopt_types_module ) real(kind=wp), intent(in), optional, dimension(:) :: direction search direction to use instead of Gauss-Newton dimension(n) type( sqpopt_least_squares_type ), intent(inout), optional :: least_squares the direct least-squares solver\n(see sqpopt_least_squares_module ) Calls proc~~restoration_step~~CallsGraph proc~restoration_step restoration_step all_rows all_rows proc~restoration_step->all_rows initialize initialize proc~restoration_step->initialize jp jp proc~restoration_step->jp proc~eval_c_cached sqpopt_problem_type%eval_c_cached proc~restoration_step->proc~eval_c_cached proc~least_squares_min_norm sqpopt_least_squares_type%least_squares_min_norm proc~restoration_step->proc~least_squares_min_norm proc~sqpopt_all_finite sqpopt_all_finite proc~restoration_step->proc~sqpopt_all_finite proc~step_bounds sqpopt_problem_type%step_bounds proc~restoration_step->proc~step_bounds proc~violation violation proc~restoration_step->proc~violation solve solve proc~restoration_step->solve proc~raw_fc raw_fc proc~eval_c_cached->proc~raw_fc proc~least_squares_min_norm->proc~sqpopt_all_finite proc~kkt_factor_identity sqpopt_kkt_type%kkt_factor_identity proc~least_squares_min_norm->proc~kkt_factor_identity proc~kkt_solve sqpopt_kkt_type%kkt_solve proc~least_squares_min_norm->proc~kkt_solve proc~regularization regularization proc~least_squares_min_norm->proc~regularization proc~factor_values factor_values proc~kkt_factor_identity->proc~factor_values proc~dense_lu_solve dense_lu_solve proc~kkt_solve->proc~dense_lu_solve proc~hessian_low_rank_multiply sqpopt_hessian_type%hessian_low_rank_multiply proc~kkt_solve->proc~hessian_low_rank_multiply proc~hessian_low_rank_multiply_transpose sqpopt_hessian_type%hessian_low_rank_multiply_transpose proc~kkt_solve->proc~hessian_low_rank_multiply_transpose proc~symmetric_solver_solve sqpopt_symmetric_solver_type%symmetric_solver_solve proc~kkt_solve->proc~symmetric_solver_solve proc~reset_evaluations sqpopt_problem_type%reset_evaluations proc~raw_fc->proc~reset_evaluations proc~wall_time wall_time proc~raw_fc->proc~wall_time proc~kkt_negatives kkt_negatives proc~factor_values->proc~kkt_negatives proc~symmetric_solver_factor sqpopt_symmetric_solver_type%symmetric_solver_factor proc~factor_values->proc~symmetric_solver_factor proc~pair_col pair_col proc~hessian_low_rank_multiply->proc~pair_col proc~hessian_low_rank_multiply_transpose->proc~pair_col proc~symmetric_solver_solve->proc~sqpopt_all_finite back_solve back_solve proc~symmetric_solver_solve->back_solve proc~symmetric_solver_multiply sqpopt_symmetric_solver_type%symmetric_solver_multiply proc~symmetric_solver_solve->proc~symmetric_solver_multiply refactor refactor proc~symmetric_solver_factor->refactor multiply multiply proc~symmetric_solver_multiply->multiply Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~restoration_step~~CalledByGraph proc~restoration_step restoration_step proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~restoration_step proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine restoration_step ( problem , jac , x , c , max_step , x_new , alpha , istat , direction , least_squares ) type ( sqpopt_problem_type ), intent ( inout ) :: problem !! problem definition type ( sqpopt_sparse_matrix ), intent ( in ) :: jac !! constraint Jacobian at `x`, `dimension(m,n)` real ( wp ), dimension (:), intent ( in ) :: x !! current point `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: c !! constraint values at `x` `dimension(m)` real ( wp ), intent ( in ) :: max_step !! cap on  \\lVert p \\rVert_2  real ( wp ), dimension (:), intent ( out ) :: x_new !! new point `dimension(n)` real ( wp ), intent ( out ) :: alpha !! accepted step length (`0` if none) integer , intent ( out ) :: istat !! status code (see [[sqpopt_types_module]]) real ( wp ), dimension (:), optional , intent ( in ) :: direction !! search direction to use instead of Gauss-Newton `dimension(n)` type ( sqpopt_least_squares_type ), optional , intent ( inout ) :: least_squares !! the direct least-squares solver !! (see [[sqpopt_least_squares_module]]) real ( wp ), parameter :: sigma = 1.0e-4_wp !! Armijo sufficient-decrease parameter real ( wp ), parameter :: backtrack = 0.5_wp !! step-length reduction factor integer , parameter :: max_ls = 30 !! maximum number of backtracking steps integer , parameter :: lsqr_itnlim_stop = 5 !! `LSQR`'s `istop` for \"iteration limit reached\" real ( wp ), dimension (:), allocatable :: rc , c_trial real ( wp ), dimension (:), allocatable :: p , x_trial , lb , ub real ( wp ) :: h0 , h_trial , dh0 type ( lsqr_solver_ez ) :: lsqr integer :: istop , it logical :: solved allocate ( rc ( size ( c )), c_trial ( size ( c )), p ( size ( x )), x_trial ( size ( x )), lb ( size ( x )), ub ( size ( x ))) rc = violation ( c , problem % c_lb , problem % c_ub ) h0 = 0.5_wp * dot_product ( rc , rc ) ! Gauss-Newton step: minimum-norm solution of J*p = -r_c, then made to ! respect the variable bounds and the step-length cap: if ( present ( direction )) then p = direction else solved = . false . if ( present ( least_squares )) then block logical , dimension (:), allocatable :: all_rows allocate ( all_rows ( size ( c ))) all_rows = . true . c_trial = - rc ! (the right-hand side; `c_trial` is free until the line search) call least_squares % min_norm ( jac , all_rows , c_trial , p , solved ) end block end if if (. not . solved ) then call lsqr % initialize ( problem % m , problem % n , jac % val , jac % irow , jac % icol , & itnlim = 2 * ( problem % m + problem % n ) + 10 ) c_trial = - rc ! (the right-hand side; `c_trial` is free until the line search) call lsqr % solve ( c_trial , 0.0_wp , p , istop ) if ( istop == lsqr_itnlim_stop . or . . not . sqpopt_all_finite ( p )) then ! LSQR didn't converge: no usable Gauss-Newton step alpha = 0.0_wp x_new = x istat = sqpopt_line_search_failed return end if end if end if call problem % step_bounds ( x , lb , ub ) p = min ( max ( x + p , lb ), ub ) - x if ( norm2 ( p ) > max_step ) p = p * ( max_step / norm2 ( p )) ! directional derivative of 0.5*|r_c|&#94;2 along p: r_c&#94;T J p block real ( wp ), dimension (:), allocatable :: jp integer :: k allocate ( jp ( size ( c ))) jp = 0.0_wp do k = 1 , jac % nnz jp ( jac % irow ( k )) = jp ( jac % irow ( k )) + jac % val ( k ) * p ( jac % icol ( k )) end do dh0 = dot_product ( rc , jp ) end block alpha = 1.0_wp if ( present ( direction )) dh0 = min ( dh0 , 0.0_wp ) ! (then any decrease is accepted) if ( dh0 < 0.0_wp . or . present ( direction )) then do it = 1 , max_ls x_trial = x + alpha * p call problem % c ( x_trial , c_trial ) if ( sqpopt_all_finite ( c_trial )) then rc = violation ( c_trial , problem % c_lb , problem % c_ub ) h_trial = 0.5_wp * dot_product ( rc , rc ) else h_trial = huge ( 1.0_wp ) ! a non-finite trial point is always rejected end if if ( h_trial <= h0 + sigma * alpha * dh0 . and . h_trial < h0 ) then x_new = x_trial istat = sqpopt_success return end if alpha = backtrack * alpha end do end if ! no decrease in the violation along the Gauss-Newton direction: alpha = 0.0_wp x_new = x istat = sqpopt_line_search_failed end subroutine restoration_step","tags":"","url":"proc/restoration_step.html"},{"title":"escape_step – sqpopt","text":"public  subroutine escape_step(problem, jac, x, c, tol, x_new, istat) look for a second-order decrease of the constraint violation from a point x that is stationary for it (where check_convergence would report sqpopt_infeasible ). Such a point may be a saddle of the violation rather\nthan a minimum: e.g. on a symmetry plane of the problem ( x_j=0 , with\nevery function even in x_j ), where the gradients' x_j components all\nvanish, so no first-order method, and no exactly computed step, ever\nleaves the plane. Each variable whose column of the Jacobian is negligible in the violated\nrows (up to max_probe of them) is perturbed by t*max(1,|x_j|) in each\ndirection, for t = 1e-3 , 1e-2 , 1e-1 (within its bounds). The\nfirst trial point with a lower (squared, l2) violation is returned in x_new , with istat=sqpopt_success ; if there is none, x_new=x and istat=sqpopt_line_search_failed . This costs at most 6*max_probe evaluations of the constraints. A column is negligible if its largest element (in the violated rows) is\nbelow tol , the tolerance at which check_convergence takes the\ngradient of the violation to be zero, or below sqrt(epsilon) times the\nlargest element of all the columns. The first test doesn't depend on the\nworking precision: the iterates approach such a plane without landing on\nit exactly (in real64 , round-off usually pushes them off it instead;\nin real128 it doesn't, and e.g. TP88 stops next to the plane x_2=0 with a column of 1e-8 , far above sqrt(epsilon) ). Arguments Type Intent Optional Attributes Name type( sqpopt_problem_type ), intent(inout) :: problem problem definition type( sqpopt_sparse_matrix ), intent(in) :: jac constraint Jacobian at x , dimension(m,n) real(kind=wp), intent(in), dimension(:) :: x current point dimension(n) real(kind=wp), intent(in), dimension(:) :: c constraint values at x dimension(m) real(kind=wp), intent(in) :: tol a Jacobian column is negligible below this (the convergence\ntest's ktol ) real(kind=wp), intent(out), dimension(:) :: x_new new point dimension(n) integer, intent(out) :: istat status code (see sqpopt_types_module ) Calls proc~~escape_step~~CallsGraph proc~escape_step escape_step proc~eval_c_cached sqpopt_problem_type%eval_c_cached proc~escape_step->proc~eval_c_cached proc~sqpopt_all_finite sqpopt_all_finite proc~escape_step->proc~sqpopt_all_finite proc~step_bounds sqpopt_problem_type%step_bounds proc~escape_step->proc~step_bounds proc~violation violation proc~escape_step->proc~violation proc~raw_fc raw_fc proc~eval_c_cached->proc~raw_fc proc~reset_evaluations sqpopt_problem_type%reset_evaluations proc~raw_fc->proc~reset_evaluations proc~wall_time wall_time proc~raw_fc->proc~wall_time Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~escape_step~~CalledByGraph proc~escape_step escape_step proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~escape_step proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine escape_step ( problem , jac , x , c , tol , x_new , istat ) type ( sqpopt_problem_type ), intent ( inout ) :: problem !! problem definition type ( sqpopt_sparse_matrix ), intent ( in ) :: jac !! constraint Jacobian at `x`, `dimension(m,n)` real ( wp ), dimension (:), intent ( in ) :: x !! current point `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: c !! constraint values at `x` `dimension(m)` real ( wp ), intent ( in ) :: tol !! a Jacobian column is negligible below this (the convergence !! test's `ktol`) real ( wp ), dimension (:), intent ( out ) :: x_new !! new point `dimension(n)` integer , intent ( out ) :: istat !! status code (see [[sqpopt_types_module]]) integer , parameter :: max_probe = 10 !! maximum number of variables probed real ( wp ), parameter :: steps ( 3 ) = [ 1.0e-3_wp , 1.0e-2_wp , 1.0e-1_wp ] !! relative perturbations tried real ( wp ), parameter :: col_tol = sqrt ( epsilon ( 1.0_wp )) !! a column is also negligible below this (relative) real ( wp ), dimension (:), allocatable :: rc , c_trial real ( wp ), dimension (:), allocatable :: colmax , x_trial , lb , ub real ( wp ) :: h0 , h_trial , jmax , xj integer :: j , k , i , s , n_probe allocate ( rc ( size ( c )), c_trial ( size ( c )), colmax ( size ( x )), x_trial ( size ( x )), lb ( size ( x )), ub ( size ( x ))) x_new = x istat = sqpopt_line_search_failed rc = violation ( c , problem % c_lb , problem % c_ub ) h0 = 0.5_wp * dot_product ( rc , rc ) if ( h0 <= 0.0_wp ) return ! largest Jacobian element of each variable in the violated rows: colmax = 0.0_wp do k = 1 , jac % nnz if ( rc ( jac % irow ( k )) /= 0.0_wp ) colmax ( jac % icol ( k )) = max ( colmax ( jac % icol ( k )), abs ( jac % val ( k ))) end do jmax = maxval ( colmax ) call problem % step_bounds ( x , lb , ub ) n_probe = 0 do j = 1 , size ( x ) if ( colmax ( j ) > max ( tol , col_tol * jmax )) cycle n_probe = n_probe + 1 if ( n_probe > max_probe ) exit do i = 1 , size ( steps ) do s = 1 , - 1 , - 2 xj = min ( max ( x ( j ) + s * steps ( i ) * max ( 1.0_wp , abs ( x ( j ))), lb ( j )), ub ( j )) if ( xj == x ( j )) cycle x_trial = x x_trial ( j ) = xj call problem % c ( x_trial , c_trial ) if (. not . sqpopt_all_finite ( c_trial )) cycle rc = violation ( c_trial , problem % c_lb , problem % c_ub ) h_trial = 0.5_wp * dot_product ( rc , rc ) if ( h_trial < h0 ) then x_new = x_trial istat = sqpopt_success return end if end do end do end do end subroutine escape_step","tags":"","url":"proc/escape_step.html"},{"title":"restoration_phase_enter – sqpopt","text":"private  subroutine restoration_phase_enter(me, x, theta, qp_solver) start a feasibility restoration phase at x (with violation theta ): record where it started, and set up the feasibility\nQP's solver (a copy of qp_solver ) and Hessian. Type Bound sqpopt_restoration_type Arguments Type Intent Optional Attributes Name class( sqpopt_restoration_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x the current point dimension(n) real(kind=wp), intent(in) :: theta its constraint violation type( sqpopt_qp_solver_type ), intent(in) :: qp_solver the main QP solver (copied) Calls proc~~restoration_phase_enter~~CallsGraph proc~restoration_phase_enter sqpopt_restoration_type%restoration_phase_enter proc~hessian_initialize sqpopt_hessian_type%hessian_initialize proc~restoration_phase_enter->proc~hessian_initialize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~restoration_phase_enter~~CalledByGraph proc~restoration_phase_enter sqpopt_restoration_type%restoration_phase_enter proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~restoration_phase_enter proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine restoration_phase_enter ( me , x , theta , qp_solver ) class ( sqpopt_restoration_type ), intent ( inout ) :: me real ( wp ), dimension (:), intent ( in ) :: x !! the current point `dimension(n)` real ( wp ), intent ( in ) :: theta !! its  \\ell_1  constraint violation type ( sqpopt_qp_solver_type ), intent ( in ) :: qp_solver !! the main QP solver (copied) me % active = . true . me % n_iter = 0 me % n_phases = me % n_phases + 1 me % theta_ref = theta me % x_ref = x me % qp = qp_solver call me % hess % initialize ( size ( x ), 1 , scale0 = zeta ) end subroutine restoration_phase_enter","tags":"","url":"proc/restoration_phase_enter.html"},{"title":"restoration_phase_step – sqpopt","text":"private  subroutine restoration_phase_step(me, problem, jac, x, c, x_new, alpha, istat) one iteration of the feasibility restoration phase from x : solve the\nfeasibility QP (whose elastic mode minimizes the violation of the\nlinearized constraints if they are inconsistent), then backtrack along p until the violation satisfies the Armijo\ncondition ,\nwhere is the decrease\npredicted by the linearization. If the QP predicts no decrease, or no\nstep length is accepted, x_new=x and istat=sqpopt_line_search_failed . If the QP solver couldn't allocate its\nmatrices, x_new=x and istat=sqpopt_out_of_memory (and me%qp 's out_of_memory is set, for sqpopt_iterate to stop the solve). Type Bound sqpopt_restoration_type Arguments Type Intent Optional Attributes Name class( sqpopt_restoration_type ), intent(inout) :: me type( sqpopt_problem_type ), intent(inout) :: problem problem definition type( sqpopt_sparse_matrix ), intent(in) :: jac constraint Jacobian at x , dimension(m,n) real(kind=wp), intent(in), dimension(:) :: x current point dimension(n) real(kind=wp), intent(in), dimension(:) :: c constraint values at x dimension(m) real(kind=wp), intent(out), dimension(:) :: x_new new point dimension(n) real(kind=wp), intent(out) :: alpha accepted step length ( 0 if none) integer, intent(out) :: istat status code (see sqpopt_types_module ) Calls proc~~restoration_phase_step~~CallsGraph proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~eval_c_cached sqpopt_problem_type%eval_c_cached proc~restoration_phase_step->proc~eval_c_cached proc~l1_violation l1_violation proc~restoration_phase_step->proc~l1_violation proc~solve_qp_subproblem sqpopt_qp_solver_type%solve_qp_subproblem proc~restoration_phase_step->proc~solve_qp_subproblem proc~sparse_matvec sparse_matvec proc~restoration_phase_step->proc~sparse_matvec proc~sqpopt_all_finite sqpopt_all_finite proc~restoration_phase_step->proc~sqpopt_all_finite proc~step_bounds sqpopt_problem_type%step_bounds proc~restoration_phase_step->proc~step_bounds proc~raw_fc raw_fc proc~eval_c_cached->proc~raw_fc proc~solve_qp_subproblem->proc~sparse_matvec proc~solve_qp_subproblem->proc~sqpopt_all_finite proc~direct_qp_step direct_qp_step proc~solve_qp_subproblem->proc~direct_qp_step proc~hessian_inverse_vector_product sqpopt_hessian_type%hessian_inverse_vector_product proc~solve_qp_subproblem->proc~hessian_inverse_vector_product proc~resolved_mode resolved_mode proc~solve_qp_subproblem->proc~resolved_mode proc~solve_dense_qp sqpopt_dense_qp_type%solve_dense_qp proc~solve_qp_subproblem->proc~solve_dense_qp proc~starting_working_set sqpopt_qp_solv