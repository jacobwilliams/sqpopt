oc~hessian_low_rank_column sqpopt_hessian_type%hessian_low_rank_column proc~low_rank_update->proc~hessian_low_rank_column proc~hessian_low_rank_middle sqpopt_hessian_type%hessian_low_rank_middle proc~low_rank_update->proc~hessian_low_rank_middle proc~hessian_low_rank_size sqpopt_hessian_type%hessian_low_rank_size proc~low_rank_update->proc~hessian_low_rank_size proc~low_rank_update->proc~kkt_negatives proc~symmetric_solver_solve->proc~sqpopt_all_finite back_solve back_solve proc~symmetric_solver_solve->back_solve proc~symmetric_solver_multiply sqpopt_symmetric_solver_type%symmetric_solver_multiply proc~symmetric_solver_solve->proc~symmetric_solver_multiply proc~hessian_low_rank_column->proc~pair_col proc~hessian_low_rank_middle->proc~middle_matrix proc~hessian_low_rank_size->proc~factor_middle_matrix proc~middle_matrix->proc~pair_col refactor refactor proc~symmetric_solver_factor->refactor multiply multiply proc~symmetric_solver_multiply->multiply Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~restoration_phase_step~~CalledByGraph proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~restoration_phase_step proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine restoration_phase_step ( me , problem , jac , x , c , x_new , alpha , istat ) class ( sqpopt_restoration_type ), intent ( inout ) :: me type ( sqpopt_problem_type ), intent ( inout ) :: problem !! problem definition type ( sqpopt_sparse_matrix ), intent ( in ) :: jac !! constraint Jacobian at `x`, `dimension(m,n)` real ( wp ), dimension (:), intent ( in ) :: x !! current point `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: c !! constraint values at `x` `dimension(m)` real ( wp ), dimension (:), intent ( out ) :: x_new !! new point `dimension(n)` real ( wp ), intent ( out ) :: alpha !! accepted step length (`0` if none) integer , intent ( out ) :: istat !! status code (see [[sqpopt_types_module]]) real ( wp ), parameter :: eta = 1.0e-4_wp !! Armijo constant real ( wp ), parameter :: alpha_min = 1.0e-8_wp !! smallest step length tried real ( wp ), dimension (:), allocatable :: g_r , p , x_trial , lb , ub real ( wp ), dimension (:), allocatable :: lambda_r , jp , c_trial real ( wp ) :: theta0 , theta_t , pred integer :: qp_istat allocate ( g_r ( size ( x )), p ( size ( x )), x_trial ( size ( x )), lb ( size ( x )), ub ( size ( x ))) allocate ( lambda_r ( size ( c )), jp ( size ( c )), c_trial ( size ( c ))) me % n_iter = me % n_iter + 1 x_new = x alpha = 0.0_wp istat = sqpopt_line_search_failed theta0 = l1_violation ( c , problem % c_lb , problem % c_ub ) g_r = zeta * ( x - me % x_ref ) call problem % step_bounds ( x , lb , ub ) call me % qp % solve ( me % hess , jac , x , g_r , c , lb , ub , problem % c_lb , problem % c_ub , & p , lambda_r , qp_istat ) if ( qp_istat == sqpopt_out_of_memory ) then istat = sqpopt_out_of_memory return end if if ( qp_istat /= sqpopt_success . and . qp_istat /= sqpopt_infeasible . and . qp_istat /= sqpopt_qp_solve_failed ) return ! the decrease in the violation predicted by the linearization: call sparse_matvec ( jac , p , jp ) c_trial = c + jp ! (the linearized constraints; `c_trial` is free until the line search) pred = theta0 - l1_violation ( c_trial , problem % c_lb , problem % c_ub ) if (. not . ( pred > 1.0e-12_wp * max ( 1.0_wp , theta0 ))) return alpha = 1.0_wp do x_trial = x + alpha * p call problem % c ( x_trial , c_trial ) if ( sqpopt_all_finite ( c_trial )) then theta_t = l1_violation ( c_trial , problem % c_lb , problem % c_ub ) if ( theta_t <= theta0 - eta * alpha * pred ) then x_new = x_trial istat = sqpopt_success return end if end if alpha = 0.5_wp * alpha if ( alpha < alpha_min ) exit end do alpha = 0.0_wp end subroutine restoration_phase_step","tags":"","url":"proc/restoration_phase_step.html"},{"title":"wall_time – sqpopt","text":"private  function wall_time() result(t) Uses iso_fortran_env proc~~wall_time~~UsesGraph proc~wall_time wall_time iso_fortran_env iso_fortran_env proc~wall_time->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. the wall-clock time, in seconds (for the time spent in the user's functions). Arguments None Return Value real(kind=wp) Called by proc~~wall_time~~CalledByGraph proc~wall_time wall_time proc~eval_hess_scaled sqpopt_problem_type%eval_hess_scaled proc~eval_hess_scaled->proc~wall_time proc~raw_fc raw_fc proc~raw_fc->proc~wall_time proc~raw_gjac raw_gjac proc~raw_gjac->proc~wall_time proc~compute_scaling sqpopt_problem_type%compute_scaling proc~compute_scaling->proc~raw_gjac proc~eval_c_cached sqpopt_problem_type%eval_c_cached proc~eval_c_cached->proc~raw_fc proc~eval_f_cached sqpopt_problem_type%eval_f_cached proc~eval_f_cached->proc~raw_fc proc~eval_g_cached sqpopt_problem_type%eval_g_cached proc~eval_g_cached->proc~raw_gjac proc~eval_jac_cached sqpopt_problem_type%eval_jac_cached proc~eval_jac_cached->proc~raw_gjac proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~eval_hess_scaled proc~sqpopt_iterate->proc~eval_c_cached proc~sqpopt_iterate->proc~eval_f_cached proc~sqpopt_iterate->proc~eval_jac_cached proc~escape_step escape_step proc~sqpopt_iterate->proc~escape_step proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~sqpopt_iterate->proc~restoration_phase_step proc~restoration_step restoration_step proc~sqpopt_iterate->proc~restoration_step proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~sqpopt_iterate->proc~trust_region_step proc~diagnostics_start sqpopt_diagnostics_type%diagnostics_start proc~diagnostics_start->proc~eval_c_cached proc~diagnostics_start->proc~eval_f_cached proc~diagnostics_start->proc~eval_jac_cached proc~escape_step->proc~eval_c_cached proc~restoration_phase_step->proc~eval_c_cached proc~restoration_step->proc~eval_c_cached proc~sqpopt_evaluate_point sqpopt_evaluate_point proc~sqpopt_evaluate_point->proc~eval_c_cached proc~sqpopt_evaluate_point->proc~eval_f_cached proc~sqpopt_evaluate_point->proc~eval_jac_cached proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~compute_scaling proc~sqpopt_solve->proc~sqpopt_iterate proc~sqpopt_solve->proc~diagnostics_start proc~sqpopt_solve->proc~sqpopt_evaluate_point proc~trust_region_step->proc~eval_c_cached proc~trust_region_step->proc~eval_f_cached proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function wall_time () result ( t ) use , intrinsic :: iso_fortran_env , only : int64 real ( wp ) :: t integer ( int64 ) :: count , rate call system_clock ( count , rate ) t = real ( count , wp ) / real ( rate , wp ) end function wall_time","tags":"","url":"proc/wall_time.html"},{"title":"set_problem_size – sqpopt","text":"private  subroutine set_problem_size(me, n, m) set the problem dimensions and allocate the variable/constraint bound\narrays: n variables and m constraints. Which constraints are\nequalities is given by their bounds ( c_lb(i) == c_ub(i) , see set_bounds ), so equalities and inequalities may come in any order. Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(in) :: n number of optimization variables integer, intent(in) :: m number of constraints (equality and inequality) Called by proc~~set_problem_size~~CalledByGraph proc~set_problem_size sqpopt_problem_type%set_problem_size proc~nlls_initialize sqpopt_nlls_type%nlls_initialize proc~nlls_initialize->proc~set_problem_size Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_problem_size ( me , n , m ) class ( sqpopt_problem_type ), intent ( inout ) :: me integer , intent ( in ) :: n !! number of optimization variables integer , intent ( in ) :: m !! number of constraints (equality and inequality) me % n = n me % m = m if ( allocated ( me % x_lb )) deallocate ( me % x_lb ) if ( allocated ( me % x_ub )) deallocate ( me % x_ub ) if ( allocated ( me % c_lb )) deallocate ( me % c_lb ) if ( allocated ( me % c_ub )) deallocate ( me % c_ub ) if ( allocated ( me % x_max_step )) deallocate ( me % x_max_step ) allocate ( me % x_lb ( n ), me % x_ub ( n )) allocate ( me % c_lb ( me % m ), me % c_ub ( me % m )) end subroutine set_problem_size","tags":"","url":"proc/set_problem_size.html"},{"title":"set_bounds – sqpopt","text":"private  subroutine set_bounds(me, x_lb, x_ub, c_lb, c_ub) set the variable bounds and the constraint\nbounds (equality constraints are given by c_lb(i) == c_ub(i) ). set_problem_size must be called first. Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x_lb variable lower bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: x_ub variable upper bounds dimension(n) real(kind=wp), intent(in), dimension(:) :: c_lb constraint lower bounds dimension(m) real(kind=wp), intent(in), dimension(:) :: c_ub constraint upper bounds dimension(m) Called by proc~~set_bounds~~CalledByGraph proc~set_bounds sqpopt_problem_type%set_bounds proc~nlls_initialize sqpopt_nlls_type%nlls_initialize proc~nlls_initialize->proc~set_bounds Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_bounds ( me , x_lb , x_ub , c_lb , c_ub ) class ( sqpopt_problem_type ), intent ( inout ) :: me real ( wp ), dimension (:), intent ( in ) :: x_lb !! variable lower bounds `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: x_ub !! variable upper bounds `dimension(n)` real ( wp ), dimension (:), intent ( in ) :: c_lb !! constraint lower bounds `dimension(m)` real ( wp ), dimension (:), intent ( in ) :: c_ub !! constraint upper bounds `dimension(m)` me % x_lb = x_lb me % x_ub = x_ub me % c_lb = c_lb me % c_ub = c_ub end subroutine set_bounds","tags":"","url":"proc/set_bounds.html"},{"title":"set_max_step – sqpopt","text":"private  subroutine set_max_step(me, max_step) set the largest change of each variable in one major iteration: max_step(j) . The limits are enforced as\nbounds on every step the solver computes (the QP subproblem's, the\nsecond-order correction, and the restoration steps), so a step is the\nbest one within them, not a longer one cut short. A value >= sqpopt_infinity means no limit for that variable. Without this call\n(or after another set_problem_size ) there are no limits. Use it for variables with different units or sensitivities, when you\nknow how far each can move before the problem's linearization stops\nbeing useful (the solver's own cap on the length of the step, qp_solver%max_step , treats all variables alike). Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: max_step the largest change of each variable dimension(n) (each > 0 ) Source Code subroutine set_max_step ( me , max_step ) class ( sqpopt_problem_type ), intent ( inout ) :: me real ( wp ), dimension (:), intent ( in ) :: max_step !! the largest change of each variable `dimension(n)` (each !! `> 0`) me % x_max_step = max_step end subroutine set_max_step","tags":"","url":"proc/set_max_step.html"},{"title":"step_bounds – sqpopt","text":"private pure subroutine step_bounds(me, x, lb, ub) the bounds on the variables for a step from the point x : the\nvariables' bounds, tightened to x - max_step and x + max_step if\nstep limits were set (see set_max_step ). x must be within the\nbounds, so that lb <= x <= ub . Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(in) :: me real(kind=wp), intent(in), dimension(:) :: x the point the step starts from dimension(n) real(kind=wp), intent(out), dimension(:) :: lb lower bounds for the new point dimension(n) real(kind=wp), intent(out), dimension(:) :: ub upper bounds for the new point dimension(n) Called by proc~~step_bounds~~CalledByGraph proc~step_bounds sqpopt_problem_type%step_bounds proc~escape_step escape_step proc~escape_step->proc~step_bounds proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~restoration_phase_step->proc~step_bounds proc~restoration_step restoration_step proc~restoration_step->proc~step_bounds proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_iterate->proc~step_bounds proc~sqpopt_iterate->proc~escape_step proc~sqpopt_iterate->proc~restoration_phase_step proc~sqpopt_iterate->proc~restoration_step proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~sqpopt_iterate->proc~trust_region_step proc~trust_region_step->proc~step_bounds proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~sqpopt_iterate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine step_bounds ( me , x , lb , ub ) class ( sqpopt_problem_type ), intent ( in ) :: me real ( wp ), dimension (:), intent ( in ) :: x !! the point the step starts from `dimension(n)` real ( wp ), dimension (:), intent ( out ) :: lb !! lower bounds for the new point `dimension(n)` real ( wp ), dimension (:), intent ( out ) :: ub !! upper bounds for the new point `dimension(n)` lb = me % x_lb ub = me % x_ub if ( allocated ( me % x_max_step )) then lb = max ( lb , x - me % x_max_step ) ub = min ( ub , x + me % x_max_step ) end if end subroutine step_bounds","tags":"","url":"proc/step_bounds.html"},{"title":"validate – sqpopt","text":"private  subroutine validate(me, istat, msg) check that the problem is completely and consistently defined, and\nnormalize the bounds: any bound with magnitude >= sqpopt_infinity is\nclamped to +/-sqpopt_infinity , so that e.g. -huge(1.0_wp) may be\nused for an absent bound without overflowing expressions like x_ub-x_lb . Returns istat=sqpopt_invalid_input (and a description in msg ) on the first problem found, else sqpopt_success . Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(out) :: istat sqpopt_success or sqpopt_invalid_input character(len=:), intent(out), allocatable :: msg description of the problem found (empty if none) Calls proc~~validate~~CallsGraph proc~validate sqpopt_problem_type%validate proc~sqpopt_all_finite sqpopt_all_finite proc~validate->proc~sqpopt_all_finite Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~validate~~CalledByGraph proc~validate sqpopt_problem_type%validate proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~validate proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine validate ( me , istat , msg ) class ( sqpopt_problem_type ), intent ( inout ) :: me integer , intent ( out ) :: istat !! `sqpopt_success` or `sqpopt_invalid_input` character ( len = :), allocatable , intent ( out ) :: msg !! description of the problem found (empty if none) istat = sqpopt_invalid_input msg = '' if ( me % n <= 0 ) then msg = 'the number of variables n must be > 0 (call set_problem_size)' ; return end if if ( me % m < 0 ) then msg = 'the number of constraints must be >= 0' ; return end if if (. not . ( allocated ( me % x_lb ) . and . allocated ( me % x_ub ) . and . allocated ( me % c_lb ) . and . allocated ( me % c_ub ))) then msg = 'the bounds have not been set (call set_bounds)' ; return end if if ( size ( me % x_lb ) /= me % n . or . size ( me % x_ub ) /= me % n ) then msg = 'the variable bounds x_lb/x_ub must have size n' ; return end if if ( size ( me % c_lb ) /= me % m . or . size ( me % c_ub ) /= me % m ) then msg = 'the constraint bounds c_lb/c_ub must have size m' ; return end if me % x_lb = max ( me % x_lb , - sqpopt_infinity ) me % x_ub = min ( me % x_ub , sqpopt_infinity ) me % c_lb = max ( me % c_lb , - sqpopt_infinity ) me % c_ub = min ( me % c_ub , sqpopt_infinity ) if (. not . ( sqpopt_all_finite ( me % x_lb ) . and . sqpopt_all_finite ( me % x_ub ) . and . & sqpopt_all_finite ( me % c_lb ) . and . sqpopt_all_finite ( me % c_ub ))) then msg = 'a bound is NaN' ; return end if if ( any ( me % x_lb > me % x_ub )) then msg = 'a variable lower bound exceeds its upper bound' ; return end if if ( any ( me % c_lb > me % c_ub )) then msg = 'a constraint lower bound exceeds its upper bound' ; return end if if ( allocated ( me % x_max_step )) then if ( size ( me % x_max_step ) /= me % n ) then msg = 'the step limits (set_max_step) must have size n' ; return end if me % x_max_step = min ( me % x_max_step , sqpopt_infinity ) if (. not . all ( me % x_max_step > 0.0_wp )) then msg = 'a step limit (set_max_step) is not > 0' ; return end if end if if ( any ( me % x_lb >= sqpopt_infinity ) . or . any ( me % x_ub <= - sqpopt_infinity ) . or . & any ( me % c_lb >= sqpopt_infinity ) . or . any ( me % c_ub <= - sqpopt_infinity )) then msg = 'a lower bound is +infinity or an upper bound is -infinity' ; return end if if ( me % m > 0 ) then if (. not . ( allocated ( me % jac_irow ) . and . allocated ( me % jac_icol ))) then msg = 'the Jacobian sparsity pattern has not been set (call set_jacobian_sparsity)' ; return end if end if if ( me % jac_nnz < 0 ) then msg = 'the number of Jacobian nonzeros must be >= 0' ; return end if if ( me % jac_nnz > 0 ) then if (. not . ( allocated ( me % jac_irow ) . and . allocated ( me % jac_icol ))) then msg = 'the Jacobian sparsity pattern has not been set (call set_jacobian_sparsity)' ; return end if if ( size ( me % jac_irow ) /= me % jac_nnz . or . size ( me % jac_icol ) /= me % jac_nnz ) then msg = 'the Jacobian sparsity pattern arrays must have size jac_nnz' ; return end if if ( any ( me % jac_irow < 1 ) . or . any ( me % jac_irow > me % m )) then msg = 'a Jacobian row index is outside 1..m' ; return end if if ( any ( me % jac_icol < 1 ) . or . any ( me % jac_icol > me % n )) then msg = 'a Jacobian column index is outside 1..n' ; return end if else ! make sure the (possibly empty) pattern arrays exist, so they can be copied safely: if (. not . allocated ( me % jac_irow )) allocate ( me % jac_irow ( 0 )) if (. not . allocated ( me % jac_icol )) allocate ( me % jac_icol ( 0 )) end if if ( me % hess_nnz < 0 ) then msg = 'the number of Hessian nonzeros must be >= 0' ; return end if if ( me % hess_nnz > 0 ) then if (. not . ( allocated ( me % hess_irow ) . and . allocated ( me % hess_icol ))) then msg = 'the Hessian sparsity pattern has not been set (call set_hessian_sparsity)' ; return end if if ( size ( me % hess_irow ) /= me % hess_nnz . or . size ( me % hess_icol ) /= me % hess_nnz ) then msg = 'the Hessian sparsity pattern arrays must have size hess_nnz' ; return end if if ( any ( me % hess_irow < 1 ) . or . any ( me % hess_irow > me % n ) . or . & any ( me % hess_icol < 1 ) . or . any ( me % hess_icol > me % n )) then msg = 'a Hessian row or column index is outside 1..n' ; return end if else if (. not . allocated ( me % hess_irow )) allocate ( me % hess_irow ( 0 )) if (. not . allocated ( me % hess_icol )) allocate ( me % hess_icol ( 0 )) end if if (. not . ( associated ( me % eval_fc ) . and . associated ( me % eval_gjac ))) then msg = 'the problem functions have not been set (call set_functions)' ; return end if istat = sqpopt_success end subroutine validate","tags":"","url":"proc/validate.html"},{"title":"set_jacobian_sparsity – sqpopt","text":"private  subroutine set_jacobian_sparsity(me, nnz, irow, icol) set the (fixed) sparsity pattern of the constraint Jacobian, given as\n1-based COO irow / icol triplets. Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(in) :: nnz number of nonzero Jacobian elements integer, intent(in), dimension(:) :: irow row indices dimension(nnz) integer, intent(in), dimension(:) :: icol column indices dimension(nnz) Called by proc~~set_jacobian_sparsity~~CalledByGraph proc~set_jacobian_sparsity sqpopt_problem_type%set_jacobian_sparsity proc~nlls_initialize sqpopt_nlls_type%nlls_initialize proc~nlls_initialize->proc~set_jacobian_sparsity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_jacobian_sparsity ( me , nnz , irow , icol ) class ( sqpopt_problem_type ), intent ( inout ) :: me integer , intent ( in ) :: nnz !! number of nonzero Jacobian elements integer , dimension (:), intent ( in ) :: irow !! row indices `dimension(nnz)` integer , dimension (:), intent ( in ) :: icol !! column indices `dimension(nnz)` me % jac_nnz = nnz me % jac_irow = irow ( 1 : nnz ) me % jac_icol = icol ( 1 : nnz ) end subroutine set_jacobian_sparsity","tags":"","url":"proc/set_jacobian_sparsity.html"},{"title":"set_hessian_sparsity – sqpopt","text":"private  subroutine set_hessian_sparsity(me, nnz, irow, icol) set the (fixed) sparsity pattern of the Hessian of the Lagrangian,\ngiven as 1-based COO irow / icol triplets. Since the Hessian is\nsymmetric, each off-diagonal element must be given only once (in\neither triangle; e.g. only the lower triangle): an element (i,j) with i/=j stands for both (i,j) and (j,i) . Repeated entries are summed. Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me integer, intent(in) :: nnz number of nonzero Hessian elements integer, intent(in), dimension(:) :: irow row indices dimension(nnz) integer, intent(in), dimension(:) :: icol column indices dimension(nnz) Called by proc~~set_hessian_sparsity~~CalledByGraph proc~set_hessian_sparsity sqpopt_problem_type%set_hessian_sparsity proc~nlls_initialize sqpopt_nlls_type%nlls_initialize proc~nlls_initialize->proc~set_hessian_sparsity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_hessian_sparsity ( me , nnz , irow , icol ) class ( sqpopt_problem_type ), intent ( inout ) :: me integer , intent ( in ) :: nnz !! number of nonzero Hessian elements integer , dimension (:), intent ( in ) :: irow !! row indices `dimension(nnz)` integer , dimension (:), intent ( in ) :: icol !! column indices `dimension(nnz)` me % hess_nnz = nnz me % hess_irow = irow ( 1 : nnz ) me % hess_icol = icol ( 1 : nnz ) end subroutine set_hessian_sparsity","tags":"","url":"proc/set_hessian_sparsity.html"},{"title":"set_functions – sqpopt","text":"private  subroutine set_functions(me, fc, gjac, hess, data) attach the user-supplied procedures used to evaluate the objective\nfunction and constraints ( fc ), their derivatives ( gjac ), and\noptionally the exact Hessian of the Lagrangian ( hess ), and\n(optionally) a user data object that is passed to each of them (see the\nmodule-level documentation). fc returns and together,\nand gjac returns and the Jacobian values together,\nsince they usually share intermediate results. data is pointed to , not copied, so the functions see (and may\nupdate) the caller's object: it must have the target (or pointer )\nattribute and exist for as long as the problem is being solved. Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me procedure( sqpopt_fc_func ) :: fc objective function and constraint vector procedure( sqpopt_gjac_func ) :: gjac objective gradient and sparse constraint Jacobian values procedure( sqpopt_hessian_func ), optional :: hess sparse exact Hessian of the Lagrangian values class(*), intent(inout), optional, target :: data user data passed to each function Called by proc~~set_functions~~CalledByGraph proc~set_functions sqpopt_problem_type%set_functions proc~nlls_initialize sqpopt_nlls_type%nlls_initialize proc~nlls_initialize->proc~set_functions Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_functions ( me , fc , gjac , hess , data ) class ( sqpopt_problem_type ), intent ( inout ) :: me procedure ( sqpopt_fc_func ) :: fc !! objective function and constraint vector procedure ( sqpopt_gjac_func ) :: gjac !! objective gradient and sparse constraint Jacobian values procedure ( sqpopt_hessian_func ), optional :: hess !! sparse exact Hessian of the Lagrangian values class ( * ), target , optional , intent ( inout ) :: data !! user data passed to each function me % eval_fc => fc me % eval_gjac => gjac me % eval_hess => null () me % user_data => null () if ( present ( hess )) me % eval_hess => hess if ( present ( data )) me % user_data => data end subroutine set_functions","tags":"","url":"proc/set_functions.html"},{"title":"reset_evaluations – sqpopt","text":"private  subroutine reset_evaluations(me) empty the evaluation caches (sizing them for the current n , m , and\nJacobian pattern), zero the evaluation counters, clear any stop\nrequest, and reset the scale factors to 1. Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me Called by proc~~reset_evaluations~~CalledByGraph proc~reset_evaluations sqpopt_problem_type%reset_evaluations proc~raw_fc raw_fc proc~raw_fc->proc~reset_evaluations proc~raw_gjac raw_gjac proc~raw_gjac->proc~reset_evaluations proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~reset_evaluations proc~compute_scaling sqpopt_problem_type%compute_scaling proc~sqpopt_solve->proc~compute_scaling proc~diagnostics_start sqpopt_diagnostics_type%diagnostics_start proc~sqpopt_solve->proc~diagnostics_start proc~sqpopt_evaluate_point sqpopt_evaluate_point proc~sqpopt_solve->proc~sqpopt_evaluate_point proc~sqpopt_iterate sqpopt_iterate proc~sqpopt_solve->proc~sqpopt_iterate proc~compute_scaling->proc~raw_gjac proc~eval_c_cached sqpopt_problem_type%eval_c_cached proc~eval_c_cached->proc~raw_fc proc~eval_f_cached sqpopt_problem_type%eval_f_cached proc~eval_f_cached->proc~raw_fc proc~eval_g_cached sqpopt_problem_type%eval_g_cached proc~eval_g_cached->proc~raw_gjac proc~eval_jac_cached sqpopt_problem_type%eval_jac_cached proc~eval_jac_cached->proc~raw_gjac proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve proc~diagnostics_start->proc~eval_c_cached proc~diagnostics_start->proc~eval_f_cached proc~diagnostics_start->proc~eval_jac_cached proc~escape_step escape_step proc~escape_step->proc~eval_c_cached proc~restoration_phase_step sqpopt_restoration_type%restoration_phase_step proc~restoration_phase_step->proc~eval_c_cached proc~restoration_step restoration_step proc~restoration_step->proc~eval_c_cached proc~sqpopt_evaluate_point->proc~eval_c_cached proc~sqpopt_evaluate_point->proc~eval_f_cached proc~sqpopt_evaluate_point->proc~eval_jac_cached proc~sqpopt_iterate->proc~eval_c_cached proc~sqpopt_iterate->proc~eval_f_cached proc~sqpopt_iterate->proc~eval_jac_cached proc~sqpopt_iterate->proc~escape_step proc~sqpopt_iterate->proc~restoration_phase_step proc~sqpopt_iterate->proc~restoration_step proc~trust_region_step sqpopt_trust_region_type%trust_region_step proc~sqpopt_iterate->proc~trust_region_step proc~trust_region_step->proc~eval_c_cached proc~trust_region_step->proc~eval_f_cached Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine reset_evaluations ( me ) class ( sqpopt_problem_type ), intent ( inout ) :: me if ( allocated ( me % cache_x )) deallocate ( me % cache_x ) if ( allocated ( me % cache_f )) deallocate ( me % cache_f ) if ( allocated ( me % cache_c )) deallocate ( me % cache_c ) if ( allocated ( me % cache_xg )) deallocate ( me % cache_xg ) if ( allocated ( me % cache_g )) deallocate ( me % cache_g ) if ( allocated ( me % cache_jac )) deallocate ( me % cache_jac ) if ( allocated ( me % c_scale )) deallocate ( me % c_scale ) allocate ( me % cache_x ( me % n , cache_size ), me % cache_f ( cache_size ), me % cache_c ( me % m , cache_size )) allocate ( me % cache_xg ( me % n ), me % cache_g ( me % n ), me % cache_jac ( max ( me % jac_nnz , 0 ))) allocate ( me % c_scale ( me % m )) me % cache_n = 0 ; me % cache_next = 1 me % have_gjac = . false . me % n_eval_fc = 0 ; me % n_eval_gjac = 0 ; me % n_eval_hess = 0 me % time_user = 0.0_wp me % stop_requested = . false . me % f_scale = 1.0_wp me % c_scale = 1.0_wp end subroutine reset_evaluations","tags":"","url":"proc/reset_evaluations.html"},{"title":"compute_scaling – sqpopt","text":"private  subroutine compute_scaling(me, x, max_gradient, min_value) gradient-based scaling (as in IPOPT): at the point x , the objective\nis scaled by and each constraint by , so that no scaled gradient is larger than max_gradient (problems whose gradients are all at most max_gradient are not\nscaled). No scale factor is made smaller than min_value (if given), so\nthat a starting point with an extremely large gradient, which says\nlittle about the rest of the problem, doesn't scale a function down to\nnothing. The (finite) constraint bounds are scaled to match. Call reset_evaluations first; the evaluations used here are cached, so\nthey are not repeated by the first major iteration. Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point at which to measure the gradients dimension(n) real(kind=wp), intent(in) :: max_gradient real(kind=wp), intent(in), optional :: min_value smallest scale factor (default 0 : no limit) Calls proc~~compute_scaling~~CallsGraph proc~compute_scaling sqpopt_problem_type%compute_scaling proc~raw_gjac raw_gjac proc~compute_scaling->proc~raw_gjac proc~sqpopt_all_finite sqpopt_all_finite proc~compute_scaling->proc~sqpopt_all_finite proc~reset_evaluations sqpopt_problem_type%reset_evaluations proc~raw_gjac->proc~reset_evaluations proc~wall_time wall_time proc~raw_gjac->proc~wall_time Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~compute_scaling~~CalledByGraph proc~compute_scaling sqpopt_problem_type%compute_scaling proc~sqpopt_solve sqpopt_type%sqpopt_solve proc~sqpopt_solve->proc~compute_scaling proc~nlls_solve sqpopt_nlls_type%nlls_solve proc~nlls_solve->proc~sqpopt_solve Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_scaling ( me , x , max_gradient , min_value ) class ( sqpopt_problem_type ), intent ( inout ) :: me real ( wp ), dimension (:), intent ( in ) :: x !! point at which to measure the gradients `dimension(n)` real ( wp ), intent ( in ) :: max_gradient !!  g_{max}  real ( wp ), optional , intent ( in ) :: min_value !! smallest scale factor (default `0`: no limit) real ( wp ), dimension (:), allocatable :: g real ( wp ), dimension (:), allocatable :: jval real ( wp ), dimension (:), allocatable :: row_max real ( wp ) :: smin integer :: k allocate ( g ( me % n ), jval ( max ( me % jac_nnz , 0 )), row_max ( me % m )) smin = 0.0_wp if ( present ( min_value )) smin = min ( max ( min_value , 0.0_wp ), 1.0_wp ) call raw_gjac ( me , x , g , jval ) if ( sqpopt_all_finite ( g ) . and . me % n > 0 ) then if ( maxval ( abs ( g )) > max_gradient ) me % f_scale = max ( max_gradient / maxval ( abs ( g )), smin ) end if if ( me % m > 0 ) then if ( sqpopt_all_finite ( jval )) then row_max = 0.0_wp do k = 1 , me % jac_nnz row_max ( me % jac_irow ( k )) = max ( row_max ( me % jac_irow ( k )), abs ( jval ( k ))) end do where ( row_max > max_gradient ) me % c_scale = max ( max_gradient / row_max , smin ) end if where ( abs ( me % c_lb ) < sqpopt_infinity ) me % c_lb = me % c_scale * me % c_lb where ( abs ( me % c_ub ) < sqpopt_infinity ) me % c_ub = me % c_scale * me % c_ub end if end subroutine compute_scaling","tags":"","url":"proc/compute_scaling.html"},{"title":"eval_f_cached – sqpopt","text":"private  subroutine eval_f_cached(me, x, f) the (scaled) objective . The underlying value is reused\nfrom one of the last few evaluations if x is exactly (bitwise) the\nsame point -- the solver evaluates f at each trial point of a line\nsearch and then again at the start of the next major iteration, at the\naccepted point, so this saves one call per major iteration. NaN if the\nuser function failed ( status /= 0 ). Type Bound sqpopt_problem_type Arguments Type Intent Optional Attributes Name class( sqpopt_problem_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x point dimension(n) real(kind=wp), intent