{
  "source_dirs": ["src", "test", "example", "build/dependencies/**"],
  "excl_paths": [".pixi/**", "build/gfortran_*", "build/linter", "doc/**", "coverage/**", "web/**"],
  "incl_suffixes": [".f90", ".F90"],
  "pp_suffixes": [".F90"],
  "hover_signature": true,
  "use_signature_help": true,
  "lowercase_intrinsics": true
}
